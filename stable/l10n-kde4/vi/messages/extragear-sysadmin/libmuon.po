msgid "Please insert %1 into <filename>%2</filename>"
msgstr "Hãy cho %1 vào <filename>%2</filename>"

#: libmuon/MuonMainWindow.cpp:385
msgctxt "@title:window"
msgid "Warning - Unverified Software"
msgstr "Cảnh báo - Phần mềm chưa được kiểm tra"

#: libmuon/MuonMainWindow.cpp:387
msgctxt "@label"
msgid ""
"The following piece of software cannot be verified. <warning>Installing "
"unverified software represents a security risk, as the presence of "
"unverifiable software can be a sign of tampering.</warning> Do you wish to "
"continue?"
msgid_plural ""
"The following pieces of software cannot be authenticated. "
"<warning>Installing unverified software represents a security risk, as the "
"presence of unverifiable software can be a sign of tampering.</warning> Do "
"you wish to continue?"
msgstr[0] ""
"Các phần mềm sau không thể được xác thực. <warning>Cài đặt các phần mềm chưa "
"kiểm tra sẽ tạo ra nguy cơ bảo mật do sự xuất hiện của các phần mềm không "
"thể kiểm tra được có thể là dấu hiệu của sự xâm nhập. </warning>Bạn có muốn "
"tiếp tục không?"

#: libmuon/MuonMainWindow.cpp:423
