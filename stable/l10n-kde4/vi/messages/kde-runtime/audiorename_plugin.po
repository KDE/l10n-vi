#: audio_plugin.cpp:74
#, kde-format
msgid "An older file named '%1' already exists.\n"
msgstr "Đã có một tập tin cũ hơn tên '%1'.\n"

#: audio_plugin.cpp:76
#, kde-format
msgid "A similar file named '%1' already exists.\n"
msgstr "Một tập tin tương tự tên '%1' đã tồn tại.\n"

#: audio_plugin.cpp:78
#, kde-format
msgid "A newer file named '%1' already exists.\n"
msgstr "Một tập tin mới hơn tên '%1' đã tồn tại.\n"

#: audio_plugin.cpp:80
msgid "Source File"
msgstr "Tập tin nguồn"

#: audio_plugin.cpp:81
msgid "Existing File"
msgstr "Tập tin tồn tại"

#: audio_plugin.cpp:82
msgid "Would you like to replace the existing file with the one on the right?"
msgstr ""
"Bạn có muốn thay thế tập tin đang tồn tại với tập tin ở bên phải không?"

#: audiopreview.cpp:51
msgid ""
"This audio file is not stored\n"
"on the local host.\n"
"Click on this label to load it.\n"
msgstr ""
"Tập tin âm thanh này không\n"
"được cất giữ trên máy cục bộ.\n"
"Nhấn vào nhãn này để tải nó.\n"

#: audiopreview.cpp:57
msgid "Unable to load audio file"
msgstr "Không thể tải tập tin âm thanh"

#: audiopreview.cpp:88
#, kde-format
msgid "Artist: %1"
msgstr "Nghệ sĩ: %1"

#: audiopreview.cpp:91
#, kde-format
msgid "Title: %1"
msgstr "Tiêu đề: %1"

#: audiopreview.cpp:94
#, kde-format
msgid "Comment: %1"
msgstr "Chú thích: %1"

#: audiopreview.cpp:96
#, kde-format
msgctxt "Bitrate: 160 kbits/s"
msgid "Bitrate: %1 %2\n"
msgstr "Tốc độ bit: %1 %2\n"

#: audiopreview.cpp:98
#, kde-format
msgid "Sample rate: %1 %2\n"
msgstr "Tốc độ mẫu : %1 %2\n"

#: audiopreview.cpp:99
msgid "Length: "
msgstr "Độ dài:  "
