#: fileprops.cpp:230
#, kde-format
msgid "kfile"
msgstr "kfile"

#: fileprops.cpp:231
#, kde-format
msgid "A command-line tool to read and modify metadata of files."
msgstr ""
"Một công cụ dòng lệnh để đọc và thay đổi dữ liệu lý lịch của các tập tin."

#: fileprops.cpp:232
#, kde-format
msgid "(c) 2002, Carsten Pfeiffer"
msgstr "(c) 2002, Carsten Pfeiffer"

#: fileprops.cpp:236
#, kde-format
msgid "Carsten Pfeiffer"
msgstr "Carsten Pfeiffer"

#: fileprops.cpp:245
#, kde-format
msgid "Do not print the mimetype of the given file(s)"
msgstr "Không hiện kiểu mime của các tập tin"

#: fileprops.cpp:247
#, kde-format
msgid "List all supported metadata keys."
msgstr "Hiện tất cả các khoá dữ liệu lý lịch được hỗ trợ"

#: fileprops.cpp:249
#, kde-format
msgid "List all metadata keys which have a value in the given file(s)."
msgstr ""
"Liệt kê tất cả các khoá dữ liệu lý lịch có một giá trị trong các tập tin."

#: fileprops.cpp:252
#, kde-format
msgid ""
"Do not print a warning when more than one file was given and they do not all "
"have the same mimetype."
msgstr ""
"Không hiện cảnh báo khi cung cấp nhiều hơn một tập tin và chúng không có "
"cùng kiểu mime."

#: fileprops.cpp:255
#, kde-format
msgid "Prints all metadata values, available in the given file(s)."
msgstr "Hiện tất cả giá trị dữ liệu lý lịch sẵn có trong các tập tin được cho."

#: fileprops.cpp:257
#, kde-format
msgid ""
"Opens a KDE properties dialog to allow viewing and modifying of metadata of "
"the given file(s)"
msgstr ""
"Mở hộp thoại thuộc tính KDE để cho phép xem và thay đổi dữ liệu lý lịch của "
"các tập tin"

#: fileprops.cpp:259
#, kde-format
msgid ""
"Prints the value for 'key' of the given file(s). 'key' may also be a comma-"
"separated list of keys"
msgstr ""
"Hiện giá trị cho 'khoá' của các tập tin. 'khoá' có thể là một danh sách phân "
"cách nhau bởi dấu phẩy của các khoá"

#: fileprops.cpp:261
#, kde-format
msgid ""
"Attempts to set the value 'value' for the metadata key 'key' for the given "
"file(s)"
msgstr ""
"Cố gắng đặt giá trị 'gia_tri' cho khoá dữ liệu lý lịch 'khoa' cho các tập "
"tin được cho"

#: fileprops.cpp:263
#, kde-format
msgid "The file (or a number of files) to operate on."
msgstr "Tập tin (hay nhiều tập tin) để thực hiện."

#: fileprops.cpp:277
#, kde-format
msgid "No files specified"
msgstr "Chưa chỉ định tập tin nào"

#: fileprops.cpp:297
#, kde-format
msgid "Cannot determine metadata"
msgstr "Không thể xem dữ liệu lý lịch"
