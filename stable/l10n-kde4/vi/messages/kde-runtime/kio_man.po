#: kio_man.cpp:482
#, kde-format
msgid ""
"No man page matching to %1 found.<br /><br />Check that you have not "
"mistyped the name of the page that you want.<br />Check that you have typed "
"the name using the correct upper and lower case characters.<br />If "
"everything looks correct, then you may need to improve the search path for "
"man pages; either using the environment variable MANPATH or using a matching "
"file in the /etc directory."
msgstr ""
"Không tìm thấy trang sổ tay nào khớp %1.<br /><br />Hãy chắc rằng bạn không "
"gõ nhầm tên của trang bạn cần.<br />Hãy chắc rằng bạn gõ tên sử dụng đúng ký "
"tự hoa thường.<br />Nếu mọi thứ nhìn có vẻ đúng thì bạn sẽ cần cải thiện "
"đường dẫn tìm kiếm cho các trang sổ tay bằng cách sử dụng biến môi trường "
"MANPATH hoặc dùng một tập tin khớp trong thư mục /etc."

#: kio_man.cpp:514
#, kde-format
msgid "Open of %1 failed."
msgstr "Không mở được %1."

