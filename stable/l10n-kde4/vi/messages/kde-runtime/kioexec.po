#: main.cpp:44
msgid "KIO Exec - Opens remote files, watches modifications, asks for upload"
msgstr "KIO Exec — mở tập tin từ xa, theo dõi cách sửa đổi, yêu cầu tải lên"

#: main.cpp:52
msgid "'command' expected.\n"
msgstr "mong đợi 'lệnh'.\n"

#: main.cpp:81
#, kde-format
msgid ""
"The URL %1\n"
"is malformed"
msgstr ""
"URL %1\n"
"sai dạng thức"

#: main.cpp:83
#, kde-format
msgid ""
"Remote URL %1\n"
"not allowed with --tempfiles switch"
msgstr ""
"Không cho phép URL %1\n"
"với đối số --tempfiles"

#: main.cpp:216
#, kde-format
msgid ""
"The supposedly temporary file\n"
"%1\n"
"has been modified.\n"
"Do you still want to delete it?"
msgstr ""
"Tập tin giả sử là tạm\n"
"%1\n"
"đã được sửa đổi.\n"
"Vậy bạn vẫn còn muốn xoá bỏ nó không?"

#: main.cpp:217 main.cpp:224
msgid "File Changed"
msgstr "Tập tin đã đổi"

#: main.cpp:217
msgid "Do Not Delete"
msgstr "Đừng xoá bỏ"

#: main.cpp:223
#, kde-format
msgid ""
"The file\n"
"%1\n"
"has been modified.\n"
"Do you want to upload the changes?"
msgstr ""
"Tập tin\n"
"%1\n"
"đã được sửa đổi.\n"
"Bạn có muốn tải lên các thay đổi không?"

#: main.cpp:224
msgid "Upload"
msgstr "Tải lên"

#: main.cpp:224
msgid "Do Not Upload"
msgstr "Đừng tải lên"

#: main.cpp:253
msgid "KIOExec"
msgstr "KIOExec"

