#: ksolidnotify.cpp:150
msgid "Devices notification"
msgstr "Thông báo thiết bị"

#: ksolidnotify.cpp:159
#, kde-format
msgid "Could not mount the following device: %1"
msgstr "Không thể gắn thiết bị sau: %1"

#: ksolidnotify.cpp:169
#, kde-format
msgid ""
"Could not unmount the following device: %1\n"
"One or more files on this device are open within an application "
msgstr ""
"Không thể gỡ thiết bị sau: %1\n"
"Một hay nhiều tập tin trên thiết bị này đang được mở trong một ứng dụng "

#: ksolidnotify.cpp:174
#, kde-format
msgctxt ""
"The term \"remove\" here means \"physically disconnect the device from the "
"computer\", whereas \"safely\" means \"without risk of data loss\""
msgid "The following device can now be safely removed: %1"
msgstr "Thiết bị sau có thể được gỡ bỏ an toàn: %1"

#: ksolidnotify.cpp:195
#, kde-format
msgid ""
"Could not eject the following device: %1\n"
"One or more files on this device are open within an application "
msgstr ""
"Không thể đẩy ra thiết bị sau: %1\n"
"Một hay nhiều tập tin trên thiết bị này đang được mở trong một ứng dụng "

#: ksolidnotify.cpp:200
#, kde-format
msgid "The following device can now be safely removed: %1"
msgstr "Thiết bị sau có thể được gỡ bỏ an toàn: %1"

