#: kwriteconfig.cpp:35
#, kde-format
msgid "KWriteConfig"
msgstr "KWriteConfig"

#: kwriteconfig.cpp:37
#, kde-format
msgid "Write KConfig entries - for use in shell scripts"
msgstr "Ghi mục KConfig - dùng trong các tập lệnh của hệ vỏ"

#: kwriteconfig.cpp:39
#, kde-format
msgid "(c) 2001 Red Hat, Inc. & Luís Pedro Coelho"
msgstr "(c) 2001 Red Hat, Inc. & Luís Pedro Coelho"

#: kwriteconfig.cpp:40
#, kde-format
msgid "Luís Pedro Coelho"
msgstr "Luís Pedro Coelho"

#: kwriteconfig.cpp:41
#, kde-format
msgid "Bernhard Rosenkraenzer"
msgstr "Bernhard Rosenkraenzer"

#: kwriteconfig.cpp:41
#, kde-format
msgid "Wrote kreadconfig on which this is based"
msgstr "Đã viết kreadconfig - là cơ sở cho chương trình này"

#: kwriteconfig.cpp:47
#, kde-format
msgid "Use <file> instead of global config"
msgstr "Dùng <file> thay cho cấu hình toàn hệ thống"

#: kwriteconfig.cpp:48
#, kde-format
msgid "Group to look in. Use repeatedly for nested groups."
msgstr "Nhóm để xem. Dùng lại với các nhóm lồng nhau."

#: kwriteconfig.cpp:49
#, kde-format
msgid "Key to look for"
msgstr "Từ khóa cần tìm kiếm"

#: kwriteconfig.cpp:50
#, kde-format
msgid ""
"Type of variable. Use \"bool\" for a boolean, otherwise it is treated as a "
"string"
msgstr ""
"Dạng biến. Dùng \"bool\" cho các biến lôgíc, nếu không thì sẽ là một chuỗi."

#: kwriteconfig.cpp:51
#, kde-format
msgid "The value to write. Mandatory, on a shell use '' for empty"
msgstr "Giá trị để ghi. Bắt buộc trên một hệ vỏ dùng '' cho rỗng"

#~ msgid "Group to look in"
#~ msgstr "Nhóm nơi cần tìm kiếm"

