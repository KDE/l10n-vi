#: solid-hardware.cpp:45
#, kde-format
msgid "solid-hardware"
msgstr "solid-hardware"

#: solid-hardware.cpp:47
#, kde-format
msgid "KDE tool for querying your hardware from the command line"
msgstr "Công cụ KDE để truy vấn phần cứng của bạn từ dòng lệnh"

#: solid-hardware.cpp:179
#, kde-format
msgid "Syntax Error: Not enough arguments"
msgstr "Lỗi cú pháp: Không đủ tham số"

#: solid-hardware.cpp:184
#, kde-format
msgid "Syntax Error: Too many arguments"
msgstr "Lỗi cú pháp: Quá nhiều tham số"

#: solid-hardware.cpp:195
#, kde-format
msgid "Show available commands"
msgstr "Hiện các lệnh cho phép"

#: solid-hardware.cpp:197
#, kde-format
msgid "Command (see --commands)"
msgstr "Lệnh (xem --commands)"

#: solid-hardware.cpp:199
#, kde-format
msgid "Arguments for command"
msgstr "Tham số cho lệnh"

#: solid-hardware.cpp:211
#, kde-format
msgid "Syntax:"
msgstr "Cú pháp:"

#: solid-hardware.cpp:214
#, kde-format
msgid ""
"             # List the hardware available in the system.\n"
"             # - If the 'nonportableinfo' option is specified, the device\n"
"             # properties are listed (be careful, in this case property "
"names\n"
"             # are backend dependent),\n"
"             # - If the 'details' option is specified, the device "
"interfaces\n"
"             # and the corresponding properties are listed in a platform\n"
"             # neutral fashion,\n"
"             # - Otherwise only device UDIs are listed.\n"
msgstr ""
"             # Liệt kê phần cứng sẵn có trong hệ thống.\n"
"             # - Nếu đặt tuỳ chọn 'nonportableinfo', thuộc tính thiết bị\n"
"             # sẽ được liệt kê (hãy cẩn thận, trong trường hợp này tên thuộc "
"tính\n"
"              # phụ thuộc vào hậu trường (backend),\n"
"             # - Nếu đặt tuỳ chọn 'details', các giao diện thiết bị\n"
"             # và các thuộc tính tương ứng sẽ được liệt kê theo cách không "
"phụ thuộc nền tảng,\n"
"             # - Mặc định chỉ các UDI của thiết bị được liệt kê.\n"

#: solid-hardware.cpp:224
#, kde-format
msgid ""
"             # Display all the interfaces and properties of the device\n"
"             # corresponding to 'udi' in a platform neutral fashion.\n"
msgstr ""
"             # Hiển thị tất cả các giao diện và thuộc tính của thiết bị\n"
"             # tương ứng với 'udi' theo cách không phụ thuộc nền tảng.\n"

#: solid-hardware.cpp:228
#, kde-format
msgid ""
"             # Display all the properties of the device corresponding to "
"'udi'\n"
"             # (be careful, in this case property names are backend "
"dependent).\n"
msgstr ""
"             # Hiển thị tất cả thuộc tính tương ứng với 'udi'\n"
"             # (hãy cẩn thận, trường hợp này tên thuộc tính sẽ phụ thuộc hậu "
"trường).\n"

#: solid-hardware.cpp:232
#, kde-format
msgid ""
"             # List the UDI of devices corresponding to 'predicate'.\n"
"             # - If 'parentUdi' is specified, the search is restricted to "
"the\n"
"             # branch of the corresponding device,\n"
"             # - Otherwise the search is done on all the devices.\n"
msgstr ""
"             # Liệt kê UDI của các thiết bị tương ứng với 'predicate'.\n"
"             # - Nếu đặt 'parentUID', quá trình tìm kiếm sẽ được giới hạn\n"
"             # vào nhánh của thiết bị tương ứng,\n"
"             # - Mặc định quá trình tìm kiếm sẽ thực hiện với tất cả thiết "
"bị.\n"

#: solid-hardware.cpp:238
#, kde-format
msgid ""
"             # If applicable, mount the device corresponding to 'udi'.\n"
msgstr "             # Nếu được sẽ gắn (mount) thiết bị tương ứng với 'udi'.\n"

#: solid-hardware.cpp:241
#, kde-format
msgid ""
"             # If applicable, unmount the device corresponding to 'udi'.\n"
msgstr "             # Nếu được sẽ gỡ thiết bị tương ứng với 'udi'.\n"

#: solid-hardware.cpp:244
#, kde-format
msgid ""
"             # If applicable, eject the device corresponding to 'udi'.\n"
msgstr "             # Nếu được sẽ đẩy ra thiết bị tương ứng với 'udi'.\n"

#: solid-hardware.cpp:247
#, kde-format
msgid "             # Listen to all add/remove events on supported hardware."
msgstr ""
"             # Nghe tất cả các sự kiện thêm/gỡ bỏ trên phần cứng được hỗ trợ."

#: solid-hardware.cpp:322
#, kde-format
msgid "Syntax Error: Unknown command '%1'"
msgstr "Lỗi cú pháp: Không rõ lệnh '%1'"

#: solid-hardware.cpp:392
#, kde-format
msgid "Error: %1 does not have the interface StorageAccess."
msgstr "Lỗi: %1 không có giao diện StorageAccess."

#: solid-hardware.cpp:397
#, kde-format
msgid "Error: %1 does not have the interface OpticalDrive."
msgstr "Lỗi: %1 không có giao diện OpticalDrive."

#: solid-hardware.cpp:430
#, kde-format
msgid "Error: %1"
msgstr "Lỗi: %1"

#: solid-hardware.cpp:465
#, kde-format
msgid "Progress: %1%"
msgstr "Quá trình: %1%"

#: solid-hardware.cpp:471
#, kde-format
msgid "Info: %1"
msgstr "Thông tin: %1"
