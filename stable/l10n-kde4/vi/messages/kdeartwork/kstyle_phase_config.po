#: rc.cpp:6
msgid ""
"This option will draw buttons and several other widgets using a gradient "
"texture"
msgstr "Lựa chọn này giúp vẽ các nút có màu chuyển tiếp"

#. i18n: tag string
#. i18n: file styledialog.ui line 22
#: rc.cpp:9
msgid "Use &gradients"
msgstr "Dùng &màu chuyển tiếp"

#. i18n: tag string
#. i18n: file styledialog.ui line 32
#: rc.cpp:12
msgid ""
"This option will highlight buttons and several other widgets when the mouse "
"cursor is over them"
msgstr "Lựa chọn này sẽ làm các nút sáng lên khi chuột đi qua"

#. i18n: tag string
#. i18n: file styledialog.ui line 35
#: rc.cpp:15
msgid "Highlight on &mouse hover"
msgstr "Sáng lên khi &chuột đi qua"

