#~ msgid ""
#~ "This is the ancient X maze demo, modified to work with xscreensaver. It "
#~ "generates a random maze, then solves it with visual feedback. Originally "
#~ "by Jim Randell; modified by a cast of thousands."
#~ msgstr ""
