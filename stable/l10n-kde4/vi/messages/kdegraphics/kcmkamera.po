#: kameradevice.cpp:216 kameradevice.cpp:320 kameradevice.cpp:406
msgid "Serial"
msgstr "Nối tiếp (serial)"

#: kameradevice.cpp:217 kameradevice.cpp:323 kameradevice.cpp:408
msgid "USB"
msgstr "USB"

#: kameradevice.cpp:218
