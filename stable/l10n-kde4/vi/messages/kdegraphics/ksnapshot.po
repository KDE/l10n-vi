#. i18n: tag string
#. i18n: file ksnapshotwidget.ui line 32
#: rc.cpp:3
#, fuzzy
msgid ""
"This is a preview of the current snapshot.\n"
"\n"
"The image can be dragged to another application or document to copy the full "
"screenshot there. Try it with the Konqueror file manager.\n"
"\n"
"You can also copy the image to the clipboard by pressing Ctrl+C."
msgstr ""
"Đây là bản xem thử của ảnh chụp. Ảnh này có thể được kéo vào một ứng dụng "
"hay một tài liệu khác để chép lại ở đó. Hãy thử với trình duyệt tập tin "
"Konqueror. Bạn cũng có thể chép ảnh này ra clipboard bằng cách ấn Ctrl+C."

#. i18n: tag string
#. i18n: file ksnapshotwidget.ui line 52
#: rc.cpp:10
msgid "Snapshot delay in seconds"
msgstr "Hoãn chụp hình với x giây"

#. i18n: tag string
#. i18n: file ksnapshotwidget.ui line 62
#: rc.cpp:13
msgid ""
"<qt>\n"
"This is the number of seconds to wait after clicking the <i>New Snapshot</i> "
"button before taking the snapshot.\n"
"<p>\n"
"This is very useful for getting windows, menus and other items on the screen "
"set up just the way you want.\n"
"<p>\n"
"If <i>no delay</i> is set, the program will wait for a mouse click before "
"taking a snapshot.\n"
"</p>\n"
"</qt>"
msgstr ""
"<qt> Số giây hoãn sau khi ấn nút <i>Chụp hình mới</i> trước khi chụp hình. "
"<p> Rất hữu hiệu cho sắp xếp các cửa sổ, trình đơn và các thứ khác trên màn "
"hình như bạn muốn. <p> Nếu chọn <i>không hoãn</i>, chương trình sẽ chờ nhấp "
"chuột để chụp. </p> </qt>"

#. i18n: tag string
#. i18n: file ksnapshotwidget.ui line 65
#: rc.cpp:23
msgid "No delay"
msgstr "Không hoãn"

#. i18n: tag string
#. i18n: file ksnapshotwidget.ui line 68
#: rc.cpp:26
msgid " sec"
msgstr " giây"

