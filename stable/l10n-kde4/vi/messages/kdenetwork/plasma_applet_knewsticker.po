#~ msgid "Condition for this filter"
#~ msgstr "Điều kiện lọc"

#~ msgid ""
#~ "This combo box lets you specify the condition under which the keyword/"
#~ "expression you entered in the input field at the right will match. You "
#~ "can select one of the following values:<ul>\n"
#~ "<li>contain - the filter matches if the headline contains the keyword.</"
#~ "li>\n"
#~ "<li>does not contain - the filter matches if the headline does not "
#~ "contain the keyword.</li>\n"
#~ "<li>equals - the filter matches if the headline equals the expression.</"
#~ "li>\n"
#~ "<li>does not equal - the filter matches if the headline does not equal "
#~ "the expression.</li>\n"
#~ "<li>matches - the filter matches if the expression matches the headline. "
#~ "The expression you typed at the right will be considered a regular "
#~ "expression in this mode.</li>"
#~ msgstr ""
#~ "Hộp tổ hợp này cho bạn xác định điều kiện với đó từ khoá/biểu thức bạn "
#~ "nhập vào trường hợp nhập bên phải sẽ khớp được. Có thể chọn một của những "
#~ "giá trị này:<ul>\n"
#~ "<li>chứa — lọc được nếu hàng đầu chứa từ khoá.</li>\n"
#~ "<li>không chứa — lọc được nếu hàng đầu không chứa từ khoá.</li>\n"
#~ "<li>bằng — lọc được nếu hàng đầu bằng với biểu thức.</li>\n"
#~ "<li>không bằng — lọc được nếu hàng đầu không bằng với biểu thức.</li>\n"
#~ "<li>khớp với — lọc được nếu biểu thức khớp với hàng đầu. Biểu thức bạn gõ "
#~ "bên phãi sẽ được xử lý như biểu thức chính quy trong chế độ này.</li>"

