#, kde-format
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "Nhóm Việt hoá KDE"

#, kde-format
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "kde-l10n-vi@kde.org"

#: plugin_rellinks.cpp:64
#, kde-format
msgid "Rellinks"
msgstr "Rellinks"

#: plugin_rellinks.cpp:72
#, kde-format
msgid "&Top"
msgstr "T&rên"

#: plugin_rellinks.cpp:75
#, kde-format
msgid "<p>This link references a home page or the top of some hierarchy.</p>"
msgstr "<p>Liên kết này chỉ tới trang chủ hoặc đầu phân cấp.</p>"

#: plugin_rellinks.cpp:79
#, kde-format
msgid "&Up"
msgstr "&Lên"

#: plugin_rellinks.cpp:82
#, kde-format
msgid ""
"<p>This link references the immediate parent of the current document.</p>"
msgstr "<p>Liên kết này chỉ tới cha ngay của tài liệu hiện thời.</p>"

#: plugin_rellinks.cpp:88
#, kde-format
msgid "&First"
msgstr "Đầ&u"

#: plugin_rellinks.cpp:91
#, kde-format
msgid ""
"<p>This link type tells search engines which document is considered by the "
"author to be the starting point of the collection.</p>"
msgstr ""
"<p>Liên kết này cho cơ chế tìm biết tài liệu nào là điểm bắt đầu của tập "
"này, tùy theo ý kiến của tác giả.</p>"

#: plugin_rellinks.cpp:95
#, kde-format
msgid "&Previous"
msgstr ""

#: plugin_rellinks.cpp:98
#, kde-format
msgid ""
"<p>This link references the previous document in an ordered series of "
"documents.</p>"
msgstr "<p>Liên kết này chỉ về tài liệu nằm trước trong thứ tự tài liệu.</p>"

#: plugin_rellinks.cpp:102
#, kde-format
msgid "&Next"
msgstr "&Kế"

#: plugin_rellinks.cpp:105
#, kde-format
msgid ""
"<p>This link references the next document in an ordered series of documents."
"</p>"
msgstr "<p>Liên kết này chỉ tới tài liệu nằm sau trong thứ tự tài liệu.</p>"

#: plugin_rellinks.cpp:109
#, kde-format
msgid "&Last"
msgstr "&Cuối"

#: plugin_rellinks.cpp:112
#, kde-format
msgid "<p>This link references the end of a sequence of documents.</p>"
msgstr "<p>Liên kết này chỉ tới kết thúc thứ tự tài liệu.</p>"

#: plugin_rellinks.cpp:117
#, kde-format
msgid "&Search"
msgstr "&Tìm"

#: plugin_rellinks.cpp:120
#, kde-format
msgid "<p>This link references the search.</p>"
msgstr "<p>Liên kết này chỉ tới việc tìm kiếm.</p>"

#: plugin_rellinks.cpp:124
#, kde-format
msgid "Document"
msgstr "Tài liệu"

#: plugin_rellinks.cpp:126
#, kde-format
msgid "<p>This menu contains the links referring the document information.</p>"
msgstr "<p>Trình đơn chứa các liên kết chỉ tới thông tin tài liệu.</p>"

#: plugin_rellinks.cpp:130
#, kde-format
msgid "Table of &Contents"
msgstr "&Mục lục"

#: plugin_rellinks.cpp:132
#, kde-format
msgid "<p>This link references the table of contents.</p>"
msgstr "<p>Liên kết này chỉ tới mục lục.</p>"

#: plugin_rellinks.cpp:136
#, kde-format
msgid "Chapters"
msgstr "Chương"

#: plugin_rellinks.cpp:141
#, kde-format
msgid "<p>This menu references the chapters of the document.</p>"
msgstr "<p>Trình đơn này chỉ tới các chương của tài liệu.</p>"

#: plugin_rellinks.cpp:144
#, kde-format
msgid "Sections"
msgstr "Phần"

#: plugin_rellinks.cpp:150
#, kde-format
msgid "<p>This menu references the sections of the document.</p>"
msgstr "<p>Trình đơn này chỉ tới các phần của tài liệu.</p>"

#: plugin_rellinks.cpp:153
#, kde-format
msgid "Subsections"
msgstr "Phần phụ"

#: plugin_rellinks.cpp:158
#, kde-format
msgid "<p>This menu references the subsections of the document.</p>"
msgstr "<p>Trình đơn này chỉ tới các phần phụ của tài liệu.</p>"

#: plugin_rellinks.cpp:161
#, kde-format
msgid "Appendix"
msgstr "Phụ lục"

#: plugin_rellinks.cpp:166
#, kde-format
msgid "<p>This link references the appendix.</p>"
msgstr "<p>Liên kết này chỉ tới phụ lục.</p>"

#: plugin_rellinks.cpp:170
#, kde-format
msgid "&Glossary"
msgstr "Chú &giải"

#: plugin_rellinks.cpp:172
#, kde-format
msgid "<p>This link references the glossary.</p>"
msgstr "<p>Liên kết này chỉ tới bản chú giải.</p>"

#: plugin_rellinks.cpp:177
#, kde-format
msgid "&Index"
msgstr "C&hỉ mục"

#: plugin_rellinks.cpp:179
#, kde-format
msgid "<p>This link references the index.</p>"
msgstr "<p>Liên kết này chỉ tới chỉ mục.</p>"

#: plugin_rellinks.cpp:184
#, kde-format
msgid "More"
msgstr "Thêm nữa"

#: plugin_rellinks.cpp:186
#, kde-format
msgid "<p>This menu contains other important links.</p>"
msgstr "<p>Trình đơn này chứa các liên kết quan trọng khác.</p>"

#: plugin_rellinks.cpp:190
#, kde-format
msgid "&Help"
msgstr ""

#: plugin_rellinks.cpp:193
#, kde-format
msgid "<p>This link references the help.</p>"
msgstr "<p>Liên kết này chỉ tới trợ giúp.</p>"

#: plugin_rellinks.cpp:198
#, kde-format
msgid "&Authors"
msgstr "Tác g&iả"

#: plugin_rellinks.cpp:201
#, kde-format
msgid "<p>This link references the author.</p>"
msgstr "<p>Liên kết này chỉ tới tác giả.</p>"

#: plugin_rellinks.cpp:206
#, kde-format
msgid "Copy&right"
msgstr "Tác &quyền"

#: plugin_rellinks.cpp:209
#, kde-format
msgid "<p>This link references the copyright.</p>"
msgstr "<p>Liên kết này chỉ tới tác quyền.</p>"

#: plugin_rellinks.cpp:213
#, kde-format
msgid "Bookmarks"
msgstr ""

#: plugin_rellinks.cpp:216
#, kde-format
msgid "<p>This menu references the bookmarks.</p>"
msgstr "<p>Trình đơn này chỉ tới các dấu nhớ.</p>"

#: plugin_rellinks.cpp:220
#, kde-format
msgid "Other Versions"
msgstr "Phiên bản khác"

#: plugin_rellinks.cpp:223
#, kde-format
msgid "<p>This link references the alternate versions of this document.</p>"
msgstr "<p>Liên kết này chỉ tới các phiên bản xen kẽ của tài liệu này.</p>"

#: plugin_rellinks.cpp:228
#, fuzzy, kde-format
msgid "Miscellaneous"
msgstr "<p>Liên kết lặt vặt.</p>"

#: plugin_rellinks.cpp:231
#, kde-format
msgid "<p>Miscellaneous links.</p>"
msgstr "<p>Liên kết lặt vặt.</p>"

#: plugin_rellinks.cpp:477 plugin_rellinks.cpp:492
#, kde-format
msgid "[Autodetected] %1"
msgstr "[Tự phát hiện] %1"

