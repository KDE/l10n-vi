#, kde-format
msgid "%1 theme already exists"
msgstr "Sắc thái %1 đã tồn tại"

#: emoticonslist.cpp:392
msgid "Choose the type of emoticon theme to create"
msgstr "Chọn loại sắc thái mặt cười để tạo"

