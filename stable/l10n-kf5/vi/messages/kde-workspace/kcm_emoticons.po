#: emoticonslist.cpp:72
msgid ""
"Insert the string for the emoticon.  If you want multiple strings, separate "
"them by spaces."
msgstr ""
"Thêm chuỗi cho mặt cười. Nếu bạn muốn nhiều dùng nhiều chuỗi, hãy chia tách "
"chúng bởi dấu cách."

#: emoticonslist.cpp:112
msgid "Emoticons"
msgstr "Mặt cười"

#: emoticonslist.cpp:259
msgid "Drag or Type Emoticon Theme URL"
msgstr "Kéo hoặc nhập liên kết sắc thái mặt cười"

#: emoticonslist.cpp:264
msgid "Emoticon themes must be installed from local files."
msgstr "Sắc thái mặt cười phải được cài đặt từ tập tin trong máy."

#: emoticonslist.cpp:265
msgid "Could Not Install Emoticon Theme"
msgstr "Không thể cài đặt sắc thái mặt cười"

#: emoticonslist.cpp:283
#, kde-format
msgid "Do you want to remove %1 too?"
msgstr "Bạn có muốn cùng xoá bỏ %1 không?"

#: emoticonslist.cpp:283
msgid "Delete emoticon"
msgstr "Xoá mặt cười"

#: emoticonslist.cpp:299
msgid "Add Emoticon"
msgstr "Thêm mặt cười"

#: emoticonslist.cpp:323
msgid "Edit Emoticon"
msgstr "Sửa mặt cười"

#: emoticonslist.cpp:369 emoticonslist.cpp:392
msgid "New Emoticon Theme"
msgstr "Sắc thái mặt cười mới"

#: emoticonslist.cpp:369
msgid "Enter the name of the new emoticon theme:"
msgstr "Nhập tên của sắc thái mặt cười mới:"

