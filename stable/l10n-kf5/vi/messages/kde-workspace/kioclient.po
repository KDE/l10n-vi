msgid "Your names"
msgstr ""

msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr ""

#: kioclient.cpp:75
msgid ""
"\n"
"Syntax:\n"
msgstr ""
"\n"
"Cú pháp:\n"

#: kioclient.cpp:76
msgid ""
"  kioclient openProperties 'url'\n"
"            # Opens a properties menu\n"
"\n"
msgstr ""
"  kioclient openProperties 'url'\n"
"            # Mở một trình đơn thuộc tính\n"
"\n"

#: kioclient.cpp:78
msgid ""
"  kioclient exec 'url' ['mimetype']\n"
"            # Tries to open the document pointed to by 'url', in the "
"application\n"
"            #   associated with it in KDE. You may omit 'mimetype'.\n"
"            #   In this case the mimetype is determined\n"
"            #   automatically. Of course URL may be the URL of a\n"
"            #   document, or it may be a *.desktop file.\n"
"            #   'url' can be an executable, too.\n"
msgstr ""
"  kioclient exec 'url' ['mimetype']\n"
"            # Thử mở một tập tin được trỏ tới bởi 'url', trong ứng dụng\n"
"            #   liên kết với nó bởi KDE. Bạn có thể bỏ qua 'mimetype'.\n"
"            #   Trong trường hợp này, kiểu tập tin sẽ được nhận dạng\n"
"            #   tự động. Tất nhiên, URL vừa có thể là URL của một tài\n"
"            #   liệu, vừa có thể là một tập tin *.desktop.\n"
"            #   'url' cũng có thể là một tập tin thực thi nữa.\n"

#: kioclient.cpp:85
msgid ""
"  kioclient move 'src' 'dest'\n"
"            # Moves the URL 'src' to 'dest'.\n"
"            #   'src' may be a list of URLs.\n"
msgstr ""
"  kioclient move 'src' 'dest'\n"
"            # Di chuyển các URL 'src' tới 'dest'.\n"
"            #   'src' có thể là danh sách các URL.\n"

#: kioclient.cpp:88
msgid ""
"            #   'dest' may be \"trash:/\" to move the files\n"
"            #   to the trash.\n"
msgstr ""
"            #   'dest' có thể là \"trash:/\" để di chuyển tập tin\n"
"            #   vào thùng rác.\n"

#: kioclient.cpp:90
msgid ""
"            #   the short version kioclient mv\n"
"            #   is also available.\n"
"\n"
msgstr ""
"            #   phiên bản rút gọn: kioclient mv\n"
"\n"

#: kioclient.cpp:92
msgid ""
"  kioclient download ['src']\n"
"            # Copies the URL 'src' to a user-specified location'.\n"
"            #   'src' may be a list of URLs, if not present then\n"
"            #   a URL will be requested.\n"
"\n"
msgstr ""
"  kioclient download ['src']\n"
"            # Sao chép URL 'src' vào vị trí được người dùng chỉ định'.\n"
"            #   'src' có thể là danh sách các URL, nếu như chưa có\n"
"            #   thì một yêu cầu URL sẽ được đưa ra.\n"
"\n"

#: kioclient.cpp:96
msgid ""
"  kioclient copy 'src' 'dest'\n"
"            # Copies the URL 'src' to 'dest'.\n"
"            #   'src' may be a list of URLs.\n"
msgstr ""
"  kioclient copy 'src' 'dest'\n"
"            # Sao chép URL 'src' tới 'dest'.\n"
"            #   'src' có thể là danh sách các URL.\n"

#: kioclient.cpp:99
msgid ""
"            #   the short version kioclient cp\n"
"            #   is also available.\n"
"\n"
msgstr ""
"            #  phiên bản rút gọn: kioclient cp\n"
"\n"

#: kioclient.cpp:101
msgid ""
"  kioclient cat 'url'\n"
"            # Writes out the contents of 'url' to stdout\n"
"\n"
msgstr ""
"  kioclient cat 'url'\n"
"            # Hiện nội dung của 'url' lên đầu ra tiêu chuẩn (stdout)\n"
"\n"

#: kioclient.cpp:103
msgid ""
"  kioclient ls 'url'\n"
"            # Lists the contents of the directory 'url' to stdout\n"
"\n"
msgstr ""
"  kioclient ls 'url'\n"
"            # Liệt kê nội dung của thư mục 'url' lên đầu ra tiêu chuẩn "
"(stdout)\n"
"\n"

#: kioclient.cpp:105
msgid ""
"  kioclient remove 'url'\n"
"            # Removes the URL\n"
"            #   'url' may be a list of URLs.\n"
msgstr ""
"  kioclient remove 'url'\n"
"            # Xoá bỏ URL\n"
"            #   'url' có thể là danh sách các URL.\n"

#: kioclient.cpp:108
msgid ""
"            #   the short version kioclient rm\n"
"            #   is also available.\n"
"\n"
msgstr ""
"            #   phiên bản rút gọn: kioclient rm\n"
"\n"

#: kioclient.cpp:111
msgid ""
"*** Examples:\n"
"  kioclient exec file:/root/Desktop/cdrom.desktop \"Mount default\"\n"
"             // Mounts the CDROM\n"
"\n"
msgstr ""
"*** Ví dụ:\n"
"  kioclient exec file:/root/Desktop/cdrom.desktop \"Mount default\"\n"
"             // Gắn đĩa CDROM\n"
"\n"

#: kioclient.cpp:114
msgid ""
"  kioclient exec file:/home/weis/data/test.html\n"
"             // Opens the file with default binding\n"
"\n"
msgstr ""
"  kioclient exec file:/home/weis/data/test.html\n"
"             // Mở tập tin với ứng dụng mặc định\n"
"\n"

#: kioclient.cpp:116
msgid ""
"  kioclient exec file:/home/weis/data/test.html Netscape\n"
"             // Opens the file with netscape\n"
"\n"
msgstr ""
"  kioclient exec file:/home/weis/data/test.html Netscape\n"
"             // Mở tập tin với netscape\n"
"\n"

#: kioclient.cpp:118
msgid ""
"  kioclient exec ftp://localhost/\n"
"             // Opens new window with URL\n"
"\n"
msgstr ""
"  kioclient exec ftp://localhost/\n"
"             // Mở một cửa sổ mới với URL\n"
"\n"

#: kioclient.cpp:120
msgid ""
"  kioclient exec file:/root/Desktop/emacs.desktop\n"
"             // Starts emacs\n"
"\n"
msgstr ""
"  kioclient exec file:/root/Desktop/emacs.desktop\n"
"             // Chạy emacs\n"
"\n"

#: kioclient.cpp:122
msgid ""
"  kioclient exec file:/root/Desktop/cdrom.desktop\n"
"             // Opens the CDROM's mount directory\n"
"\n"
msgstr ""
"  kioclient exec file:/root/Desktop/cdrom.desktop\n"
"             // Mở thư mục đã gắn đĩa CDROM\n"
"\n"

#: kioclient.cpp:124
msgid ""
"  kioclient exec .\n"
"             // Opens the current directory. Very convenient.\n"
"\n"
msgstr ""
"  kioclient exec .\n"
"             // Mở thư mục hiện tại. Rất tiện lợi đấy.\n"
"\n"

