#: package/contents/config/config.qml:25
msgid "General"
msgstr ""

#: package/contents/ui/configGeneral.qml:45
msgid "Removable devices only"
msgstr "Chỉ thiết bị gắn ngoài"

#: package/contents/ui/configGeneral.qml:50
msgid "Non-removable devices only"
msgstr "Chỉ thiết bị gắn trong"

#: package/contents/ui/configGeneral.qml:55
msgid "All devices"
msgstr "Tất cả thiết bị"

#: package/contents/ui/configGeneral.qml:62
msgid "Open popup when new device is plugged in"
msgstr ""

#: package/contents/ui/DeviceItem.qml:167
msgid ""
"It is currently <b>not safe</b> to remove this device: applications may be "
"accessing it. Click the eject button to safely remove this device."
msgstr ""
"Hiện <b>không an toàn</b> để tháo thiết bị này; các ứng dụng có thể đang "
"truy cập vào nó. Nhấn nút đẩy ra để tháo an toàn thiết bị này."

#: package/contents/ui/DeviceItem.qml:169
msgid "This device is currently accessible."
msgstr "Thiết bị hiện truy cập được."

#: package/contents/ui/DeviceItem.qml:174
msgid ""
"It is currently <b>not safe</b> to remove this device: applications may be "
"accessing other volumes on this device. Click the eject button on these "
"other volumes to safely remove this device."
msgstr ""
"Hiện <b>không an toàn</b> để tháo thiết bị này; các ứng dụng có thể đang "
"truy cập vào các phân vùng bên trong thiết bị. Nhấn nút đẩy ra trên các phân "
"vùng để tháo an toàn thiết bị này."

#: package/contents/ui/DeviceItem.qml:176
msgid "It is currently safe to remove this device."
msgstr "Hiện đã an toàn để tháo thiết bị này."

#: package/contents/ui/DeviceItem.qml:179
msgid "This device is not currently accessible."
msgstr "Thiết bị này hiện không truy cập được."

#: package/contents/ui/DeviceItem.qml:220
#, kde-format
msgctxt "@info:status Free disk space"
msgid "%1 free"
msgstr "%1 trống"

#: package/contents/ui/DeviceItem.qml:247
#, kde-format
msgid "1 action for this device"
msgid_plural "%1 actions for this device"
msgstr[0] "%1 hành động cho thiết bị này"

#: package/contents/ui/DeviceItem.qml:252
msgctxt ""
"Accessing is a less technical word for Mounting; translation should be short "
"and mean 'Currently mounting this device'"
msgid "Accessing..."
msgstr "Đang truy cập..."

#: package/contents/ui/DeviceItem.qml:254
msgctxt ""
"Removing is a less technical word for Unmounting; translation shoud be short "
"and mean 'Currently unmounting this device'"
msgid "Removing..."
msgstr "Đang gỡ..."

#: package/contents/ui/devicenotifier.qml:55
#: package/contents/ui/FullRepresentation.qml:39
msgid "No Devices Available"
msgstr "Không có thiết bị ngoài nào"

#: package/contents/ui/devicenotifier.qml:55
#, fuzzy
#| msgid "Most recent device"
msgid "Most Recent Device"
msgstr "Thiết bị gần đây nhất"

#: package/contents/ui/FullRepresentation.qml:154
msgid "Click to access this device from other applications."
msgstr "Nhấn để truy cập thiết bị này từ ứng dụng khác."

#: package/contents/ui/FullRepresentation.qml:156
msgid "Click to eject this disc."
msgstr "Nhấn để đẩy đĩa này ra."

#: package/contents/ui/FullRepresentation.qml:158
msgid "Click to safely remove this device."
msgstr "Nhấn để tháo an toàn thiết bị này."

