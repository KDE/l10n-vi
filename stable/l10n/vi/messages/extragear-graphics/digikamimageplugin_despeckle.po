#: imageeffect_despeckle.cpp:57
#: imageeffect_despeckle.cpp:62
#: imageeffect_despeckle.cpp:241
msgid "Noise Reduction"
msgstr "Giảm ồn"

#: imageeffect_despeckle.cpp:64
msgid "A despeckle image filter plugin for digiKam."
msgstr "Bổ sung lọc ảnh bỏ lốm đốm cho digiKam."

#: imageeffect_despeckle.cpp:70
msgid "Author and maintainer"
msgstr "Tác giả và nhà duy trì"

#: imageeffect_despeckle.cpp:73
msgid "Despeckle algorithm author from Gimp"
msgstr "Tác giả thuật toán bỏ lốm đốm từ GIMP."

#: imageeffect_despeckle.cpp:83
msgid "Radius:"
msgstr "Bán kính:"

#: imageeffect_despeckle.cpp:88
msgid ""
"<p>A radius of 0 has no effect, 1 and above determine the blur matrix radius "
"that determines how much to blur the image."
msgstr "<p>Bán kính 0 không có tác động; 1 và lớn hơn quyết định bán kính ma trận che mờ mà tính bao nhiều cần che mờ ảnh đó."

#: imageeffect_despeckle.cpp:97
msgid "Black level:"
msgstr "Cấp đen:"

#: imageeffect_despeckle.cpp:102
msgid ""
"<p>This value controls the black levels used by the adaptive filter to "
"adjust the filter radius."
msgstr "<p>Giá trị này điều khiển cấp màu đen được dùng bởi bộ lọc thích nghị để điều chỉnh bán kính lọc."

#: imageeffect_despeckle.cpp:111
msgid "White level:"
msgstr "Cấp trắng:"

#: imageeffect_despeckle.cpp:116
msgid ""
"<p>This value controls the white levels used by the adaptive filter to "
"adjust the filter radius."
msgstr "<p>Giá trị này điều khiển cấp màu trắng được dùng bởi bộ lọc thích nghị để điều chỉnh bán kính lọc."

#: imageeffect_despeckle.cpp:125
msgid "Adaptive"
msgstr "Thích nghị"

#: imageeffect_despeckle.cpp:126
msgid "<p>This option use an adaptive median filter type."
msgstr "<p>Tùy chọn này dùng một kiểu bộ lọc trung bình mang tính thích nghị."

#: imageeffect_despeckle.cpp:128
msgid "Recursive"
msgstr "Đệ qui"

#: imageeffect_despeckle.cpp:129
msgid "<p>This option use a recursive median filter type."
msgstr "<p>Tùy chọn này dùng một kiểu bộ lọc trung đệ qui."

#: imageplugin_despeckle.cpp:43
msgid "Noise Reduction..."
msgstr "Giảm ồn..."

#.i18n: file digikamimageplugin_despeckle_ui.rc line 7
#: rc.cpp:3
#, no-c-format
msgid "Fi&x"
msgstr "&Sửa chữa"

#~ msgid "Noise Reduction algorithm. Developer"
#~ msgstr "Nhà phát triển thuật toán giảm ồn"

#~ msgid "Details"
#~ msgstr "Chi tiết"

#~ msgid ""
#~ "<p><b>Radius</b>: this control selects the gliding window size used for "
#~ "the filter. Larger values do not increase the amount of time needed to "
#~ "filter each pixel in the image but can cause blurring. This window moves "
#~ "across the image, and the color in it is smoothed to remove "
#~ "imperfections. In any case it must be about the same size as noise "
#~ "granularity or somewhat more. If it is set higher than necessary, then it "
#~ "can cause unwanted blur."
#~ msgstr "<p><b>Bán kính</b>: cái điều khiển này chọn kích cỡ của cửa sổ dịch được "
#~ "dùng cho bộ lọc đó. Giá trị lớn hơn không tăng thời gian cần thiết để lọc "
#~ "mỗi điểm ảnh trong ảnh còn có thể gây ra ảnh bị che mờ. Cửa sổ này di "
#~ "chuyển qua ảnh, và màu trong nó được làm mịn để giảm sự không hoàn hảo. "
#~ "Trong bất cứ trường hợp này, nó phải là khoảng cùng kích cỡ với độ hạt ồn "
#~ "hay một ít lớn hơn. Nếu nó được đặt cao hơn cần thiết, nó có thể gây ra "
#~ "cảnh mờ không được muốn."

#~ msgid "Threshold:"
#~ msgstr "Ngưỡng:"

#~ msgid ""
#~ "<p><b>Threshold</b>: use the slider for coarse adjustment, and the spin "
#~ "control for fine adjustment. This controls edge detection sensitivity. "
#~ "This value should be set so that edges and details are clearly visible "
#~ "and noise is smoothed out. Adjustment must be made carefully, because the "
#~ "gap between \"noisy\", \"smooth\", and \"blur\" is very small. Adjust it "
#~ "as carefully as you would adjust the focus of a camera."
#~ msgstr "<p><b>Ngưỡng</b>: dùng con trượt để điều chỉnh nhiều, và cái điều khiển "
#~ "xoay để điều chỉnh ít. Tính năng này điều khiển độ nhạy phát hiện cạnh. "
#~ "Giá trị này nên được đặt để hiển thị rõ các cạnh và chi tiết, còn ồn được "
#~ "làm mịn ra. Cần phải điều chỉnh cẩn thận, vì hiệu giữa « ồn ào », « mịn » "
#~ "và « cảnh mờ » là rất ít. Điều chỉnh nó một cách cẩn thận cùng với một "
#~ "cách điều chỉnh tiêu điểm của máy ảnh."

#~ msgid "Texture:"
#~ msgstr "Họa tiết:"

#~ msgid ""
#~ "<p><b>Texture</b>: this control set the texture accuracy. This value can "
#~ "be used, to get more or less texture accuracy. When decreased, then noise "
#~ "and texture are blurred out, when increased then texture is amplified, "
#~ "but also noise will increase. It has almost no effect to image edges."
#~ msgstr "<p><b>Họa tiết</b>: cái điều khiển này đặt độ chính xác họa tiết. Giá trị "
#~ "này có thể được dùng để tăng hay giảm độ chính xác họa tiết. Khi được "
#~ "giảm, ồn và họa tiết bị che mờ ra, còn khi được tăng, cả họa tiết lẫn ồn "
#~ "được tăng. Nó gần như không có tắc động cạnh ảnh."

#~ msgid "Sharpness:"
#~ msgstr "Độ sắc:"

#~ msgid ""
#~ "<p><b>Sharpness</b>: This value improves the frequency response for the "
#~ "filter. When it is too strong then not all noise can be removed, or spike "
#~ "noise may appear. Set it near to maximum, if you want to remove very weak "
#~ "noise or JPEG-artifacts, without loosing detail."
#~ msgstr "<p><b>Độ sắc</b>: giá trị này tăng độ đáp ứng tần số cho bộ lọc đó. Khi "
#~ "nó là quá mạnh, không thể giảm toàn bộ ồn, hoặc ồn gai sẽ xuất hiện. Hãy "
#~ "đặt nó gần số không, nếu bạn muốn gỡ bỏ ồn rất yếu hay đồ tạo tác JPEG mà "
#~ "không mất chi tiết."

#~ msgid "Edge Lookahead:"
#~ msgstr "Nhìn trước cạnh:"

#~ msgid ""
#~ "<p><b>Edge</b>: This value defines the pixel distance in which the filter "
#~ "looks ahead for Edges. When this value is increased, then spikenoise is "
#~ "erased. You can eventually readjust filter <b>Edge</b>, when you changed "
#~ "this setting. When this value is to high, then the adaptive filter cannot "
#~ "longer accurately track image details, and noise can reappear or blur can "
#~ "occur."
#~ msgstr "<p><b>Cạnh</b>: giá trị này xác định khoảng cách điểm ảnh trong đó bộ lọc "
#~ "nhìn trước tìm Cạnh. Khi giá trị này được tăng, ồn gai được xoá bỏ. Cuối "
#~ "cùng bạn có thể điều chỉnh lại bộ lọc <b>Cạnh</b> khi bạn đã thay đổi "
#~ "thiết lập này. Khi giá trị này là quá cao, bộ lọc thích nghi không thể "
#~ "theo dõi chi tiết ảnh một cách chính xác, và ồn có thể xuất hiện hoặc "
#~ "cảnh mờ có thể xảy ra."

#~ msgid "Erosion:"
#~ msgstr "Độ xói mòn:"

#~ msgid ""
#~ "<p><b>Erosion</b>: Use this to increase edge noise erosion and spike "
#~ "noise erosion. (noise is removed by erosion)"
#~ msgstr "<p><b>Độ xói mòn</b>: dùng tính năng này để tăng độ xói mòn ồn cạnh và độ "
#~ "xói mòn ồn gai (ồn được gỡ bỏ bởi sự xoá mòn)."

#~ msgid "Advanced"
#~ msgstr "Cấp cao"

#~ msgid "Luminance:"
#~ msgstr "Độ trưng:"

#~ msgid ""
#~ "<p><b>Luminance</b>: this control set the luminance tolerance of image. "
#~ "It's recommended to use only <b>Color</b> or <b>Luminance</b> tolerance "
#~ "settings to make an image correction, not the both at the same time. This "
#~ "settings don't influence the main smoothing process controled by "
#~ "<b>Details</b> settings."
#~ msgstr "<p><b>Độ trưng</b>: cái điều khiển này đặt độ chịu đựng trưng của ảnh. "
#~ "Khuyên bạn dùng chỉ thiết lập độ chịu đựng <b>Màu</b> hay <b>Độ trưng</b> "
#~ "để sửa chữa ảnh, không phải cả hai cùng lúc. Những thiết lập này không có "
#~ "tác động tiến trình làm mịn chính được điều khiển bởi thiết lập <b>Chi "
#~ "tiết</b>."

#~ msgid "Color:"
#~ msgstr "Màu :"

#~ msgid ""
#~ "<p><b>Color</b>: this control set the color tolerance of image. It's "
#~ "recommended to use only <b>Color</b> or <b>Luminance</b> tolerance "
#~ "settings to make an image correction, not the both at the same time. This "
#~ "settings don't influence the main smoothing process controled by "
#~ "<b>Details</b> settings."
#~ msgstr "<p><b>Màu </b>: cái điều khiển này đặt độ chịu đựng màu của ảnh. Khuyên "
#~ "bạn dùng chỉ thiết lập độ chịu đựng <b>Màu</b> hay <b>Độ trưng</b> để sửa "
#~ "chữa ảnh, không phải cả hai cùng lúc. Những thiết lập này không có tác "
#~ "động tiến trình làm mịn chính được điều khiển bởi thiết lập <b>Chi tiết</"
#~ "b>."

#~ msgid "Gamma:"
#~ msgstr "Gamma:"

#~ msgid ""
#~ "<p><b>Gamma</b>: this control set the gamma tolerance of image. This "
#~ "value can be used to increase the tolerance values for darker areas "
#~ "(which commonly are more noisy). This results in more blur for shadow "
#~ "areas."
#~ msgstr "<p><b>Gamma</b>: cái điều khiển này đặt độ chịu đựng gamma của ảnh. Giá "
#~ "trị này có thể được dùng để tăng giá trị độ chịu đựng cho vùng tối hơn "
#~ "(mà thường có ồn nhiều hơn). Kết quả là cảnh mờ nhiều hơn trong vùng bóng."

#~ msgid "Damping:"
#~ msgstr "Suy giảm:"

#~ msgid ""
#~ "<p><b>Damping</b>: this control set the phase jitter damping adjustement. "
#~ "This value defines how fast the adaptive filter-radius reacts to "
#~ "luminance variations. If increased, then edges appear smoother, if too "
#~ "high, then blur may occur. If at minimum then noise and phase jitter at "
#~ "edges can occur. It can supress spike noise when increased and this is "
#~ "the preferred method to remove it."
#~ msgstr "<p><b>Suy giảm</b>: cái điều khiển này đặt cách điều chỉnh suy giảm hiệu "
#~ "ngẫu nhiên thời kỳ. Giá trị này xác định tốc độ của phản ứng của bán kính "
#~ "lọc thích nghị với sự biến đổi độ trưng. Nếu nó được tăng, các cạnh xuất "
#~ "hiện mịn hơn; nếu nó quá cao, cảnh mờ có thể xảy ra. Nếu nó tại tối "
#~ "thiểu, ồn và hiệu ngẫu nhiên thời kỳ tại cạnh có thể xảy ra. Thiết lập "
#~ "này có thể thu hồi ồn gai khi được tăng và đây là phương pháp tốt hơn để "
#~ "gỡ bỏ nó."

