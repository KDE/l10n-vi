#: imageeffect_infrared.cpp:57
msgid "Simulate Infrared Film to Photograph"
msgstr "Mô phỏng phim hồng ngoại trên ảnh chụp"

#: imageeffect_infrared.cpp:63
msgid "Infrared Film"
msgstr "Phim hồng ngoại"

#: imageeffect_infrared.cpp:65
msgid "A digiKam image plugin to simulate infrared film."
msgstr "Bổ sung ảnh digiKam để mô phỏng phim hồng ngoại."

#: imageeffect_infrared.cpp:71
msgid "Author and maintainer"
msgstr "Tác giả và nhà duy trì"

#: imageeffect_infrared.cpp:80
msgid "Sensibility (ISO):"
msgstr "Độ nhạy (ISO):"

#: imageeffect_infrared.cpp:90
msgid ""
"<p>Set here the ISO-sensitivity of the simulated infrared film. Increasing "
"this value will increase the portion of green color in the mix. It will also "
"increase the halo effect on the hightlights, and the film graininess (if the "
"box is checked)."
msgstr "<p>Ở đây hãy đặt độ nhạy ISO của phim hồng ngoại được mô phỏng. Việc tăng "
"giá trị này sẽ tăng phần màu xanh lá cây trong sự pha trộn. Nó sẽ cũng tăng "
"hiệu ứng quầng trên những chỗ sáng và độ hạt mảng thuốc (nếu hộp đó được "
"đánh dấu)."

#: imageeffect_infrared.cpp:104
msgid "Add film grain"
msgstr "Thêm hạt mảng thuốc"

#: imageeffect_infrared.cpp:106
msgid ""
"<p>This option is adding infrared film grain to the image depending on ISO-"
"sensitivity."
msgstr "<p>Tùy chọn này thêm hạt mảng thuốc vào ảnh, phụ thuộc vào độ nhạy ISO."

#: imageeffect_infrared.cpp:184
msgid "Infrared"
msgstr "Hồng ngoại"

#: imageplugin_infrared.cpp:42
msgid "Infrared Film..."
msgstr "Phim hồng ngoại..."

