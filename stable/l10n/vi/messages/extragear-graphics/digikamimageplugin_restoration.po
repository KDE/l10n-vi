#: imageeffect_restoration.cpp:64 imageeffect_restoration.cpp:72
msgid "Photograph Restoration"
msgstr "Phục hồi lại ảnh chụp"

#: imageeffect_restoration.cpp:74
msgid "A digiKam image plugin to restore a photograph."
msgstr "Bổ sung ảnh digiKam để phục hồi lại ảnh chụp."

#: imageeffect_restoration.cpp:80
msgid "Author and maintainer"
msgstr "Tác giả và nhà duy trì"

#: imageeffect_restoration.cpp:83
msgid "CImg library"
msgstr "Thư viện CImg"

#: imageeffect_restoration.cpp:86
msgid "Feedback and plugin polishing"
msgstr "Phản hồi và điều chỉnh bổ sung"

#: imageeffect_restoration.cpp:97
msgid "Preset"
msgstr "Định sẵn"

#: imageeffect_restoration.cpp:105
msgid "Visit CImg library website"
msgstr "Thăm nơi Mạng của thư viện CImg"

#: imageeffect_restoration.cpp:107
msgid "Filtering type:"
msgstr "Kiểu lọc:"

#: imageeffect_restoration.cpp:109
msgid "None"
msgstr "Không có"

#: imageeffect_restoration.cpp:110
msgid "Reduce Uniform Noise"
msgstr "Giảm ồn đồng dạng"

#: imageeffect_restoration.cpp:111
msgid "Reduce JPEG Artefacts"
msgstr "Giảm đồ tạo tác JPEG"

#: imageeffect_restoration.cpp:112
msgid "Reduce Texturing"
msgstr "Giảm độ họa tiết hoá"

#: imageeffect_restoration.cpp:113
msgid ""
"<p>Select here the filter preset to use for photograph restoration:"
"<p><b>None</b>: Most common values. Puts settings to default.<p><b>Reduce "
"Uniform Noise</b>: reduce small image artefacts like sensor noise."
"<p><b>Reduce JPEG Artefacts</b>: reduce large image artefacts like JPEG "
"compression mosaic.<p><b>Reduce Texturing</b>: reduce image artefacts like "
"paper texture or Moire patterns of a scanned image.<p>"
msgstr ""
"<p>Ở đây hãy chọn định sẵn lọc cần dùng khi phục hồi lại ảnh chụp:"
"<p><b>Không có</b>: những giá trị thường nhất; đặt thiết lập thành mặc định."
"<p><b>Giả  ồn đồng dạng</b>: giảm đồ tạo tác ảnh nhỏ như ồn máy nhạy."
"<p><b>Giảm đồ tạo tác JPEG</b>: giảm đồ tạo tác ảnh lớn như  đồ khảm nén "
"JPEG.<p><b>Giảm đồ họa tiết hoá</b>: giảm đồ tạo tác ảnh như họa tiết giấy "
"hay mẫu Moire của ảnh đã được quét.<p>"

#: imageeffect_restoration.cpp:129
msgid "Smoothing"
msgstr "Làm mịn"

#: imageeffect_restoration.cpp:131
msgid "Detail preservation:"
msgstr "Bảo tồn chi tiết:"

#: imageeffect_restoration.cpp:135
msgid ""
"<p>Preservation of details to set the sharpening level of the small features "
"in the target image. Higher values leave details sharp."
msgstr ""
"<p>Cách bảo tồn chi tiết để đặt cấp mài sắc của những tính năng nhỏ trên ảnh "
"đích. Giá trị cao hơn để lại chi tiết sắc."

#: imageeffect_restoration.cpp:141
msgid "Anisotropy:"
msgstr "Tính dị hướng:"

#: imageeffect_restoration.cpp:145
msgid ""
"<p>Anisotropic (directional) modifier of the details. Keep it small for "
"Gaussian noise."
msgstr ""
"<p>Đồ sửa đổi tính dị hướng (kiểu hướng) chi tiết. Đặt giá trị nhỏ để tạo ồn "
"kiểu Gauss."

#: imageeffect_restoration.cpp:149
msgid "Smoothing:"
msgstr "Làm mịn:"

#: imageeffect_restoration.cpp:153
msgid ""
"<p>Total smoothing power: if Detail Factor sets the relative smoothing and "
"Gradient Factor the direction, Time Step sets the overall effect."
msgstr ""
"<p>Tổng độ mạnh làm mịn: nếu Hệ số chi tiết đặt độ làm mịn tương đối và Hệ "
"số bán kính đặt hướng, Bước thời gian đặt hiệu ứng toàn bộ."

#: imageeffect_restoration.cpp:158
msgid "Regularity:"
msgstr "Độ đều đặn:"

#: imageeffect_restoration.cpp:162
msgid ""
"<p>This value controls the smoothing regularity of the target image. Do not "
"use an high value here, or the target image will be completely blurred."
msgstr ""
"<p>Giá trị này điều khiển độ đều đặn làm mịn của ảnh đích. Đừng dùng giá trị "
"cao ở đây: nó sẽ che mờ hoàn toàn ảnh đích."

#: imageeffect_restoration.cpp:168
msgid "Iterations:"
msgstr "Lần lặp lại:"

#: imageeffect_restoration.cpp:172
msgid "<p>Sets the number of times the filter is applied on the target image."
msgstr "<p>Đặt số lần bộ lọc này được áp dụng cho ảnh đích."

#: imageeffect_restoration.cpp:180
msgid "Advanced Settings"
msgstr "Thiết lập cấp cao"

#: imageeffect_restoration.cpp:182
msgid "Angular step:"
msgstr "Bước góc:"

#: imageeffect_restoration.cpp:186
msgid ""
"<p>Set here the angular integration step in degrees in analogy to anisotropy."
msgstr ""
"<p>Ở đây hãy đặt bước tích phân góc theo độ tương tự với tính dị hướng."

#: imageeffect_restoration.cpp:190
msgid "Integral step:"
msgstr "Bước tích phân:"

#: imageeffect_restoration.cpp:194
msgid "<p>Set here the spatial integral step. Stay below 1."
msgstr "<p>Ở đây hãy đặt bước tích phân không gian (chỉ dưới 1)."

#: imageeffect_restoration.cpp:198
msgid "Gaussian:"
msgstr "Gaussian:"

#: imageeffect_restoration.cpp:202
msgid "<p>Set here the precision of the Gaussian function."
msgstr "<p>Ở đây hãy đặt độ chính xác của hàm kiểu Gauss."

#: imageeffect_restoration.cpp:206
msgid "Use linear interpolation"
msgstr "Dùng khả năng nội suy tuyến"

#: imageeffect_restoration.cpp:207
msgid "<p>Enable this option to quench the last bit of quality (slow)."
msgstr "<p>Bật tùy chọn này để làm hết ít chất lượng cuối cùng (chạy chậm)."

#: imageeffect_restoration.cpp:210
msgid "Normalize photograph"
msgstr "Tiêu chuẩn hoá ảnh chụp"

#: imageeffect_restoration.cpp:211
msgid "<p>Enable this option to process an output image normalization."
msgstr "p>Bật tùy chọn này để xử lý hàm tiêu chuẩn hoá ảnh xuất."

#: imageeffect_restoration.cpp:399
msgid "Restoration"
msgstr "Phục hồi lại"

#: imageeffect_restoration.cpp:407
msgid "Photograph Restoration Settings File to Load"
msgstr "Tập tin thiết lập phục hồi lại ảnh chụp cần tải"

#: imageeffect_restoration.cpp:419
msgid "\"%1\" is not a Photograph Restoration settings text file."
msgstr ""
"« %1 » không phải là một tập tin văn bản thiết lập phục hồi lại ảnh chụp."

#: imageeffect_restoration.cpp:441
msgid "Cannot load settings from the Photograph Restoration text file."
msgstr "Không thể tải thiết lập từ tập tin văn bản phục hồi lại ảnh chụp."

#: imageeffect_restoration.cpp:450
msgid "Photograph Restoration Settings File to Save"
msgstr "Tập tin thiết lập phục hồi lại ảnh chụp cần lưu"

#: imageeffect_restoration.cpp:472
msgid "Cannot save settings to the Photograph Restoration text file."
msgstr "Không thể lưu thiết lập vào tập tin văn bản phục hồi lại ảnh chụp."

#: imageplugin_restoration.cpp:42
msgid "Restoration..."
msgstr "Phục hồi lại..."

