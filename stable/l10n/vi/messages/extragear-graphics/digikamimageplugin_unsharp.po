#: imageeffect_unsharp.cpp:57 imageeffect_unsharp.cpp:197
#: imageplugin_unsharp.cpp:63
msgid "Unsharp Mask"
msgstr "Bỏ sắc mặt nạ"

#: imageeffect_unsharp.cpp:59
msgid "An unsharp mask image filter plugin for digiKam."
msgstr "Bổ sung ảnh bỏ sắc mặt nạ cho digiKam."

#: imageeffect_unsharp.cpp:65
msgid "Author and maintainer"
msgstr "Tác giả và nhà duy trì"

#: imageeffect_unsharp.cpp:75
msgid "Radius:"
msgstr "Bán kính:"

#: imageeffect_unsharp.cpp:80
#, fuzzy
msgid ""
"<p>Radius value is the gaussian blur matrix radius value used to determines how "
"much to blur the image."
msgstr ""
"<p>Giá trị bán kính 0 không có tác động; giá trị 10 và lớn hơn quyết định bán "
"kính ma trận che mờ mà quyết định bao nhiều cần che mờ ảnh."

#: imageeffect_unsharp.cpp:87
msgid "Amount:"
msgstr "Số lượng:"

#: imageeffect_unsharp.cpp:93
msgid ""
"<p>The value of the difference between the original and the blur image that is "
"added back into the original."
msgstr ""
"<p>Giá trị này là hiệu giữa ảnh gốc và ảnh che mờ, mà được thêm về ảnh gốc."

#: imageeffect_unsharp.cpp:100
msgid "Threshold:"
msgstr "Ngưỡng:"

#: imageeffect_unsharp.cpp:106
msgid ""
"<p>The threshold, as a fraction of the maximum luminosity value, needed to "
"apply the difference amount."
msgstr ""
"<p>Ngưỡng này là phân số của giá trị độ trưng tối đa cần thiết để áp dụng số "
"lượng hiệu."

#: imageplugin_unsharp.cpp:43
msgid "Unsharp Mask..."
msgstr "Bỏ sắc mặt nạ..."

