#: drkonqi/presets/enduserrc:241
msgid ""
"Name=You might want to send a bug report for this application. Check if it is "
"listed on http://bugs.kde.org, otherwise mail the author. Please include as "
"much information as possible, maybe the original documents. If you have a way "
"to reproduce the error, include this also."
msgstr ""
"Name=Bạn có thể gửi thư điện tử báo lỗi tới tác giả. Trước khi báo lỗi, kiểm "
"tra xem lỗi đã được liệt kê trên http://bugs.kde.org chưa. Xin kèm theo càng "
"nhiều thông tin càng tốt. Nếu bạn có cách để tái hiện lại lỗi, xin gửi kèm theo "
"luôn."

#: drkonqi/presets/enduserrc:306
msgid ""
"Comment=An application mostly receives the SIGILL signal due to a bug in the "
"application. The application was asked to save its documents."
msgstr ""
"Comment=Một chương trình thường nhận các tín hiệu SIGILL vì có lỗi trong nó. "
"Chương trình này đã được yêu cầu lưu tài liệu."

#: drkonqi/presets/enduserrc:383
msgid ""
"Comment=An application terminates with a SIGABRT signal when it detects an "
"internal inconsistency caused by a bug in the program."
msgstr ""
"Comment=Một chương trình bị dừng bởi một tín hiệu SIGABRT khi nó tìm ra một mâu "
"thuẫn nội bộ gây ra bởi lỗi nào đó."

#: drkonqi/presets/enduserrc:458
msgid ""
"Comment=An application mostly receives the SIGFPE signal due to a bug in the "
"application. The application was asked to save its documents."
msgstr ""
"Comment=Một chương trình thường nhận các tín hiệu SIGFPE vì trong nó có lỗi. "
"Chương trình đã được yêu cầu lưu tài liệu."

#: drkonqi/presets/enduserrc:535
msgid ""
"Comment=An application mostly receives the SIGSEGV signal due to a bug in the "
"application. The application was asked to save its documents."
msgstr ""
"Comment=Một chương trình thường nhận các tìn hiệu SIGSEGV vì trong nó có lỗi. "
"Chương trình đã được yêu cầu lưu tài liệu."

#: drkonqi/presets/enduserrc:689
msgid "Comment=Sorry, I do not know this signal."
msgstr "Comment=Xin lỗi, không hiểu tín hiệu này."

