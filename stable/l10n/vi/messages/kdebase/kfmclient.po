#: kfmclient.cc:52
msgid "kfmclient"
msgstr ""

#: kfmclient.cc:54
msgid "KDE tool for opening URLs from the command line"
msgstr "Công cụ KDE để mở các URL từ dòng lệnh"

#: kfmclient.cc:64
msgid "Non interactive use: no message boxes"
msgstr ""

#: kfmclient.cc:65
#, fuzzy
msgid "Show available commands"
msgstr "Hiển thị các lệnh dùng được ."

#: kfmclient.cc:66
#, fuzzy
msgid "Command (see --commands)"
msgstr "Lệnh ( xem --commands)."

#: kfmclient.cc:67
