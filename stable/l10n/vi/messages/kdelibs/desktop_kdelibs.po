msgstr "Name=Bộ cầm phít Nhập xong Từ KTextEditor"

#: kate/plugins/wordcompletion/ktexteditor_docwordcompletion.desktop:59
msgid ""
"Comment=Directional or popup-based completion from words in the document"
msgstr ""
"Comment=Khả năng nhập xong từ trong tài liệu, đựa vào chiều hoặc vào bộ bật "
"lên."

