#: legacyimport.cpp:55
#, fuzzy
msgid ""
"<QT><b>Legacy Theme Importer</b>"
"<P>A gtkrc file was not found in the specified folder. If it exists "
"somewhere other than where the pixmaps are located enter it here.</QT>"
msgstr ""
"<QT><b>Trình nhập theme kế thừa </b>"
"<P>"
"File gtkrc không đượctìm thấy trong thư mục đã chỉ định . "
"Nếu nó tồn tại ở đâu đó khác nơi  mà có các file pixmap, "
"bạn hãy nhập nó vào đâỵ </QT>"

