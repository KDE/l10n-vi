#: plugin_kateinsertcommand.cpp:281
msgid "Insert Command"
msgstr "Chèn lệnh"

#: plugin_kateinsertcommand.cpp:288
#, fuzzy
msgid "Enter &command:"
msgstr "Nhập &lệnh"

#: plugin_kateinsertcommand.cpp:300
#, fuzzy
msgid "Choose &working folder:"
msgstr "Chọn thư mục làm &việc"

#: plugin_kateinsertcommand.cpp:310
msgid "Insert Std&Err messages"
msgstr "Nhập thông điệp Std&Err"

#: plugin_kateinsertcommand.cpp:313
#, fuzzy
msgid "&Print command name"
msgstr "&In tên lệnh"

#: plugin_kateinsertcommand.cpp:318
#, fuzzy
msgid ""
"Enter the shell command, the output of which you want inserted into your "
"document. Feel free to use a pipe or two if you wish."
msgstr ""
"Nhập lệnh hệ vỏ, xuất mà bạn muốn được chèn vào tài "
"liệu. Có thể dùng đường ống nếu bạn muốn ;)"

#: plugin_kateinsertcommand.cpp:321
#, fuzzy
msgid ""
"Sets the working folder of the command. The command executed is 'cd <dir>"
" && <command>'"
msgstr ""
"Đặt thư mục làm việc của lệnh. Lệnh sẽ thực hiện là ' "
"cd <dir> && <command>'"

#: plugin_kateinsertcommand.cpp:324
#, fuzzy
msgid ""
"Check this if you want the error output from <command> inserted as well.\n"
"Some commands, such as locate, print everything to STDERR"
msgstr ""
"Kiểm tra  xem bạn có muốn xuất của lỗi từ lệnh <command> "
"được chèn vào cùng \n"
"Một số lệnh, như locate, xin mọi thứ vào STDERR"

#: plugin_kateinsertcommand.cpp:327
msgid ""
"If you check this, the command string will be printed followed by a newline "
"before the output."
msgstr ""
"Nếu bạn chọn cái này, chuỗi kí tự của lệnh sẽ đuợc in "
"sau một dòng mới của xuất."

#: plugin_kateinsertcommand.cpp:374
msgid "Remember"
msgstr "Nhớ"

#: plugin_kateinsertcommand.cpp:376
#, fuzzy
msgid "Co&mmands"
msgstr "&Lệnh"

#: plugin_kateinsertcommand.cpp:383
msgid "Start In"
msgstr "Bắt đầu từ"

#: plugin_kateinsertcommand.cpp:385
#, fuzzy
msgid "Application &working folder"
msgstr "Thư mục làm &việc của chương trình"

#: plugin_kateinsertcommand.cpp:386
#, fuzzy
msgid "&Document folder"
msgstr "Thư mục tài &liệu"

#: plugin_kateinsertcommand.cpp:387
#, fuzzy
msgid "&Latest used working folder"
msgstr "Thư mục làm việc &cuối đã được dùng"

#: plugin_kateinsertcommand.cpp:395
msgid ""
"Sets the number of commands to remember. The command history is saved over "
"sessions."
msgstr ""
"Đặt số các lệnh sẽ được nhớ. Lịch sử lệnh sẽ "
"được cất vào session"

#: plugin_kateinsertcommand.cpp:398
#, fuzzy
msgid ""
"<qt>"
"<p>Decides what is suggested as <em>working folder</em> for the "
"command.</p>"
"<p><strong>Application Working Folder (default):</strong> The folder from "
"which you launched the application hosting the plugin, usually your home "
"folder.</p>"
"<p><strong>Document Folder:</strong> The folder of the document. Used only "
"for local documents.</p>"
"<p><strong>Latest Working Folder:</strong> The folder used last time you "
"used this plugin.</p></qt>"
msgstr ""
"<qt>"
"<p>Decides what is suggested as <em>working directory</em> for the "
"command.</p>"
"<p><strong>Application Working Directory (default):</strong> The directory "
"from which you launched the application hosting the plugin, usually your "
"home directory.</p>"
"<p><strong>Document Directory:</strong> The directory of the document. Used "
"only for local documents."
"<p><strong>Latest Working Directory:</strong> The directory used last time "
"you used this plugin.</p></qt>"

