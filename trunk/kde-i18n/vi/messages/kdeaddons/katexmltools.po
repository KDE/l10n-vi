msgstr "Đóng thành phần"

#: plugin_katexmltools.cpp:163
msgid "Assign Meta DTD..."
msgstr "Chỉ định Meta DTD..."

#: plugin_katexmltools.cpp:212
msgid "Assign Meta DTD in XML format"
msgstr "Chỉ định Meta DTD trong định dạng XML"

#: plugin_katexmltools.cpp:233
msgid "The file '%1' could not be opened. The server returned an error."
msgstr "File '%1' không tồn tại. Server trả về lỗi."

#: plugin_katexmltools.cpp:235 plugin_katexmltools.cpp:258
msgid "XML Plugin Error"
msgstr "Lỗi Plugin XmL"

#: plugin_katexmltools.cpp:254
msgid ""
"The file '%1' could not be parsed. Please check that the file is a valid XML "
"file of this type:\n"
"-//Norman Walsh//DTD DTDParse V2.0//EN\n"
"You can produce such files with dtdparse."
msgstr ""
"Không thể parse file '%1'. Xin kiểm tra xem file có hợp lệ hay không:\n"
"-//Norman Walsh//DTD DTDParse V2.0//EN\n"
"Bạn có thể hoàn thành file với dtdparse"

#: plugin_katexmltools.cpp:269
msgid "Analyzing meta DTD..."
msgstr "Giải tích meta DTD"

#: plugin_katexmltools.cpp:342
msgid ""
"You need to assign a meta DTD to the current file before you can use the XML "
"plugin. Several common meta DTDs are part of the XML plugin. You can also "
"produce your own meta DTDs with a program called dtdparse. Do you want to "
"assign a meta DTD now?"
msgstr ""
"Bạn phải chỉ định meta DTD cho file hiện tại trước khi có thể dùng XML plugin. "
"Nhiều meta DTD thông thường là một phần của XML plugin. Bạn có thể sản xuất meta "
"DTD riêng của bạn bằng một chương trình tên là dtdparse. Bạn có muốn chỉ định meta "
"DTD bây giờ không?"

#: plugin_katexmltools.cpp:346
msgid "Assign Meta DTD"
msgstr "Chỉ định Meta DTD"

