#: backtrace.cpp:75
msgid ""
"%1 not found. Check if it is installed -- you need it to generate "
"backtraces.\n"
"If you have another debugger, contact kde-devel@kde.org for help on how to "
"set it up."
msgstr ""
"Không tìm thấy %1. Kiểm tra lại xem nó đãđuợc cài đặt "
"chưa-- Bạn cần phải sinh ra backtracẹ\n"
"Nếu bạn có các trình gỡ rối khác, liên hệ kde-devel@kdẹorg "
"để tìm trợ giúp."

#: toplevel.cpp:60
msgid "&Bug report"
msgstr "Báo cáo &lỗi"

#: toplevel.cpp:61
