#: DirSettingsWidgetData.cpp:128 rc.cpp:16
msgid ""
"This is the folder containing XFree86 encoding files. These files (which "
"usually have the suffix .enc or .enc.gz) are used to enable X to have access "
"to more encoding shemes (such as cp1252).\n"
"\n"
"This folder is normally a sub-folder of the system X11 fonts folder - and is "
"usually named 'Encodings' or 'encodings'. As an example, on SuSE Linux 7.1 - "
"the folder is:\n"
"\n"
"    /usr/X11R6/lib/X11/fonts/encodings/"
msgstr ""
"DDa^y se~ la` ca'c thu+ mu.c chu+'a encoding file cu?a XFree86. Nhu+~ng file"
"na`y( thu+o+` ng co' dduo^i la` .enc hay .enc.gz) se~ ddu+o+.c du` ng"
"dde^? cho phe'p X truy ca^.p nhie^`u encoding schemes kha'c nhau"
"(nhu+ la` cp1252).\n"
"\n"
"Thu+ mu.c na`y tho^ng thu+o+`ng la` mo^.t thu+ mu.c con cu?a thu+ mu.c font"
"he^. tho^ 'ng X11 - va` thu+ o+`ng co' te^n la` 'Encodings' hay 'encodings'. Vi'"
"du. trong Suse7.1, no' la`: \n"
"\n"
