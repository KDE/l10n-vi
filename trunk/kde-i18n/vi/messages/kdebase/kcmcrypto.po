#: crypto.cpp:223
#, fuzzy
msgid ""
"<h1>Crypto</h1> This module allows you to configure SSL for use with most "
"KDE applications, as well as manage your personal certificates and the known "
"certificate authorities."
msgstr ""
"<h1>Mã hoá</h1> Module này cho phép bạn cấu hình SSL để dùng "
"vớihầu hết các chương trình KDE cũng như quản lí các giấy "
"phépcá nhân và các certificate authority đã biết ."

#: crypto.cpp:236
msgid "kcmcrypto"
msgstr "kcmcrypto"

