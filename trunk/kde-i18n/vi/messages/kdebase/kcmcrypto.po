#: crypto.cpp:103
msgid "%1 (%2 of %3 bits)"
msgstr "%1 (%2 of %3 bits)"

#: crypto.cpp:252
msgid "Enable &TLS support if supported by the server."
msgstr "Cho phép hỗ trợ &TLS nếu nó được hỗ trợ bởi server ."

#: crypto.cpp:255
msgid ""
"TLS is the newest revision of the SSL protocol. It integrates better with "
"other protocols and has replaced SSL in protocols such as POP3 and SMTP."
msgstr ""
"TLS là phiên bản mới nhất của giao thức SSL . Nó tích "
"hợptốt hơn với khác giao thức khác và đã thay thế SLL trong "
"các giao thức như POP3 và SMTP ."

#: crypto.cpp:260
msgid "Enable SSLv&2"
msgstr "Cho phép dùng SSLv&2"

#: crypto.cpp:263
msgid ""
"SSL v2 is the second revision of the SSL protocol. It is most common to "
"enable v2 and v3."
msgstr ""
"SSL v2 là phiên bản thứ hai của giao thức SSL . Nó là cái "
"thông  dụng nhấtđể enable v2 và v3 ."

#: crypto.cpp:267
msgid "Enable SSLv&3"
msgstr "Cho phép dùng SSLv&3"

#: crypto.cpp:270
msgid ""
"SSL v3 is the third revision of the SSL protocol. It is most common to "
"enable v2 and v3."
msgstr ""
"SSL v3 là phiên bản thứ hai của giao thức SSL . Nó là cái  "
"thông dụngnhất để enable v2 và v3 ."

#: crypto.cpp:276
msgid "SSLv2 Ciphers To Use:"
msgstr "SSLv2 cipher sẽ dùng:"

#: crypto.cpp:277
msgid ""
"Select the ciphers you wish to enable when using the SSL v2 protocol. The "
"actual protocol used will be negotiated with the server at connection time."
msgstr ""
"Chọn mật mã (cipher ) mà bạn muốn cho phép khi dùng giao thức "
"SSL v2 .Giao thức thật sự được dùng sẽ bị điều chỉnh "
"vào thờigian nối vào máy chủ ."

#: crypto.cpp:287
msgid ""
"SSL ciphers cannot be configured because this module was not linked with "
"OpenSSL."
msgstr ""
"Mã hoá SSL không thể bị cấu hình bởi vì module này không "
"liênkết với OpenSSL ."

#: crypto.cpp:302
msgid "SSLv3 Ciphers To Use:"
msgstr "Mã hoá (cipher) SSLv3 sẽ dùng:"

#: crypto.cpp:303
msgid ""
"Select the ciphers you wish to enable when using the SSL v3 protocol. The "
"actual protocol used will be negotiated with the server at connection time."
msgstr ""
"Chọn mã hoá (cihper) mà bạn muốn cho phép khi  dùng giao thức "
"SSL v3 .Giao thức thực sự dùng sẽ bị thay thế vào thời "
"điểm nối với máychủ ."

#: crypto.cpp:317
msgid "Cipher Wizards..."
msgstr "Wizards Mã hoá(cipher)..."

#: crypto.cpp:318
msgid "&Most Compatible"
msgstr "Tưon+g thích &nhất"

#: crypto.cpp:319
msgid "&US Ciphers Only"
msgstr "Chỉ dùng Mã hoá &US"

#: crypto.cpp:320
msgid "E&xport Ciphers Only"
msgstr "Chỉ dùng mã hoá &xuất"

#: crypto.cpp:321
msgid "E&nable All"
msgstr "&Dùng tất cả"

#: crypto.cpp:327
msgid "Use these buttons to more easily configure the SSL encryption settings."
msgstr ""
"Dùng các nút này để cấu hình các thiết lập mã hoá tốt "
"hơn . "

#: crypto.cpp:329
msgid "Select the settings found to be most compatible."
msgstr "Chọn các thiết lập được coi là tương thích nhất ."

#: crypto.cpp:331
msgid "Select only the US strong (>= 128 bit) encryption ciphers."
msgstr "Chỉ chọn các cipher mã hoá US mạnh (>=128 bit) ."

#: crypto.cpp:333
msgid "Select only the weak ciphers (<= 56 bit)."
msgstr "Chọn các mã hoá yếu ( <=56 bits) ."

#: crypto.cpp:335
msgid "Select all SSL ciphers and methods."
msgstr "Chọn mọi mã hoá và phương thức của SSL ."

#: crypto.cpp:344
msgid "Use EGD"
msgstr "Dùng EGD"

#: crypto.cpp:346
msgid "Use Entropy File"
msgstr "Dùng file entropy"

#: crypto.cpp:354 crypto.cpp:2222
