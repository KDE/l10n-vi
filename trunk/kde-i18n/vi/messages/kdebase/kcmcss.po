#: kcmcss.cpp:231
#, fuzzy
msgid ""
"<h1>Konqueror Stylesheets</h1> This module allows you to apply your own "
"color and font settings to Konqueror by using stylesheets (CSS). You can "
"either specify options or apply your own self-written stylesheet by pointing "
"to its location."
"<br> Note that these settings will always have precedence before all other "
"settings made by the site author. This can be useful to visually impaired "
"people or for web pages that are unreadable due to bad design."
msgstr ""
"Module này cho phép bạn áp dụng các thiết lập màu và fontcho "
"konqueror bằng cách dùng stylesheet( CSS) . Bạn có thể chỉ "
"địnhcác tuỳ chọn hay áp dụng CSS do bạn tự viết bằng "
"cách chỉ đến vị trí củanó . "
"<br>Chú ý là các thiết lập này luôn luôn được thực hiện "
"sau cácthiết lập của tác giả site . Cài này sẽ rất hũư "
"dụng cho những ngườitàn tật hay khó đọc các trang web có "
"thiết kế xấu ."

#: rc.cpp:1 rc.cpp:2
msgid ""
"<b>Stylesheets</b>"
"<p>See http://www.w3.org/Style/CSS for further information on cascading "
"style sheets.</p>"
msgstr ""
"<b>Stylesheets</b>"
"<p>Xem thêm thông tin ở http://www.w3.org/Style/CSS </p>"

#: rc.cpp:3
msgid "&General"
msgstr "&Chung"

#: rc.cpp:4
msgid "Stylesheets"
msgstr "Stylesheets"

#: rc.cpp:5
msgid ""
"<b>Stylesheets</b>"
"<p>Use this groupbox to determine how Konqueror will render style sheets.</p>"
msgstr ""
"<b>Stylesheets</b>"
"<p>Dùng  groupbox này để xác định KDE sẽ đốixử với các "
"stylesheet ra sao .</p>"

#: rc.cpp:6
msgid "Use &user-defined stylesheet"
msgstr "Dùng style sheet do &người dùng định nghĩa "

#: rc.cpp:7
#, fuzzy
msgid ""
"<b>Use user-defined stylesheet</b>"
"<p>If this box is checked, Konqueror will try to load a user-defined style "
"sheet as specified in the location below. The style sheet allows you to "
"completely override the way web pages are rendered in your browser. The file "
"specified should contain a valid style sheet (see "
"http://www.w3.org/Style/CSS for further information on cascading style "
"sheets).</p>"
msgstr ""
"<b>Dùng style sheet do người dùng định nghĩa</b>"
"<p> Nếu box này được chọn,konqueror sẽ cố gắng tải style "
"sheet do người dùng định nghĩatrong các vị trí ở dưới đây "
".Style sheet cho phép bạn hoàn toàn vượt qua cách mà trang web "
"trao cho bạntrong trình duyệt web . File được chỉ định cần "
"phải chứa style sheetđúng ( xem http://www.w3.org/Style/CSS  để "
"biết thêm chi tiết) </p>"

#: rc.cpp:8
#, fuzzy
msgid "U&se accessibility stylesheet defined in \"Customize\"-tab"
msgstr ""
"Dùng &accessiblity style sheet  đã định nghĩa trong  tab \"Tuỳ "
"biến\""

#: rc.cpp:9
#, fuzzy
msgid ""
"<b>Use accessibility stylesheet defined in "
"&quot;Customize&quot;-tab</b>"
"<p>"
"Selecting this option will allow you to define a default font, font size, "
"and font color with a few simple clicks of the mouse. Simply wander over to "
"the Customize tab and pick out your desired options.</p>"
msgstr ""
"<b>Dùng accessiblity stylesheet định nghĩa trong "
"&quot;Customize&quot;-tab</b>"
"<p>Chọn tuỳ chọn này sẽ cho phép bạn định nghĩa font, cỡ "
"font mặc định mới vài cú nhấp chuột  đơn giản. Chỉ cần "
"lang thang trong tab Tuỳ Biến và nhặt các tuỳ chọn bạn thích "
".</p>"

#: rc.cpp:10
#, fuzzy
msgid "Us&e default stylesheet"
msgstr "Dùng style sheet &mặc định"

#: rc.cpp:11
msgid ""
"<b>Use default stylesheet</b>"
"<p>Select this option to use the default stylesheet.</p>"
msgstr ""
"<b>Dùng style sheet mặc định</b>"
"<p>Chọn tuỳ chọn này để dùng style sheet mặc định </p>"

