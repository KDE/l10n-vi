#: rc.cpp:21 rc.cpp:23
msgid ""
"<b>Foreground color</b>"
"<p>The foreground color is the color that the text is drawn in.</p>"
msgstr ""
"<b>Màu cận cảnh</b>"
"<p>Màu cận cảnh là màu mà text sẽ được vẽ lên .</p>"

#: rc.cpp:22
msgid "&Foreground:"
msgstr "&Cận cảnh:"

#: rc.cpp:25
msgid ""
"<b>Background</b>"
"<p>Behind this door lays the ability to choose a custom default "
"background.</p>"
msgstr ""
"<b> Nền </b>"
"<p>Trong cánh cửa này là khả năng tuỳ biến nền mặc định "
"</p>"

#: rc.cpp:26
#, fuzzy
msgid "Bac&kground:"
msgstr "&Nền:"

#: rc.cpp:27
msgid ""
"<b>Background</b>"
"<p>This background color is the one displayed behind the text by default. A "
"background image will override this.</p>"
msgstr ""
"<b>Nền</b> "
"<p> Màu nền là màu được hiển thị phía sau text . Một "
"hìnhnền có thể ghi đè lên nó . </p>"

#: rc.cpp:28
msgid "Use same color for all text"
msgstr "Dùng chung màu cho mọi text"

#: rc.cpp:29
msgid ""
"<b>Use same color for all text</b>"
"<p>"
"Select this option to apply your chosen color to the default font as well as "
"any custom fonts as specified in a stylesheet.</p>"
msgstr ""
"<b>Dùng chung màu cho mọi text </b>"
"<p>Chọn tuỳ chọn này đểáp dụng màu đã chọn cho font mặc "
"định cũng như bất kì font tuỳ biến nàođã được chỉ "
"định trong style sheet . </p>"

