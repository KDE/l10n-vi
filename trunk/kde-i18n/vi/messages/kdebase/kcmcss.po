#: rc.cpp:33
msgid ""
"<b>Suppress images</b>"
"<p>Selecting this will prevent Konqueror from loading images.</p>"
msgstr ""
"<b>Khử ảnh</b>"
"<p>Chọn cái này sẽ là mcho Konqueror không tảivào các ảnh </p>"

#: rc.cpp:34
msgid "Suppress background images"
msgstr "Không tải ảnh nền"

#: rc.cpp:35
msgid ""
"<b>Suppress background images</b>"
"<p>Selecting this option will prevent Konqueror from loading background "
"images.</p>"
msgstr ""
"<b>Khử ảnh nền </b>"
"<p>Chọn tuỳ chọn này để ngăn cản Konqueror không tải "
"ảnhnền . </p>"

#: rc.cpp:36
#, fuzzy
