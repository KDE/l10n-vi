#: dtime.cpp:62
msgid "Here you can change the system date's month."
msgstr "Bạn có thể thay đổi tháng của hệ thống tại đây ."

#: dtime.cpp:68
msgid "Here you can change the system date's year."
msgstr "Bạn có thể thay đổi năm của hệ thống tại đây ."

#: dtime.cpp:72
msgid "Here you can change the system date's day of the month."
msgstr "Bạn có thể thay đổi ngày của hệ thống tại đây ."

#: dtime.cpp:136
msgid ""
"Here you can change the system time. Click into the hours, minutes or "
"seconds field to change the relevant value, either using the up and down "
"buttons to the right or by entering a new value."
msgstr ""
"Bạn có thể thay đổi thời gian của hệ thống . Nhấn vào "
"giờ,phút, giây và thay đổi các giá trị tương ứng, hoặc "
"cũng có thể dùngcác mũi tên lên xuống và trái phải hay nhập "
"trực tiếp các giá trị ."

