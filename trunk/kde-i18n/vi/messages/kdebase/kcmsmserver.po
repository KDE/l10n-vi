#: kcmsmserver.cpp:132
#, fuzzy
msgid ""
"<h1>Session Manager</h1> You can configure the session manager here. This "
"includes options such as whether or not the session exit (logout) should be "
"confirmed, whether the session should be restored again when logging in and "
"whether the computer should be automatically shut down after session exit by "
"default."
msgstr ""
"<h1>Trình quản lí session</h1>Bạn có thể cấu hình trình quản "
"lí session ở đây. Nó bao gốm các tuỳ chọn như là session "
"thoát hay không thoát  (logout)khi được xác nhận và  session "
"trước có được bảo tồnkhông khi bạn thoát ra ngoài."

#: rc.cpp:1
msgid "Session Manager"
msgstr "Trình quản lí session"

#: rc.cpp:2
msgid "General"
msgstr "Chung"

#: rc.cpp:3
msgid "Conf&irm logout"
msgstr "Xác nhận &thoát ra ngoải"

#: rc.cpp:4
msgid ""
"Check this option if you want the session manager to display a logout "
"confirmation dialog box."
msgstr ""
"Nhận tuỳ chọn này nếu bạn muốn trình quản lí session "
"hiểnthì hộp thoại xác nhận thoát ra ngoái"

#: rc.cpp:5
msgid "On Login"
msgstr ""

#: rc.cpp:6
msgid ""
"<ul>\n"
"<li><b>Restore previous session:</b> Will save all applications running on "
"exit and restore them when they next start up</li>\n"
"<li><b>Restore manually saved session: </b> Allows the session to be saved "
"at any time via \"Save Session\" in the K-Menu. This means the currently "
"started applications will reappear when they next start up.</li>\n"
"<li><b>Start with an empty session:</b> Don't save anything. Will come up "
"with an empty desktop on next start.</li>\n"
"</ul>"
msgstr ""

#: rc.cpp:7
msgid "Restore &previous session"
msgstr ""

#: rc.cpp:8
msgid "Restore &manually saved session"
msgstr ""

#: rc.cpp:9
msgid "Start with an &empty session"
msgstr ""

#: rc.cpp:10
#, fuzzy
msgid "Default Action After Logout"
msgstr "Hành động mặc định sau khi thoát ra"

#: rc.cpp:11
msgid ""
"Here you can choose what should happen by default when you log out. This "
"only has meaning, if you logged in through KDM."
msgstr ""
"Bạn có thể chọn điều gì sẽ xảy ra mặc định khi thoát "
"ra. Điều này chỉ có ý nghĩa nếu bạn thoát ra từ KDM."

#: rc.cpp:12
msgid "&Login as different user"
msgstr "Đăn&g nhập dưới một user khác"

#: rc.cpp:13
msgid "&Turn off computer"
msgstr "&Tắt máy"

#: rc.cpp:14
msgid "&Restart computer"
msgstr "&Khởi động lại máy"

#: rc.cpp:15
msgid "Advanced"
msgstr ""

#: rc.cpp:16
msgid "Applications to be excluded from sessions:"
msgstr ""

#: rc.cpp:17
msgid ""
"Here you can enter a colon-separated list of applications that should not be "
"saved in sessions, and therefore won't be started when restoring a session. "
"For example 'xterm:xconsole'.\n"
msgstr ""

