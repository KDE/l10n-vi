#: aboutwidget.cpp:40 main.cpp:91
msgid "KDE Control Center"
msgstr "Trung tâm điều khiển KDE"

#: aboutwidget.cpp:42
msgid "Configure your desktop environment."
msgstr "Cấu hình môi trường kdesktop của bạn"

#: aboutwidget.cpp:44
msgid ""
"Welcome to the \"KDE Control Center\", a central place to configure your "
"desktop environment. Select an item from the index on the left to load a "
"configuration module."
msgstr ""
"Chào mừng bạn đến với \"Trung tâm điều khiển KDE\", "
"mộtnơi trung tâm để cấu hình môi trường desktop của bạn . "
"Chọn mộthạng mục từ mục lục ở bên trái để tải module "
"cấu hình ."

#: aboutwidget.cpp:50
msgid ""
"Click on the \"<b>Help</b>\" tab on the left to view help for the active "
"control module. Use the \"<b>Search</b>\" tab if you are unsure where to "
"look for a particular configuration option."
msgstr ""
"Nhấn vào tab \"<b>Trợ giúp</b>\" ở bên trái để xem trợ giúp "
"về moduleđiều khiển đang được kích hoạt . Dùng tab \"<b>"
"Tìm kiếm</b>\"nếu bạn không hiểu rõ  việc tìm tuỳ chọn "
"cấu hình cụ thểnào đó"

