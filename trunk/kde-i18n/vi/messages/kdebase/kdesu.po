#: kdesu.cpp:55
msgid "Do not keep password."
msgstr "Kho^ng giu+~ ma^.t kha^?u ."

#: kdesu.cpp:56
msgid "Stop the daemon (forgets all passwords)."
msgstr "Du+`ng daemon ( que^n mo.i ma^.t kha^?u) ."

#: kdesu.cpp:57
msgid "Enable terminal output (no password keeping)."
msgstr "Cho phe'p xua^'t ra dda^`u cuo^'i ( kho^ng giu+~ ma^.t kha^?u)."

#: kdesu.cpp:58
msgid "Set priority value: 0 <= prio <= 100, 0 is lowest."
msgstr "DDa(.t ddo^. u+u tie^n : 0 <= prio <= 100, 0 la` nho? nha^'t ."

#: kdesu.cpp:59
msgid "Use realtime scheduling."
msgstr "Du`ng ke^' hoa.ch tho+`i gian thu+.c ."

#: kdesu.cpp:60
msgid "Let command use existing dcopserver."
msgstr "Cho le^.nh du`ng dcop server dda~ to^`n ta.i ."

#: kdesu.cpp:81
