#: kdesu.cpp:51 kdesu.cpp:52
msgid "Specifies the command to run."
msgstr "Chỉ định lệnh sẽ chạy ."

#: kdesu.cpp:53
msgid "Run command under target uid if <file> is not writeable."
msgstr "Chạy lệnh dưới uid đích nều <file> không viết được ."

#: kdesu.cpp:54
msgid "Specifies the target uid"
msgstr "Chỉ định uid đích"

#: kdesu.cpp:55
msgid "Do not keep password."
msgstr "Không giữ mật khẩu ."

#: kdesu.cpp:56
msgid "Stop the daemon (forgets all passwords)."
msgstr "Dừng daemon ( quên mọi mật khẩu) ."

#: kdesu.cpp:57
msgid "Enable terminal output (no password keeping)."
msgstr "Cho phép xuất ra đầu cuối ( không giữ mật khẩu)."

#: kdesu.cpp:58
msgid "Set priority value: 0 <= prio <= 100, 0 is lowest."
msgstr "Đặt độ ưu tiên : 0 <= prio <= 100, 0 là nhỏ nhất ."

#: kdesu.cpp:59
msgid "Use realtime scheduling."
msgstr "Dùng kế hoạch thời gian thực ."

#: kdesu.cpp:60
msgid "Let command use existing dcopserver."
msgstr "Cho lệnh dùng dcop server đã tồn tại ."

#: kdesu.cpp:81
msgid "KDE su"
msgstr "KDE su"

#: kdesu.cpp:82
msgid "Runs a program with elevated privileges."
msgstr "Chạy chương trình với quyền ưu tiên cao hơn ."

#: kdesu.cpp:85
msgid "Maintainer"
msgstr "Người bảo trì"

#: kdesu.cpp:87
msgid "Original author"
msgstr "Tác giả gốc"

#: kdesu.cpp:156
#, c-format
msgid "Illegal priority: %1"
msgstr "Mức độ ưu tiên không hợp lệ : %1"

#: kdesu.cpp:181
msgid "No command specified!"
msgstr "Không có lệnh được chỉ định !"

#: kdesu.cpp:261
msgid ""
"Su returned with an error!\n"
msgstr ""
"Sư trả lại lỗi !\n"

#: kdesu.cpp:276
msgid "Command:"
msgstr "Lệnh :"

#: kdesu.cpp:281
msgid "realtime: "
msgstr "thời gian thực :"

#: kdesu.cpp:283
msgid "Priority:"
msgstr "Mức độ ưu tiên :"

#: sudlg.cpp:21
#, c-format
msgid "Run as %1"
msgstr "Chạy dưới %1"

#: sudlg.cpp:25
msgid ""
"The action you requested needs root privileges. Please enter root's password "
"below or click Ignore to continue with your current privileges."
msgstr ""
"Hành động bạn yêu cầu cần mật khẩu root . Xin nhập "
"mậtkhẩu root dưới đây hoặc nhấn bỏ qua để tiếp "
"tụcvới quyền hiện tại ."

#: sudlg.cpp:29
msgid ""
"The action you requested needs additional privileges. Please enter the "
"password for \"%1\" below or click Ignore to continue with your current "
"privileges."
msgstr ""
"Hành động bạn yêu cầu đòi hỏi mức độ quyền phụ .xin "
"nhập mật khẩu cho \"%1\" vào đây hay nhân bỏ qua để "
"tiếptục với quyền hiện tại ."

#: sudlg.cpp:34
msgid "&Ignore"
msgstr "&Bỏ qua"

#: sudlg.cpp:50
msgid "Conversation with su failed."
msgstr "Giao tiếp với su thất bại ."

#: sudlg.cpp:59
msgid ""
"The program 'su' is not found!\n"
"Make sure your PATH is set correctly."
msgstr ""
"Chương trình 'sú không được tìm thấy !\n"
"Kiểm tra lại đường dẫn"

#: sudlg.cpp:66
msgid ""
"You are not allowed to use 'su'!\n"
"On some systems, you need to be in a special group (often: wheel) to use "
"this program."
msgstr ""
"Bạn không được phép dùng 'sú! \n"
"Trong một vài hệ thống, bạn cần nằm trong một nhóm đặc "
"biệt (thường là wheel) để có thể dùng chương trình này ."

#: sudlg.cpp:73
msgid "Incorrect password! Please try again."
msgstr "Mật khẩu sai ! Xin thử lại ."

#: sudlg.cpp:77
msgid "Internal error: Illegal return from SuProcess::checkInstall()"
msgstr ""
"Lỗi nội bộ : Giá trị trả về không hợp lệ từ "
"SuProcess::checkInstall()"

