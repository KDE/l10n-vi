"Sorry, but %1 does not seem to be an image file.\n"
"Please use files with these extensions:\n"
"%2"
msgstr ""
"Xin lỗi, có vẻ như %1 không phải là file ảnh . \n"
"xin dùng file với các đuôi sau :\n"
"%2"

