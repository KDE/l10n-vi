msgid ""
"Syntax Error: Not enough arguments\n"
msgstr ""
"Lỗi cú pháp : Không đủ đối số \n"

#: kfmclient.cc:273
msgid ""
"Syntax Error: Too many arguments\n"
msgstr ""
"Lỗi cú pháp : Quá nhiều đối số \n"

#: kfmclient.cc:395
msgid ""
"Syntax Error: Unknown command '%1'\n"
msgstr ""
"Lỗi cú pháp: Lệnh không biết '%1'\n"
