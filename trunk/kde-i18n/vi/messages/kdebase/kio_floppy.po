#: kio_floppy.cpp:211
msgid ""
"drive %1.\n"
"The drive is still busy.\n"
"Wait until it has stopped working and then try again."
msgstr ""
"Ô? %1.\n"
"Ô? này đang bận .\n"
"Đợi cho đến khi nó dừng làm việc và thử lại"

#: kio_floppy.cpp:215 kio_floppy.cpp:1139
msgid ""
"\n"
"The disk in drive %1 is probably full."
msgstr ""
"\n"
"Đĩa trong ổ %1 có thể đầy ."

#: kio_floppy.cpp:225
#, c-format
msgid ""
"\n"
"There is probably no disk in the drive %1"
msgstr ""
"\n"
"Có thể là không có đĩa trong ổ %1"

#: kio_floppy.cpp:229
msgid ""
"\n"
"The drive %1 is not supported."
msgstr ""
"\n"
"Đĩa %1 không được hỗ trợ ."

#: kio_floppy.cpp:234
msgid ""
"\n"
"Make sure the floppy in drive %1 is a DOS formatted floppy disk \n"
"and that the permissions of the device file (e.g. /dev/fd0) are set "
"correctly (e.g. rwxrwxrwx)."
msgstr ""
"\n"
"Đảm bảo rằng ổ %1 là đĩa định dạng kiểu DOS \n"
"và phân quyền của các file thiết bị (ẹg /dev/fd0) "
"đượcđặt chính xác (ẹg rwxrwxrwx)."

#: kio_floppy.cpp:238
msgid ""
"\n"
"The disk in drive %1 is probably not a DOS formatted floppy disk."
msgstr ""
"\n"
"Đĩa trong ổ %1 có thể không phải là đĩa định dạng kiểu "
"DOS ."

#: kio_floppy.cpp:242
msgid ""
"\n"
"The disk in drive %1 is probably write-protected."
msgstr ""
"\n"
"Đĩa trong ổ %1 có thể là write - protected."

#: kio_floppy.cpp:286 kio_floppy.cpp:512 kio_floppy.cpp:606 kio_floppy.cpp:739
#: kio_floppy.cpp:816 kio_floppy.cpp:902 kio_floppy.cpp:982
#: kio_floppy.cpp:1093
msgid ""
"\n"
"Ensure that the mtools package is installed correctly on your system."
msgstr ""
"\n"
"Chắc chắn rằng gói mtools đã được cài đặt đúng trong hệ "
"thống của bạn ."

#: kio_floppy.cpp:559 kio_floppy.cpp:575 kio_floppy.cpp:581 kio_floppy.cpp:651
msgid "Don't know why, sorry."
msgstr "Không hiểu vì sao, xin lỗi ."
