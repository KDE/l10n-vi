#: imap4.cc:754
msgid "What do you want to store in this folder?"
msgstr "Ba.n co' muo^'n luu+ tru+~ va`o thu+ mu.c na`y ?"

#: imap4.cc:754
msgid "Create folder"
msgstr "Ta.o thu+ mu.c"

#: imap4.cc:755
msgid "&Messages"
msgstr "&Tho^ng ddie^.p"

#: imap4.cc:755
msgid "&Subfolders"
msgstr "Thu+ mu.c &con"

#: imap4.cc:1032 imap4.cc:1044
msgid "Changing the flags of message %1 failed."
msgstr "DDo^?i co+` cho tho^ng ddie^.p %1 tha^'t ba.i ."

#: imap4.cc:1133
msgid "Unable to close mailbox."
msgstr "Kho^ng the^? khoa' thu`ng thu+ ."

#: imap4.cc:1299
msgid ""
"Sorry, the server %1 supports neither IMAP4 nor IMAP4rev1.\n"
"It identified itself with: %2"
msgstr ""
"Xin lo^~i, ma'y chu? %1 kho^ng ho^~ tro+. ca? IMAP4 va` IMAP4 rev1 .\n"
"No' tu+. xa'c ddi.nh la` : %2"

#: imap4.cc:1310
msgid ""
"The server does not support TLS.\n"
"Disable this security feature to connect unencrypted."
msgstr ""
"Ma'y chu? kho^ng ho^~ tro+. TLS .\n"
"Bo? qua chu+'c na(ng ba?o ma^.t na`y dde^? no^'i kho^ng ma~ hoa' ."

#: imap4.cc:1335
msgid "Starting TLS failed."
msgstr "Kho+?i ddo^.ng TLS tha^'t ba.i ."

#: imap4.cc:1345
msgid "The authentication method %1 is not supported by the server."
msgstr "Phu+o+ng pha'p xa'c nha^.n %1 kho^ng ddu+o+.c ma'y chu? ho^~ tro+. ."

#: imap4.cc:1354
msgid "Username and password for your IMAP account:"
msgstr "Te^n ngu+o+`i du`ng va` ma^.t kha^?u cho ta`i khoa?n IMAP ."

#: imap4.cc:1363
msgid ""
"Sorry, in IMAP clear text login, only US-ASCII characters are possible. "
"Please use a different authentication method that your server supports or "
"try to get a different username."
msgstr ""
"Xin lo^~i, khi du`ng dda(ng nha^.p IMAP clear text, chi? ca'c ki' tu+. US - ASCII"
"la` co' the^? du`ng . Xin ba.n cho.n phu+o+ng pha'p xa'c nha^.n kha'c ma`"
"ma'y chu? ho^~ tro+. hay thu+? te^n ngu+o+`i du`ng kha'c ."

#: imap4.cc:1368
msgid ""
"Sorry, in IMAP clear text login, only US-ASCII characters are possible. "
"Please use a different authentication method that your server supports or "
"change your password."
msgstr ""
"Xin lo^~i, khi du`ng dda(ng nha^.p IMAP clear text, chi? ca'c ki' tu+. US - ASCII"
"la` co' the^? du`ng . Xin ba.n cho.n phu+o+ng pha'p xa'c nha^.n kha'c ma`"
"ma'y chu? ho^~ tro+. hay thu+? ma^.t kha^?u kha'c ."

#: imap4.cc:1373
#, c-format
msgid ""
"Could not login. Probably the password is wrong.\n"
"The server replied:\n"
"%1"
msgstr ""
"Kho^ng the^? dda(ng nha^.p . Co' the^? la` sai ma^.t kha^?u . \n"
"Ma'y chu? tra? lo+`i . \n"
"%1"

#: imap4.cc:1379
msgid ""
"Could not authenticate via %1.\n"
"The server replied:\n"
"%2"
msgstr ""
"Kho^ng the^? xa'c nha^.n qua %1 .\n"
"Ma'y chu? tra? lo+`i : \n"
"%2"

