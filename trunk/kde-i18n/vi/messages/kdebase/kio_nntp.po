#: nntp.cpp:154
#, c-format
msgid "Invalid special command %1"
msgstr "Le^.nh dda(.c bie^.t kho^ng ddu'ng %1"

#: nntp.cpp:362
#, c-format
msgid ""
"Could not extract first message number from server response:\n"
"%1"
msgstr ""
"Kho^ng the^? tri'ch ra ddu+o+.c so^' tho^ng ddie^.p dda^`u tie^n tu+` ho^`i"
"a^m cu?a server : \n"
"%1"

#: nntp.cpp:384
#, c-format
msgid ""
