#: pop3.cc:220
msgid "PASS <your password>"
msgstr "PASS <mật khẩu của bạn>"

#: pop3.cc:223
msgid "The server said: \"%1\""
msgstr "Server trả lời: \"%1\""

#: pop3.cc:245
msgid "The server terminated the connection."
msgstr "Server ngắt kết nối"

#: pop3.cc:247
msgid ""
"Invalid response from server:\n"
"\"%1\""
msgstr ""
"Hồi âm không hợp lệ từ server : \n"
"\"%1\""

#: pop3.cc:276
msgid ""
"Could not send to server.\n"
msgstr ""
"Không thể gửi tới server . \n"

#: pop3.cc:347 pop3.cc:543
msgid ""
"Could not login to %1.\n"
"\n"
msgstr ""
"Không thể đăng nhập vào %1 . \n"
"\n"

#: pop3.cc:350
msgid "The server terminated the connection immediately."
msgstr "Server cắt kết nối ngay lập tức ."

#: pop3.cc:351
msgid ""
"Server does not respond properly:\n"
"%1\n"
msgstr ""
"Server không trả lời  đúng : \n"
"%1 \n"

#: pop3.cc:376
msgid ""
"Your POP3 server does not support APOP.\n"
"Choose a different authentication method."
msgstr ""
"Server POP3 của bạn không hỗ trợ APOP . \n"
"Chọn một phương pháp xác nhận khác ."

#: pop3.cc:395
msgid ""
"Your POP3 server claims to support TLS but negotiation was unsuccessful. You "
"can disable TLS in KDE using the crypto settings module."
msgstr ""
"POP3 server của bạn khẳng định là hỗ trợ TLS nhưng đàm "
"phán không thành công . Bạn có thể vô hiệu hoá TLS trong KDE "
"dùngmodule thiết lập mã hoá ."

#: pop3.cc:405
msgid ""
"Your POP3 server does not support TLS. Disable TLS, if you want to connect "
"without encryption."
msgstr ""
"POP3 server của bạn không hỗ trợ TLS . Hãy vô hiệu hoá "
"TLS,nếu bạn muốn kết nối vào không dùng mã hoá ."

#: pop3.cc:416
#, fuzzy
msgid "Username and password for your POP3 account:"
msgstr "Tên người dùng và mật khẩu cho tài khoản POP3:"

#: pop3.cc:462
#, fuzzy, c-format
msgid ""
"Login via APOP failed. The server may not support APOP, although it claims "
"to support it, or the password may be wrong.\n"
"\n"
"%1"
msgstr ""
"Đăng nhập bằng APOP thất bại . Server có thể không hỗ trợ "
"APOP,hoặc mật khẩu sai . \n"
"\n"
"%1"

#: pop3.cc:519
msgid ""
"Login via SASL (%1) failed. The server may not support %2, or the password "
"may be wrong.\n"
"\n"
"%3"
msgstr ""
"Đăng nhập bằng SASL (%1) thất bại . Server có thể không hỗ "
"trợ %2  APOP,hoặc mật khẩu sai . \n"
"\n"
"%3"

#: pop3.cc:534
msgid ""
"Your POP3 server does not support SASL.\n"
"Choose a different authentication method."
msgstr ""
"POP3 server của bạn không hỗ trợ SASL .\n"
"Chọn phương pháp xác nhận khác ."

#: pop3.cc:563
msgid ""
"Could not login to %1. The password may be wrong.\n"
"\n"
"%2"
msgstr ""
"Không thể đăng nhập vào %1 . Mật khẩu có thể sai . \n"
"\n"
"%2"

#: pop3.cc:746 pop3.cc:755 pop3.cc:894
msgid "Unexpected response from POP3 server."
msgstr "Hồi âm không ngờ tời từ Pop3 server ."
