#: kio_sftp.cpp:294
msgid "Opening connection to host <b>%1:%2</b>"
msgstr "Mở kết nối tời host <b>%1:%2</b>"

#: kio_sftp.cpp:355
msgid "Sftp Login"
msgstr "Đăng nhập Sftp"

#: kio_sftp.cpp:357
msgid "site:"
msgstr "site:"

#: kio_sftp.cpp:369
msgid "Login failed. Retrying..."
msgstr "Đăng nhập thất bại . Thử lại ...."

#: kio_sftp.cpp:391
msgid "Please enter your username and password."
msgstr "Hãy nhập tên người dùng và mật khẩu ."

#: kio_sftp.cpp:394
msgid ""
"Login failed.\n"
"Please confirm your username and password, and enter them again."
msgstr ""
"Đăng nhập thất bại . \n"
"Xãy xác nhận lại tên người dùng và mật khẩu và thử lại "
"một lần nữa ."

#: kio_sftp.cpp:399
msgid "Please enter a username and password"
msgstr "Xin nhập tên người dùng và mật khẩu ."

#: kio_sftp.cpp:419
msgid "Connection failed."
msgstr "Kết nối thất bại ."

#: kio_sftp.cpp:425
msgid "Warning: Host key not found!"
msgstr "Cảnh báo : Không tìm thấy khoá Host !"

#: kio_sftp.cpp:429
msgid "Warning: Host key has changed!"
msgstr "Cảnh báo : Khóa host đã bị thay đổi !"

#: kio_sftp.cpp:440
msgid "Shall we continue connecting to %1?"
msgstr "Chúng ta có thể tiếp tục nối tới %1 không ? "

#: kio_sftp.cpp:457
msgid "Connected to "
msgstr "Đã nối tới"

#: kio_sftp.cpp:488
msgid "Timed out waiting for a response from the server."
msgstr "Hết giờ đợi trả lời từ server ."

#: kio_sftp.cpp:501
msgid "Login failed."
msgstr "Đăng nhập thất bại ."

#: kio_sftp.cpp:503
msgid ""
"Could not login to %1.\n"
"Maximum number of retries exceeded."
msgstr ""
"Không thể nối tới %1 .\n"
"Đã quá số tối  đa lần thử lại cho phép ."

#: kio_sftp.cpp:531
msgid "Login OK"
msgstr "Đăng nhập OK "
