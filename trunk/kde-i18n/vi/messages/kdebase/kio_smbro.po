#: kio_smb.cpp:205 kio_smb.cpp:219 kio_smb.cpp:408 kio_smb.cpp:441
#: kio_smb.cpp:1204 kio_smb.cpp:1238
msgid ""
"\n"
"Make sure that the samba package is installed properly on your system."
msgstr ""
"\n"
"Đảm bảo rằng gói samba đã được cài đặt đúng trong hệ "
"thống của bạn ."

#: kio_smb.cpp:215
msgid ""
"\n"
"There is probably no SMB service running on this host."
msgstr ""
"\n"
"Có thể là không có dịch vụ SMB chạy trên host này ."

#: kio_smb.cpp:234 kio_smb.cpp:239
msgid ""
"\n"
"Invalid user/password combination."
msgstr ""
"\n"
"Sai tổ hợp người dùng / mật khẩu "

#: kio_smb.cpp:258
msgid "Hmm..."
msgstr "E hèm ..."

#: kio_smb.cpp:565 kio_smb.cpp:1082
msgid ""
"To access the shares of a host, use smb://hostname\n"
"To get a list of all hosts use lan:/ or rlan:/ .\n"
"See the KDE Control Center under Network, LANBrowsing for more information."
msgstr ""
"Để truy cập tới share của host, dùng smb://hostname\n"
"để lấy danh sách các host trong lan, dùng lan:/ hay rlan:/ .\n"
"Xem Trung tâm điều khiển KDE, dưới phần Mạng, LANBrowsing để "
"có thêm thông tin ."

#: kio_smb.cpp:895
msgid ""
"\n"
"To access the shares of a host, use smb://hostname\n"
"To get a list of all hosts use lan:/ or rlan:/ .\n"
"See the KDE Control Center under Network, LANBrowsing for more information."
msgstr ""
"\n"
"Để truy cậ pđến share của host, dùng smb://hostname \n"
"để lấy danh sách các host trong lan, dùng lan:/ hay rlan:/ .\n"
"Xem Trung tâm điều khiển KDE, dưới phần Mạng, LANBrowsing để "
"có thêm thông tin ."

#: kio_smb.cpp:939 kio_smb.cpp:970
