"Could not create required pipe %1 ."
msgstr ""
"\n"
"Không thể tạo pipecần thiết : %1 ."

#: kio_smb.cpp:981 kio_smb.cpp:989
msgid ""
"\n"
"Could not fcntl() pipe %1 ."
msgstr ""
"\n"
"Không thể fcntl() pipe  %1 . "

