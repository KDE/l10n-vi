#, c-format
msgid "End session for %1"
msgstr "Kết thúc session cho %1"

#: shutdown.cpp:105
msgid "What do you want to do next?"
msgstr "Bạn muốn làm gì tiếp ?"

#: shutdown.cpp:106
msgid "&Login as different user"
msgstr "&Log bằng user khác"

#: shutdown.cpp:107
