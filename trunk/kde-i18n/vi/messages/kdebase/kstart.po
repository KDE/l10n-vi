#: kstart.cpp:193
msgid "Command to execute."
msgstr "Lệnh sẽ thực hiện ."

#: kstart.cpp:195
msgid ""
"A regular expression matching the window title.\n"
"If you do not specify one, then the very first window\n"
"to appear will be taken. Not recommended!"
msgstr ""
"Một regular expression khớp với tiêu đề cửa sổ .\n"
"Nếu bạn không muốn chỉ định cái này, thì những cửa sổ "
"xuất \n"
"hiện vào lúc đầu tiên sẽ bị lấy đi ! Không khuyến nghị !"

#: kstart.cpp:198
msgid "Desktop where to make the window appear. "
msgstr "Desktop nơi mà cửa sổ sẽ hiện ."

#: kstart.cpp:199
msgid ""
"Make the window appear on the desktop that was active\n"
"when starting the application. "
msgstr ""
"Làm cho cửa sổ sẽ hiện ra trong desktop được kích hoạt \n"
"khi chương trình được khởi động ."

#: kstart.cpp:200
msgid "Make the window appear on all desktops"
msgstr "Làm cho cửa sổ xuất hiện trên mọi cửa sổ "

#: kstart.cpp:201
msgid "Iconify the window"
msgstr "Icon hoá cửa sổ"

#: kstart.cpp:202
msgid "Maximize the window"
msgstr "Cực đại cửa sổ"

#: kstart.cpp:203
msgid "Show window fullscreen. Implies type Override."
msgstr ""

#: kstart.cpp:204
#, fuzzy
msgid ""
"The window type: Normal, Desktop, Dock, Tool, \n"
"Menu, Dialog, TopMenu or Override"
msgstr ""
"Kiểu cửa sổ : Thường, Desktop, Dock, Công cụ, \n"
"Thực đnơ, Thông điệp va `Override "

#: kstart.cpp:205
msgid ""
"Jump to the window even if it is started on a \n"
"different virtual desktop"
msgstr ""
"Nhảy tới cửa sổ cho  dù nếu nó được khởi động \n"
"từ một deskop ảo khác "

#: kstart.cpp:207
msgid "Make the window always stay on top of any other window"
msgstr "Làm cho cửa sổ luôn nổi trên bất kì cửa sổ nào khác "

#: kstart.cpp:208
msgid "The window does not get an entry in the taskbar"
msgstr "Cửa sổ không lấy được hạng mục trong thanh tác vụ "

#: kstart.cpp:209
msgid "The window does not get an entry on the pager"
msgstr "Cửa sổ không lấy được hạng mục trên pager"

#: kstart.cpp:210
msgid "The window is sent to the system tray in Kicker."
msgstr "Cửa sổ được gửi tới khay hệ thống trong Kicker ."

#: kstart.cpp:217
msgid "KStart"
msgstr "KStart"

#: kstart.cpp:218
msgid ""
"Utility to launch applications with special window properties \n"
"such as iconified, maximized, a certain virtual desktop, a special "
"decoration\n"
"and so on."
msgstr ""
"Tiện ích để khởi động chương trình với một tính chất "
"cửa\n"
"sổ đặc biệt như icon hoá, cực đại hoá, deskop ảo nào "
"đó,bố trí đặc biệt \n"
" vv ..."

#: kstart.cpp:238
msgid "No command specified"
msgstr "Không có lệnh được chỉ định "

