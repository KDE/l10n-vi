#: ksystraycmd.cpp:61
msgid ""
"No window matching pattern '%1' and no command specified.\n"
msgstr ""
"Không có cửa sổ nào match pattern '%1' à không lệnh được "
"chỉ định .\n"

#: ksystraycmd.cpp:68
msgid "KSysTrayCmd: KShellProcess can't find a shell."
msgstr "KSysTrayCmd: KShellProcess không thể tìm thấy shell ."

#: ksystraycmd.cpp:188 main.cpp:43
msgid "KSysTrayCmd"
msgstr "KSysTrayCmd"

#: ksystraycmd.cpp:189
msgid "&Hide"
msgstr "Â?&n"

#: ksystraycmd.cpp:189
msgid "&Restore"
msgstr "&Khôi phục"

#: main.cpp:23
msgid "Command to execute."
msgstr "Lệnh sẽ thực hiện ."

#: main.cpp:25
msgid ""
"A regular expression matching the window title.\n"
"If you do not specify one, then the very first window\n"
"to appear will be taken. Not recommended!"
msgstr ""
"Một regular expression match đầu đề cửa sổ . \n"
"Nếu bạn không muốn chỉ định,  cửa sổ đầu tiên \n"
"xuất hiện sẽ bị chọn . Không khuyến nghị !"

#: main.cpp:28
msgid "Hide the window to the tray on startup"
msgstr "Â?n cửa sổ vào khay của startup"

#: main.cpp:29
msgid ""
"Wait until we're told to show the window before\n"
"executing the command"
msgstr ""
"Đợi đến khi bạn được bảo sẽ hiển thị cửa sổ \n"
"trước khi thi hành lệnh"

#: main.cpp:31
msgid "Sets the initial tooltip for the tray icon"
msgstr "Đặt tooltip khởi tạo cho icon khay "

#: main.cpp:32
msgid ""
"Keep the tray icon even if the client exits. This option\n"
"has no effect unless startonshow is specified."
msgstr ""
"Giữ icon khay cho dù client đã tồn tại . Tuỳ chọn này \n"
"không có hiệu quả trừ khi startonshow  được chỉ định ."

#: main.cpp:34
msgid ""
"Quit the client when we're told to hide the window\n"
"has no effect unless startonshow is specified and implies keeprunning."
msgstr ""
"Thoát client khi chúng ta được bảo là ẩn cửa sổ \n"
"Không có hiệu quả trừ khi  startonshow được chỉ định và "
"chạy ."

#: main.cpp:45
msgid "Allows any application to be kept in the system tray."
msgstr ""
"Cho phép bất kì chương trình nào được giữ trong khay hệ "
"thống ."

#: main.cpp:64
msgid "No command or window title specified"
msgstr "Không lệnh hay tiêu đề cửa sổ nào được chỉ định "

