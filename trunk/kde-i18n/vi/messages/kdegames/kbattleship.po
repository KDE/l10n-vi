msgstr "Bạn thua rồi :("

#: kbattleshipserver.cpp:49
msgid ""
"Failed to bind to local port \"%1\"\n"
"\n"
"Please check if another KBattleship server instance\n"
"is running or another application uses this port."
msgstr ""
"Lỗi khi kết nối tới cổng cục bộ \"%1\"\n"
"\n"
"Hãy kiểm tra nếu máy chủ (trò Bắn Tàu) cá biệt nào đó \n"
"đang chạy hay ứng dụng khác đang dùng cổng này."

#: kbattleshipserver.cpp:75
msgid "The connection broke down!"
msgstr "Kết nối bị đứt!"

#: kbattleshipsound.cpp:61
msgid "Couldn't connect to aRts Soundserver. Sound deactivated"
msgstr "Không thể kết nối tới trình phục vụ âm thanh aRts. Không hoạt hóa âm thanh"

#: kbattleshipsound.cpp:78
msgid "You don't have KBattleship Sounds installed. Sound deactivated"
msgstr "Các tập tin âm thanh của trò chơi chưa được cài. Không hoạt hóa âm thanh"

#: konnectionhandling.cpp:78
msgid "Connection to client lost. Aborting the game!"
msgstr "Mất kết nối với máy khách. Bỏ trận đấu!"

#: konnectionhandling.cpp:100
msgid ""
"Connection dropped by enemy. The client's protocol implementation (%1) is "
"not compatible with our (%2) version!"
msgstr "Kết nối bị cắt bởi đối phương. Sự bổ sung (%1) trong giao thức truyền của máy khách không tương thích với phiên bản (%2) của chúng ta!"

#: konnectionhandling.cpp:164
msgid ""
"Connection to client dropped. The client's protocol implementation (%1) is "
"not compatible with our (%2) version!"
msgstr "Kết nối với máy khách bị mất. Sự bổ sung (%1) trong giao thức truyền của máy khách không tương thích với phiên bản (%2) của chúng ta!"

#: konnectionhandling.cpp:172
msgid "We got a player. Let's start..."
msgstr "Chúng ta có một người chơi. Hãy bắt đầu..."

#: konnectionhandling.cpp:182
msgid "You can shoot now"
msgstr "Bây giờ bạn có thể bắn"

#: konnectionhandling.cpp:224
msgid "Connection refused by other host!"
msgstr "Kết nối bị từ chối bởi người điều hành trận đấu khác!"

#: konnectionhandling.cpp:228
msgid "Couldn't lookup host!"
msgstr "Không thể tìm ra người điều hành trận đấu!"

#: konnectionhandling.cpp:232
msgid "Couldn't connect to server!"
msgstr "Không thể kết nối tới máy chủ!"

#: konnectionhandling.cpp:236
#, c-format
msgid "Unknown Error; No: %1"
msgstr "Lỗi chưa được biết: Số: %1"

#: konnectionhandling.cpp:245
msgid "Connection to server lost. Aborting the game!"
msgstr "Mất kết nối với máy chủ. Bỏ trận đấu!"

