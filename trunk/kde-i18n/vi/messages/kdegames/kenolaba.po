#: rc.cpp:28
msgid "Four In-A-Row"
msgstr "Cả bốn đều cùng hàng"

#: rc.cpp:29
msgid "Five In-A-Row"
msgstr "Cả năm đều cùng hàng"

#: rc.cpp:30
msgid "For a number of balls In-a-Row, the given points are added to the evaluation"
msgstr "Với số banh cùng hàng, điểm được cho sẽ được cộng vào hệ số ước lượng"

#: rc.cpp:31
msgid "Count"
msgstr "Đếm"

