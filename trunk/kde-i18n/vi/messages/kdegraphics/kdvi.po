#: dvi_init.cpp:81
msgid "The DVI file does not start with the preamble."
msgstr "File DVI không bắt đầu bằng preamble."

#: dvi_init.cpp:86
msgid "The DVI file contains the wrong version of DVI output for this program. Hint: If you use the typesetting system Omega, you have to use a special program, such as oxdvi."
msgstr ""
"File DVI chứa phiên bản sai của xuất DVI trên chương trình này. "
"Gợi ý: Nếu bạn dùng Hệ thống typesetting Omega, "
"bạn phải dugnf một chương trình đặc biệt là oxdvi "

#: dvi_init.cpp:120
msgid "The DVI file is badly corrupted. KDVI was not able to find the postamble."
msgstr "File DVI bị hỏng nặng. KDVI không thể tìm thấy postamble."

#: dvi_init.cpp:135
msgid "The postamble does not begin with the POST command."
msgstr "Postamble không bắt đầu bằng lệnh POST"

#: dvi_init.cpp:182
msgid "The postamble contained a command other than FNTDEF."
msgstr "Postamble chứa lệnh không phải là FNTDEF."

#: dvi_init.cpp:213
msgid "The page %1 does not start with the BOP command."
msgstr "Trang %1 không bắt đầu bằng lệnh BOP."

#: dvi_init.cpp:245
msgid "Not enough memory to load the DVI-file."
msgstr "Không đủ bộ nhớ để tải file DVI."

#: dvi_init.cpp:251
msgid "Could not load the DVI-file."
msgstr "Không thể tải file DVI."

#: dviwin.cpp:247
msgid "The change in Metafont mode will be effective only after you start kdvi again!"
msgstr "Thay đổi trong chế độ Metafont sẽ có hiệu lực sau khi bạn khởi động lại kdvi."

#: dviwin.cpp:318
msgid "<qt><strong>File corruption!</strong> KDVI had trouble interpreting your DVI file. Most likely this means that the DVI file is broken.</qt>"
msgstr ""
"<qt><strong>File bị hỏng!</strong> "
"KDVI có vấn đề với việc biên dịch file DVI của bạn . "
"Rất có khả năng file DVI bị hỏng.</qt>"

#: dviwin.cpp:320 dviwin.cpp:482
msgid "DVI File error"
msgstr "Lỗi file DVI"

#: dviwin.cpp:338
msgid "KDVI: Information"
msgstr "KDVI: Thông tin"

#: dviwin.cpp:353
msgid "<qt>This DVI file contains source file information. You may click into the text with the middle mouse button, and an editor will open the TeX-source file immediately.</qt>"
msgstr ""
"<qt>File DVI này chứa thông tin về file nguồn. "
"Bạn có thể  nhấn vào text bằng chuột giữa và "
"một trình biên soạn TeX sẽ được mở tức thời.</qt>"

#: dviwin.cpp:362
msgid "Explain in more detail..."
msgstr "Giải thích cụ thể hơn..."

#: dviwin.cpp:454
msgid "<qt><strong>File error!</strong> The specified file '%1' does not exist. KDVI already tried to add the ending '.dvi'</qt>"
msgstr "<qt><strong>Lỗi File !</strong> File đã chỉ định '%1' không tồn tại. KDVI đã thử thêm '.dvi' vào cuối</qt> "

#: dviwin.cpp:456
msgid "File error!"
msgstr "Lỗi file!"

#: dviwin.cpp:467
msgid "<qt>Could not open file <nobr><strong>%1</strong></nobr> which has type <strong>%2</strong>. KDVI can only load DVI (.dvi) files.</qt>"
msgstr ""
"<qt>Không thể mở file <nobr><strong>%1</strong></nobr> "
"có kiểu <strong>%2</strong>. KDVI chỉ có thể mở file  DVI (.dvi) .</qt>"

#: dviwin.cpp:480
msgid "<qt>File corruption! KDVI had trouble interpreting your DVI file. Most likely this means that the DVI file is broken.</qt>"
msgstr ""
"<qt>File hỏng! KDVI gặp vấn đề khi dịch file dvi của bạn "
"Rất có khả năng file DVI bị hỏng.</qt>"

#: dviwin.cpp:578
msgid "Searching for position corresponding to line %1 in %2."
msgstr "Tìm vị trí tương ứng với dòng %1 trong %2."

#: dviwin.cpp:579 dviwin_export.cpp:84 dviwin_textsearch.cpp:82
#: dviwin_textsearch.cpp:170 fontprogress.cpp:30
msgid "Abort"
msgstr "Bỏ qua"

#: dviwin.cpp:631
msgid "<qt>You have asked KDVI to locate the place in the DVI file which corresponds to line %1 in the TeX-file <strong>%2</strong>. It seems, however, that the DVI file does not contain the necessary source file information. We refer to the manual of KDVI for a detailed explanation on how to include this information. Press the F1 key to open the manual.</qt>"
msgstr ""
"<qt>Bạn đã yêu cầu KDVI định vị vị trí của file DVI tương ứng với dòng %1 trong file "
"TeX <strong> %2 </strong>. Có vẻ như là, tuy  file DVI không chứa thông tin "
"cần thiết về file nguồn. Xin xem manul của KDVI để có thêm thông tin. "

#: dviwin.cpp:636 dviwin.cpp:644
msgid "Could not find reference"
msgstr "Không tìm thấy tham chiếu"

#: dviwin.cpp:642
msgid "<qt>KDVI was not able to locate the place in the DVI file which corresponds to line %1 in the TeX-file <strong>%2</strong>.</qt>"
msgstr ""
"<qt>KDVI không thể định vị trí của file DVI tương ứng với dòng %1 trong file TeX < "
"<strong>%2</strong>.</qt>"

#: dviwin.cpp:901
msgid "The DVI-file refers to the TeX-file <strong>%1</strong> which could not be found."
msgstr "Không tìm thầy fil  DVI mà file TeX tham khảo đến <strong>%1</strong>"

#: dviwin.cpp:903
msgid "Could not find file"
msgstr "Không tìm thấy file"

#: dviwin.cpp:910
msgid "You have not yet specified an editor for inverse search. Please choose your favourite editor in the <strong>DVI options dialog</strong> which you will find in the <strong>Settings</strong>-menu."
msgstr ""
"Bạn chư chỉ định trình biên soạn  cho việc tìm kiếm ngược. "
"Xin chọn 1 trình biên soạn(text) và bạn yêu thích trong <strong> "
"hộp thoại tuỳ chọn DVI</strong>.Tìm tuỳ chọn này trong thực đơn <strong> "
"Thiết lập</strong> "

#: dviwin.cpp:914
msgid "Need to specify editor"
msgstr "Cần phải  chỉ định trình biên soạn"

#: dviwin.cpp:915
msgid "Use KDE's editor Kate for now"
msgstr "Dùng Kate bây giờ"

#: dviwin.cpp:947
msgid "<qt>The external program<br/><br/><tt><strong>%1</strong></tt><br/><br/>which was used to call the editor for inverse search, reported an error. You might wish to look at the <strong>document info dialog</strong> which you will find in the File-Menu for a precise error report. The manual for KDVI contains a detailed explanation how to set up your editor for use with KDVI, and a list of common problems.</qt>"
msgstr ""
"<qt>Chương trình ngoài <br/><br/><tt><strong>%1</strong></tt><br/><br/> "
"được dùng để gọi chương trình biên soạn cho việc tìm ngược báo cáo lỗi. "
"Bạn nên tìm trong <strong>document info dialog</strong> "
" Ngoài ra, bạn cũng nên xem trang manual của KDVI.</qt>"

#: dviwin.cpp:954
msgid "Starting the editor..."
msgstr "Khởi động trình biên soạn..."

#: dviwin_draw.cpp:268
msgid "The DVI code set a character of unknown font"
msgstr "Code DVI đặt 1 kí tự có font không biết"

#: dviwin_draw.cpp:304
msgid "The DVI code referred to font #%1, which was not previously defined."
msgstr "Mã nguồn DVI tham khảo đến font #%1 đã được định nghĩa."

#: dviwin_draw.cpp:371
msgid "The stack was not empty when the EOP command was encountered."
msgstr "Stack không rỗng khi lệnh EOP được thực hiện."

#: dviwin_draw.cpp:383
msgid "The stack was empty when a POP command was encountered."
msgstr "Stack không rỗng khi lệnh POP được thực hiện."

#: dviwin_draw.cpp:507 dviwin_draw.cpp:516
msgid "The DVI code referred to a font which was not previously defined."
msgstr "Mã nguồn DVI tham khảo đến font chưa được định nghĩa."

#: dviwin_draw.cpp:552
msgid "An illegal command was encountered."
msgstr "Gặp lệnh không hợp lệ"

#: dviwin_draw.cpp:557
msgid "The unknown op-code %1 was encountered."
msgstr "Gặp op-code chưa biết %1"

#: dviwin_export.cpp:57
msgid "<qt>This function exports the DVI file to a plain text. Unfortunately, this version of KDVI treats only plain ASCII characters properly. Symbols, ligatures, mathematical formulae, accented characters, and non-english text, such as Russian or Korean, will most likely be messed up completely.</qt>"
msgstr ""
"<qt>Hàm này xuất file DVI thành plain text. Đáng tiếc là phiên bản KDVI này "
"chỉ xử lí các kí tự ASCII đúng. Các kí tự, công thức toán, text không phải là tiếng Anh "
"như Russian hay Korean, sẽ có thể bị hỏng hoàn toàn.</qt>"

#: dviwin_export.cpp:61 dviwin_textsearch.cpp:31
msgid "Function May Not Work as Expected"
msgstr "Hàm có có thể sẽ không hoạt động như bạn đã dự đoán"

#: dviwin_export.cpp:62
msgid "Continue anyway"
msgstr "Dù vậy, vẫn tiếp tục"

#: dviwin_export.cpp:66 dviwin_export.cpp:166 dviwin_export.cpp:251
msgid "Export File As"
msgstr "Xuất file thành"

#: dviwin_export.cpp:71 dviwin_export.cpp:171 dviwin_export.cpp:256
msgid "The file %1\nexists. Shall I overwrite that file?"
msgstr "File %1 đã tồn tại. Tôi có thể viết đè không?"

#: dviwin_export.cpp:72 dviwin_export.cpp:172 dviwin_export.cpp:257
msgid "Overwrite file"
msgstr "Viết đè"

#: dviwin_export.cpp:84
msgid "Exporting to text..."
msgstr "Xuất thành text..."

#: dviwin_export.cpp:155
msgid "KDVI could not locate the program 'dvipdfm' on your computer. That program is absolutely needed by the export function. You can, however, convert the DVI-file to PDF using the print function of KDVI, but that will often produce files which print ok, but are of inferior quality if viewed in the Acrobat Reader. It may be wise to upgrade to a more recent version of your TeX distribution which includes the 'dvipdfm' program.\nHint to the perplexed system administrator: KDVI uses the shell's PATH variable when looking for programs."
msgstr ""
"KDVI không thể định vị chương trình 'dvipdfm' trên máy tính của bạn. "
"Chương trình này rất cần cho hàm xuất. Bạn có thể, hoán chuyển file DVI "
"thành PDF dùng hàm in của KDVI, nhưng nó sẽ chỉ xuất được file có thể in, cho dù "
"chất lượng kém hơn nếu xem bằng Acrobat Reader. "
"Bạn nên cập nhật phiên bản TeX chứa chương trình 'dvipdfm'.\n"
"Gợi ý cho các sysadmin: KDVI dùng biến môi trường PATH để tìm chương trình "

#: dviwin_export.cpp:179
msgid "Using dvipdfm to export the file to PDF"
msgstr "Dùng dvipdfm để hoán chuyển file thành PDF"

#: dviwin_export.cpp:181
msgid "KDVI is currently using the external program 'dvipdfm' to convert your DVI-file to PDF. Sometimes that can take a while because dvipdfm needs to generate its own bitmap fonts Please be patient."
msgstr ""
"Hiện tại KDVI dùng chương trình ngoài 'dvipdfm' để hoán chuyển file DVI thành PDF. "
"Đôi lúc nó sẽ khá mất thời gian nếu dvipdfm cần sinh nhiều font bitmap. "
"Hãy kiên nhẫn ;)"

#: dviwin_export.cpp:185
msgid "Waiting for dvipdfm to finish..."
msgstr "Đợi đến khi dvipdfm kết thúc..."

#: dviwin_export.cpp:188 dviwin_export.cpp:277
msgid "Please be patient"
msgstr "Hãy kiên nhẫn."

#: dviwin_export.cpp:204
msgid "<qt>The external program 'dvipdf', which was used to export the file, reported an error. You might wish to look at the <strong>document info dialog</strong> which you will find in the File-Menu for a precise error report.</qt>"
msgstr ""
"<qt> 'dvipdf' báo về lỗi. Bán có thể xem  <strong>document info dialog</strong> "
"để có thêm thông tin cụ thể hơn về lỗi.</qt>"

#: dviwin_export.cpp:210
msgid "Export: %1 to PDF"
msgstr "Xuất: %1 thành PDF"

#: dviwin_export.cpp:268
msgid "Using dvips to export the file to PostScript"
msgstr "Dùng dvips để xuất file PostScript"

#: dviwin_export.cpp:270
msgid "KDVI is currently using the external program 'dvips' to convert your DVI-file to PostScript. Sometimes that can take a while because dvips needs to generate its own bitmap fonts Please be patient."
msgstr ""
"KDVI hiện tại dùng 'dvips' để hoán chuyển file dvi thành ps. "
"Đôi khi việc làm này sẽ rất mất thời gian nếu file dvi dùng font bitmap. Hãy kiên nhẫn."

#: dviwin_export.cpp:274
msgid "Waiting for dvips to finish..."
msgstr "Đợi cho đến khi dvips kết thúc..."

#: dviwin_export.cpp:336
msgid "<qt>Failed to copy the DVI-file <strong>%1</strong> to the temporary file <strong>%2</strong>. The export or print command is aborted.</qt>"
msgstr ""
"<qt>Copy DVI-file<strong>%1</strong> tới  <strong>%2</strong> không thành công to the temporary file . "
"Lệnh xuất hay in đã bị bỏ qua.</qt>"

#: dviwin_export.cpp:352
msgid "<qt>The external program 'dvips', which was used to export the file, reported an error. You might wish to look at the <strong>document info dialog</strong> which you will find in the File-Menu for a precise error report.</qt>"
msgstr ""
"<qt>Chương trình ngoài 'dvips' trả về lỗi, Bạn nên  xem  <strong>document info dialog "
"</strong>  ở File-Menu để có thông tin chi tiết hơnt.</qt>"

#: dviwin_export.cpp:356
msgid "Export: %1 to PostScript"
msgstr "Xuất %1 thành PostScript"

#: dviwin_textsearch.cpp:27
msgid "<qt>This function searches the DVI file for plain text. Unfortunately, this version of KDVI treats only plain ASCII characters properly. Symbols, ligatures, mathematical formulae, accented characters, and non-english text, such as Russian or Korean, will most likely be messed up completely. Continue anyway?</qt>"
msgstr ""
"<qt>Chức năng này tìm plain text trong file DVI,. Đáng tiếc là phiên bản KDVI này chỉ "
"hoạt động tốt với các kí hiệu thuần ASCII. Các kí hiệu khác, công thwcs toán, "
"và các chữ có dấu, các kí tự non-english như Tiếng Nga, Hàn Quốc, sẽ có thể bị "
"hỏng hoàn toàn. Bạn có muốn tiếp tục không?</qt>"

#: dviwin_textsearch.cpp:82 dviwin_textsearch.cpp:170
msgid "Searching for '%1'..."
msgstr "Tìm '%1'..."

#: dviwin_textsearch.cpp:115
msgid "<qt>The search string <strong>%1</strong> could not be found till the end of the document. Should the search be restarted from the beginning of the document?</qt>"
msgstr ""
"<qt>Không tìm thấy chuỗi  <strong>%1</strong> "
"Tìm lại từ đầu văn bản?</qt>"

#: dviwin_textsearch.cpp:118 dviwin_textsearch.cpp:200
msgid "Text not found"
msgstr "Không tìm thấy text"

#: dviwin_textsearch.cpp:133 dviwin_textsearch.cpp:244
msgid "<qt>The search string <strong>%1</strong> could not be found.</qt>"
msgstr "<qt> Không tìm thấy chuỗi <strong> %1  </strong></qt>"

#: dviwin_textsearch.cpp:197
msgid "<qt>The search string <strong>%1</strong> could not be found till the beginning of the document. Should the search be restarted from the end of the document?</qt>"
msgstr ""
"<qt>Tìm đến đầu văn bản nhưng không tìm thấy chuỗi <strong>%1</strong> "
".Tìm lại từ cuối văn bản?</qt>"

#: font.cpp:43
msgid "Can't find font "
msgstr "Không tìm thấy fonts"

#: font.cpp:56
msgid "The GF format for font file %1 is no longer supported"
msgstr "Định dạng GF của file font %1 không còn được hỗ trợ"

#: font.cpp:62
#, c-format
msgid "Cannot recognize format for font file %1"
msgstr "Không nhận dạng được định dạng file font %1"

#: font.cpp:148
msgid "Character %1 not defined in font %2"
msgstr "Kí tự %1 chưa được định nghĩa trong file font %2"

#: font.cpp:158
#, c-format
msgid "Font file disappeared: %1"
msgstr "File font biến mất: %1"

#: fontpool.cpp:36
msgid "KDVI is currently generating bitmap fonts..."
msgstr "DVI đang sinh font bitmap..."

#: fontpool.cpp:37
msgid "Aborts the font generation. Don't do this."
msgstr "Bỏ qua quá trình sinh font? Không nên làm vậy"

#: fontpool.cpp:38
msgid "KDVI is currently generating bitmap fonts which are needed to display your document. For this, KDVI uses a number of external programs, such as MetaFont. You can find the output of these programs later in the document info dialog."
msgstr ""
"KDVI hiện tại đang sinh font bitmap cần cho quá trình hiển thị tài liệu. "
"Để hoàn tất được công việc này, KDE dùng khá nhiều chương trình ngoài như MetaFont. "
"Bạn có thể tìm thấy danh sách các chương trình này trong hộp thoại thông tin về tài liệu."

#: fontpool.cpp:41
msgid "KDVI is generating fonts. Please wait."
msgstr "KDVI đang sinh font.  Xin chờ đợi."

#: fontpool.cpp:112
msgid "Could not allocate memory for a font structure!"
msgstr "Không thể cấp phát bộ nhớ cho cấu trúc font!"

#: fontpool.cpp:128
msgid "The fontlist is currently empty."
msgstr "Danh sách font hiện đang trống."

#: fontpool.cpp:138
msgid "virtual"
msgstr "ảo"

#: fontpool.cpp:140
msgid "regular"
msgstr "chính quy"

#: fontpool.cpp:201
msgid "Locating fonts..."
msgstr "Định vị font..."

#: fontpool.cpp:214
msgid "Font Generation"
msgstr "Sinh Font"

#: fontpool.cpp:344
msgid "Font not found - KDVI"
msgstr "Không tìm thấy font - KDVI"

#: fontpool.cpp:345
msgid "There were problems running the kpsewhich program. KDVI will not work if TeX is not installed on your system or if the kpsewhich program cannot be found in the standard search path.\n"
msgstr ""
"Có vấn đề với chương trình kpsewich.KDVI không thể hoạt động nếu "
"TeX chưa được cài đặt trên hệ thống của bạn hay nếu kpsewhich không được tìm thấy trong "
"$PATH\n"

#: fontpool.cpp:349
msgid "KDVI was not able to locate all the font files which are necessary to display the current DVI file. Some characters are therefore left blank, and your document might be unreadable."
msgstr ""
"KDVI không thể định vị được tất cả các font cần cho việc hiển thị file DVI hiện tại. "
"Vì vậy, một số kí tự sẽ bị bỏ trắng và tài liệu của bạn sẽ không đọc được hoàn hảo."

#: fontpool.cpp:353
msgid "\nExperts will find helpful information in the 'MetaFont'-section of the document info dialog"
msgstr "\nCác cao thủ sẽ tìm thấy những thông tin hữu dụng trong phần MetaFont của hộp thoại thông tin tài liệu"

#: fontpool.cpp:360
msgid "\nAutomatic font generation is switched off."
msgstr "\nHiện tại không tự động sinh font"

#: fontpool.cpp:361
msgid "Generate fonts now"
msgstr "Sinh font"

#: fontpool.cpp:361
msgid "Continue without"
msgstr "Tiếp tục mà không có"

#: fontpool.cpp:468
msgid "Currently generating %1 at %2 dpi"
msgstr "Hiện đang sinh %1 ở %2 dpi"

#: fontprogress.cpp:34
msgid "What's going on here?"
msgstr "What's going on here?"

#: fontprogress.cpp:48
msgid "%v of %m"
msgstr "%v trên %m"

#: infodialog.cpp:26
msgid "DVI File"
msgstr "File DVI "

#: infodialog.cpp:29
msgid "Information on the currently loaded DVI-file."
msgstr "Thông tin về file DVI vừa tải vào"

#: infodialog.cpp:37
msgid "Information on currently loaded fonts."
msgstr "Thông tin về font vừa tải vào"

#: infodialog.cpp:38
msgid "This text field shows detailed information about the currently loaded fonts. This is useful for experts who want to locate problems in the setup of TeX or KDVI."
msgstr ""
"Trường text này hiện thông tin cụ thể về các font vửa được tải vào. "
"Những thông tin này sẽ rất có ích cho các cao thủ muốn tìm ra vấn đề cho việc cài đặt TeX hay DVI"

#: infodialog.cpp:42
msgid "External Programs"
msgstr "Chương trình ngoài"

#: infodialog.cpp:45
msgid "No output from any external program received."
msgstr "Không nhận được bất kì output nào từ chương trình ngoài."

#: infodialog.cpp:46
msgid "Output of external programs."
msgstr "Xuất của chương trình ngoài."

#: infodialog.cpp:47
msgid "KDVI uses external programs, such as MetaFont, dvipdfm or dvips. This text field shows the output of these programs. That is useful for experts who want to find problems in the setup of TeX or KDVI."
msgstr ""
"KDVI dùng các chương trình ngoài, như MetaFont, dvipdfm, hay dvips. "
"Trường text này hiển thị output của những chương trình đó "
"Nó sẽ rất có ích cho những cao thủ muốn giải quyết vấn đề trong việc cài đặt TeX ahy KDVI"

#: infodialog.cpp:63
msgid "There is no DVI file loaded at the moment."
