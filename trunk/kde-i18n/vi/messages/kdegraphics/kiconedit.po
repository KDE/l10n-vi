#: kiconedit.cpp:166 kiconeditslots.cpp:94 kiconeditslots.cpp:144
#: kiconeditslots.cpp:323
msgid "The current file has been modified.\nDo you want to save it?"
msgstr "File hiện tại đã bị thay đổi.\n Bạn có muốn cất không?"

#: kiconedit.cpp:271
msgid "New &Window"
msgstr "Cửa sổ &mới"

#: kiconedit.cpp:273
msgid "New window\n\nOpens a new Icon Editor window."
msgstr "Cửa sổ mới\n\n Mở thành một cửa sổ edit icon mới"

#: kiconedit.cpp:281
msgid "New\n\nCreate a new icon, either from a template or by specifying the size"
msgstr "Mới\n\nTạo một icon mới, từ template hay từ mẫu đã chỉ định"

#: kiconedit.cpp:287
msgid "Open\n\nOpen an existing icon"
msgstr "Mở\n\n Mở icon có sẵn"

#: kiconedit.cpp:301
msgid "Save\n\nSave the current icon"
msgstr "Cất\n\n Cất icon hiện tại"

#: kiconedit.cpp:312
msgid "Print\n\nOpens a print dialog to let you print the current icon."
msgstr "In\n\n Mở một hộp thoại cho phép bạn in icon hiện tại."

#: kiconedit.cpp:326
msgid "Cut\n\nCut the current selection out of the icon\n\n(Tip: You can make both rectangular and circular selections)"
msgstr "Cắt\n\n Cut phần chọn của icon hiện tại\n\n( Mẹo: Có thể chọn hình chữ nhật hay elip)"

#: kiconedit.cpp:333
msgid "Copy\n\nCopy the current selection out of the icon\n\n(Tip: You can make both rectangular and circular selections)"
msgstr ""

#: kiconedit.cpp:340
msgid "Paste\n\nPaste the contents of the clipboard into the current icon.\n\nIf the contents are larger than the current icon you can paste them in a new window.\n\n(Tip: Select \"Paste transparent pixels\" in the configuration dialog if you also want to paste transparency.)"
msgstr ""

