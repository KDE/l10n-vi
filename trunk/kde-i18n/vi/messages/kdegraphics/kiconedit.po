#: main.cpp:39
msgid "KDE Icon Editor"
msgstr "KDE Icon Editor"

#: main.cpp:43
msgid "Icon file(s) to open"
msgstr "File icon sẽ mở"

#: main.cpp:96
msgid "KIconEdit"
msgstr "KIconEdit"

#: kiconedit.cpp:168 kiconeditslots.cpp:94 kiconeditslots.cpp:146
#: kiconeditslots.cpp:334
msgid ""
"The current file has been modified.\n"
"Do you want to save it?"
msgstr ""
"File hiện tại đã bị thay đổi.\n"
" Bạn có muốn cất không?"

#: kiconedit.cpp:272
msgid "New &Window"
msgstr "Cửa sổ &mới"

#: kiconedit.cpp:274
msgid ""
"New window\n"
"\n"
"Opens a new Icon Editor window."
msgstr ""
"Cửa sổ mới\n"
"\n"
" Mở thành một cửa sổ edit icon mới"

#: kiconedit.cpp:282
msgid ""
"New\n"
"\n"
"Create a new icon, either from a template or by specifying the size"
msgstr ""
"Mới\n"
"\n"
"Tạo một icon mới, từ template hay từ mẫu đã chỉ định"

#: kiconedit.cpp:288
msgid ""
"Open\n"
"\n"
"Open an existing icon"
msgstr ""
"Mở\n"
"\n"
" Mở icon có sẵn"

#: kiconedit.cpp:302
msgid ""
"Save\n"
"\n"
"Save the current icon"
msgstr ""
"Cất\n"
"\n"
" Cất icon hiện tại"

#: kiconedit.cpp:313
msgid ""
"Print\n"
"\n"
"Opens a print dialog to let you print the current icon."
msgstr ""
"In\n"
"\n"
" Mở một hộp thoại cho phép bạn in icon hiện tại."

#: kiconedit.cpp:327
msgid ""
"Cut\n"
"\n"
"Cut the current selection out of the icon\n"
"\n"
"(Tip: You can make both rectangular and circular selections)"
msgstr ""
"Cắt\n"
"\n"
" Cut phần chọn của icon hiện tại\n"
"\n"
"( Mẹo: Có thể chọn hình chữ nhật hay elip)"

#: kiconedit.cpp:334
msgid ""
"Copy\n"
"\n"
"Copy the current selection out of the icon\n"
"\n"
"(Tip: You can make both rectangular and circular selections)"
msgstr ""

#: kiconedit.cpp:341
msgid ""
"Paste\n"
"\n"
"Paste the contents of the clipboard into the current icon.\n"
"\n"
"If the contents are larger than the current icon you can paste them in a new "
"window.\n"
"\n"
"(Tip: Select \"Paste transparent pixels\" in the configuration dialog if you "
"also want to paste transparency.)"
msgstr ""

#: kiconedit.cpp:350
msgid "Paste as &New"
msgstr ""

#: kiconedit.cpp:353
msgid "Clea&r"
msgstr ""

#: kiconedit.cpp:357
msgid "Rectangular Selection"
msgstr ""

#: kiconedit.cpp:359
msgid ""
"Select\n"
"\n"
"Select a rectangular section of the icon using the mouse."
msgstr ""

#: kiconedit.cpp:364
msgid "Circular Selection"
msgstr ""

#: kiconedit.cpp:366
msgid ""
"Select\n"
"\n"
"Select a circular section of the icon using the mouse."
msgstr ""

#: kiconedit.cpp:376
msgid "&Resize"
msgstr ""

#: kiconedit.cpp:378
msgid ""
"Resize\n"
"\n"
"Smoothly resizes the icon while trying to preserve the contents"
msgstr ""

