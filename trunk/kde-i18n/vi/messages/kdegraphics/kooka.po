msgid "Optical Character Recognition finished"
msgstr "Hoàn thành Nhận dạng kí tự "

#: kocrfindia.cpp:50
msgid "Open in Kate"
msgstr "Mở trong Kate"

#: kocrfindia.cpp:61
msgid "<B>Optical Character Recognition Results</B>"
msgstr "<B>Kết quả nhận dạng kí tự </B>"

#: kocrstartdia.cpp:47
msgid "Optical Character Recognition"
msgstr "Nhận dạng kí tự"

#: kocrstartdia.cpp:48
msgid "Start OCR"
msgstr "Khởi động OCR"

#: kocrstartdia.cpp:61
msgid "<B>Starting Optical Character Recognition</B><P>Kooka uses <I>gocr</I>, an Open Source project, for optical character recognition.<P>The author of gocr is <B>Joerg Schulenburg</B><BR>For more information about gocr see <A HREF=http://jocr.sourceforge.net>http://jocr.sourceforge.net</A>"
msgstr ""
"<B>Khởi động Nhận dạng kí tự </B> "
"<P>Kooka dùng <I>gocr</I>, một dự án Mã Nguồn Mở cho việc nhận dạng optical character<P> "
"Tác giả của  gocr là <B>Joerg Schulenburg</B><BR> Để có thêm thông tin về gocr, xem "
" <A HREF=http://jocr.sourceforge.net>http://jocr.sourceforge.net</A>"

#: kocrstartdia.cpp:77
msgid "Path to 'gocr' binary: "
msgstr "Đường dẫn tới 'gocr'"

#: kocrstartdia.cpp:92
msgid "Enter the path to gocr, the optical-character-recognition command line tool."
msgstr "Nhập đường dẫn tới gocr"

#: kocrstartdia.cpp:107
msgid "&Gray level"
msgstr "Mức độ &gray"

#: kocrstartdia.cpp:112
msgid "The numeric value gray pixels are \nconsidered to be black.\n\nDefault is 160"
msgstr "Giá trị số gray pixel \n được coi là đen \n\n. Mặc định là 160"

#: kocrstartdia.cpp:114
msgid "&Dust size"
msgstr "Cỡ &Dust"

#: kocrstartdia.cpp:119
msgid "Clusters smaller than this value\nwill be considered to be dust and \nremoved from the image.\n\nDefault is 10"
msgstr "Cluster nhỏ hơn giá trị này \n sẽ được coi là dust và \n bị xoá khỏi ảnh. \n\n Mặc định là 10"

#: kocrstartdia.cpp:121
msgid "&Space width"
msgstr "Chiều rộng &khoảng trống"

#: kocrstartdia.cpp:125
msgid "Spacing between characters.\n\nDefault is 0 what means autodetection"
msgstr "Khoảng trống giữa các kí tự.\n\n Mặc định là 0 và nghĩa là tự detect"

#: kocrstartdia.cpp:172
msgid "The path does not lead to the gocr-binary.\nPlease check your installation and/or install gocr."
msgstr "Đường dẫn tới chương trình gocr.\n Xin kiểm tra lại sự cài đặt của bạn và gocr."

#: kocrstartdia.cpp:174
msgid "OCR software not found"
msgstr "Không tìm thấy chương trình OCR"

#: kocrstartdia.cpp:183
msgid "gocr exists, but is not executable.\nPlease check your installation and/or install gocr properly."
msgstr "gocr tồn tại, nhưng không thực thi được\n Xin kiểm tra lại quá trình cài đặt."

#: kocrstartdia.cpp:185
msgid "OCR software not executable"
msgstr "Không thể chạy được phần mềm OCR"

