msgid "L&ight: convert to strict (X)HTML"
msgstr "L&ight: hoán chuyển thành strict (X)HTML"

#: rc.cpp:8
msgid ""
"Convert mainly the document structure (Recommended for exporting to browsers "
"with limited capabilities)"
msgstr "Hoán chuyển phần chính của cấu trúc tài liệu ( Khuyến nghị cho các trình duyệt cũ, ít chức năng)"

#: rc.cpp:9
msgid "&Basic: convert to transitional (X)HTML"
msgstr "&Cơ bản: Hoán chuyển thành transitional (X)HTML"

#: rc.cpp:10
msgid ""
"Convert most of the document (Recommended for re-importing in KWord or for "
"exporting to older browsers)"
msgstr ""
"Hoán chuyển hầu hết tài liệu ( Khuyến nghị cho việc nhập lại trong KWord hay "
"cho việc xuất ra các trình duyệt cũ)"

#: rc.cpp:11
msgid "&Enhanced: convert to (X)HTML with CSS"
msgstr "&Cao cấp: hoán chuyển thành (X)HTML với CSS"

#: rc.cpp:12
msgid ""
"Convert as much as possible of the KWord document (Recommended for exporting "
"to other modern word processors or to modern browsers)"
msgstr ""
"Hoán chuyển càng nhiều càng tốt tài liệu KWord( Khuyến nghị cho việc "
"xuất ra các trihf xử lí văn bản hiện đại hay trình duyệt hiện  đại)"

