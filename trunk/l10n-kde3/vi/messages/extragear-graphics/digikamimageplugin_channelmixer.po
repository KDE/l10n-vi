msgid "&Colors"
msgstr "&Màu sắc"

#~ msgid "Over exposure indicator"
#~ msgstr "Cái chỉ sự phơi quá lâu"

#~ msgid "<p>If you enable this option, over-exposed pixels from the target image preview will be over-colored. This will not have an effect on the final rendering."
#~ msgstr "<p>Nếu bạn bật tùy chọn này, mỗi điểm ảnh quá phơi năng từ ảnh đích sẽ có quá màu. Cách hiển thị này sẽ không có tác động khi vẽ cuối cùng."
