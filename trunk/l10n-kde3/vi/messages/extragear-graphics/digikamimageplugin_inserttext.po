#: fontchooserwidget.cpp:84
msgid "Here you can choose the font to be used."
msgstr "Ở đây bạn có thể chọn phông chữ cần dùng."

#: fontchooserwidget.cpp:110
msgid "Change font family?"
msgstr "Thay đổi nhóm phông chữ không?"

#: fontchooserwidget.cpp:112
msgid "Enable this checkbox to change the font family settings."
msgstr "Đánh dấu trong hộp chọn này để thay đổi thiết lập nhóm phông chữ."

#: fontchooserwidget.cpp:120
msgid "Font:"
msgstr "Phông chữ :"

#: fontchooserwidget.cpp:130 fontchooserwidget.cpp:147
msgid "Style:"
msgstr "Kiểu dáng:"

#: fontchooserwidget.cpp:137
msgid "Change font style?"
msgstr "Thay đổi kiểu dáng phông chữ không?"

#: fontchooserwidget.cpp:139
msgid "Enable this checkbox to change the font style settings."
msgstr "Đánh dấu trong hộp chọn này để thay đổi thiết lập kiểu dáng phông chữ."

#: fontchooserwidget.cpp:158
msgid "Size"
msgstr "Cỡ"

#: fontchooserwidget.cpp:165
msgid "Change font size?"
msgstr "Thay đổi kích cỡ của phông chữ không?"

#: fontchooserwidget.cpp:167
msgid "Enable this checkbox to change the font size settings."
msgstr ""
"Đánh dấu trong hộp chọn này để thay đổi thiết lập kích cỡ của phông chữ."

#: fontchooserwidget.cpp:175
msgid "Size:"
msgstr "Cỡ :"

#: fontchooserwidget.cpp:190
msgid "Here you can choose the font family to be used."
msgstr "Ở đây bạn có thể chọn nhóm phông chữ cần dùng."

#: fontchooserwidget.cpp:211
msgid "Here you can choose the font style to be used."
msgstr "Ở đây bạn có thể chọn kiểu dáng phông chữ cần dùng."

#: fontchooserwidget.cpp:214 fontchooserwidget.cpp:473
#: fontchooserwidget.cpp:475 fontchooserwidget.cpp:486
#: fontchooserwidget.cpp:487
msgid "Regular"
msgstr "Chuẩn"

#: fontchooserwidget.cpp:216
msgid "Bold"
msgstr "Đậm"

#: fontchooserwidget.cpp:217
msgid "Bold Italic"
msgstr "Đậm nghiêng"

#: fontchooserwidget.cpp:234
msgid "Relative"
msgstr "Tương đối"

#: fontchooserwidget.cpp:236
msgid "Font size<br><i>fixed</i> or <i>relative</i><br>to environment"
msgstr ""
"Kích cỡ phông chữ"
"<br><i>cố định</i> hay <i>tương đối</i>"
"<br>với môi trường"

#: fontchooserwidget.cpp:238
msgid ""
"Here you can switch between fixed font size and font size to be calculated "
"dynamically and adjusted to changing environment (e.g. widget dimensions, paper "
"size)."
msgstr ""
"Ở đây bạn có thể chuyển đổi giữa kích cỡ phông chữ cố định và kích cỡ phông chữ "
"sẽ được tính tự động và điều chỉnh với môi trường thay đổi (v.d. các chiều của "
"ô điều khiển, kích cỡ giấy)."

#: fontchooserwidget.cpp:263
msgid "Here you can choose the font size to be used."
msgstr "Ở đây bạn có thể chọn kích cỡ phông chữ cần dùng."

#: fontchooserwidget.cpp:288
msgid "Actual Font"
msgstr "Phông chữ thật"

#: imageeffect_inserttext.cpp:76 imageeffect_inserttext.cpp:337
msgid "Insert Text"
msgstr "Chèn đoạn"

#: imageeffect_inserttext.cpp:78
msgid "A digiKam image plugin for inserting text on a photograph."
msgstr "Bổ sung ảnh digiKam để chèn đoạn vào ảnh chụp."

#: imageeffect_inserttext.cpp:85
msgid "Author and maintainer"
msgstr "Tác giả và nhà duy trì"

#: imageeffect_inserttext.cpp:88
msgid "Developer"
msgstr "Nhà phát triển"

#: imageeffect_inserttext.cpp:100
#, fuzzy
msgid ""
"<p>This is the preview of the text inserted to the image. You can use the mouse "
"to move the text to the right location."
msgstr ""
"<p>Ở đây có ô xem thử đoạn được chèn vào ảnh. Bạn có khả năng dùng con chuột để "
"di chuyển đoạn tới vị trí đúng."

#: imageeffect_inserttext.cpp:112
#, fuzzy
msgid "<p>Here, enter the text you want to insert in your image."
msgstr "<p>Ở đây hãy nhập đoạn cần chèn vào ảnh."

#: imageeffect_inserttext.cpp:118
msgid "<p>Here you can choose the font to be used."
msgstr "<p>Ở đây bạn có thể chọn phông chữ cần dùng."

#: imageeffect_inserttext.cpp:130
msgid "Align text to the left"
msgstr "Canh lề đoạn bên trái"

#: imageeffect_inserttext.cpp:136
msgid "Align text to the right"
msgstr "Canh lề đoạn bên phải"

#: imageeffect_inserttext.cpp:142
msgid "Align text to center"
msgstr "Canh lề đoạn giữa"

#: imageeffect_inserttext.cpp:148
msgid "Align text to a block"
msgstr "Canh lề đoạn theo khối"

#: imageeffect_inserttext.cpp:156
msgid "Rotation:"
msgstr "Độ xoay:"

#: imageeffect_inserttext.cpp:158
msgid "None"
msgstr "Không có"

#: imageeffect_inserttext.cpp:159
msgid "90 Degrees"
msgstr "90º"

#: imageeffect_inserttext.cpp:160
msgid "180 Degrees"
msgstr "180º"

#: imageeffect_inserttext.cpp:161
msgid "270 Degrees"
msgstr "270º"

#: imageeffect_inserttext.cpp:162
msgid "<p>Select here the text rotation to use."
msgstr "<p>Ở đây hãy chọn độ xoay đoạn cần dùng."

#: imageeffect_inserttext.cpp:168
msgid "Color:"
msgstr "Màu :"

#: imageeffect_inserttext.cpp:170
msgid "<p>Set here the font color to use."
msgstr "<p>Ở đây hãy chọn màu phông chữ cần dùng."

#: imageeffect_inserttext.cpp:176
msgid "Add border"
msgstr "Thêm viền"

#: imageeffect_inserttext.cpp:177
msgid "Add a solid border around text using current text color"
msgstr "Thêm một viền đặc chung quanh đoạn, dùng màu chữ hiện thời."

#: imageeffect_inserttext.cpp:179
msgid "Semi-transparent"
msgstr "Bán trong suốt"

#: imageeffect_inserttext.cpp:180
msgid "Use semi-transparent text background under image"
msgstr "Đặt nền chữ bán trong suốt nằm dưới ảnh."

#: imageeffect_inserttext.cpp:237
msgid "Enter your text here!"
msgstr "Hãy nhập đoạn vào đây !"

#: imageplugin_inserttext.cpp:42
msgid "Insert Text..."
msgstr "Chèn đoạn..."

#: imageplugin_inserttext.cpp:63
msgid "Insert Text on Photograph"
msgstr "Chèn đoạn vào ảnh chụp"

