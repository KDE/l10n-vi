#: imageeffect_raindrop.cpp:59
msgid "Raindrops"
msgstr "Giọt mưa"

#: imageeffect_raindrop.cpp:61
msgid "A digiKam image plugin to add raindrops to an image."
msgstr "Bổ sung ảnh digiKam để thêm giọt mưa vào ảnh."

#: imageeffect_raindrop.cpp:68
msgid "Author and maintainer"
msgstr "Tác giả và nhà duy trì"

#: imageeffect_raindrop.cpp:71
msgid "Raindrops algorithm"
msgstr "Thuật toán giọt mưa"

#: imageeffect_raindrop.cpp:74
msgid "Developer"
msgstr "Nhà phát triển"

#: imageeffect_raindrop.cpp:79
msgid ""
"<p>This is the preview of the Raindrop effect."
"<p>Note: if you have previously selected an area in the editor, this will be "
"unaffected by the filter. You can use this method to disable the Raindrops "
"effect on a human face, for example."
msgstr ""
"<p>Ở đây có ô xem thử hiệu ứng Giọt mưa."
"<p>Ghi chú : nếu bạn đã chọn vùng nào bằng bộ sửa đổi trước này, nó sẽ không do "
"bộ lọc tác động. Bạn có thể dùng phương pháp này để tắt hiệu ứng Giọt mưa trên "
"mặt của người, lấy thí dụ."

#: imageeffect_raindrop.cpp:89
msgid "Drop size:"
msgstr "Cỡ giọt:"

#: imageeffect_raindrop.cpp:94
msgid "<p>Set here the raindrops' size."
msgstr "<p>Ở đây hãy đặt kích cỡ của giọt mưa."

#: imageeffect_raindrop.cpp:101
msgid "Number:"
msgstr "Số :"

#: imageeffect_raindrop.cpp:106
msgid "<p>This value controls the maximum number of raindrops."
msgstr "<p>Giá trị này điều khiển số giọt mưa tối đa."

#: imageeffect_raindrop.cpp:113
msgid "Fish eyes:"
msgstr "Mắt cá:"

#: imageeffect_raindrop.cpp:118
msgid "<p>This value is the fish-eye-effect optical distortion coefficient."
msgstr "<p>Giá trị này là hệ số sự méo mó quang mắt cá."

#: imageeffect_raindrop.cpp:249
msgid "RainDrop"
msgstr "Giọt mưa"

#: imageplugin_raindrop.cpp:42
msgid "Raindrops..."
msgstr "Giọt mưa..."

#: imageplugin_raindrop.cpp:62
msgid "Add Raindrops to Photograph"
msgstr "Thêm giọt mưa vào ảnh chụp"

