msgid "Kst: a data viewing program."
msgstr "Kst: chương trình xem dữ liệu."

#: src/kst/main.cpp:55
msgid "Field for Y axis (multiple allowed)"
msgstr "Trường cho trục Y (cho phép nhập nhiều)"

