#: tips.cpp:3
msgid ""
"<h2>\n"
"<img src=\"hicolor/32x32/apps/showimg.png\">\n"
"&nbsp;Welcome to ShowImg\n"
"</h2>\n"
"<p>\n"
"You can check for a new version at the\n"
"<center><a href=\"http://www.jalix.org/projects/showimg\">"
"ShowImg project page</a></center>\n"
"</p>\n"
msgstr "<h2>\n"
"<img src=\"hicolor/32x32/apps/showimg.png\">\n"
"&nbsp;Chào mừng bạn dùng ShowImg\n"
"</h2>\n"
"<p>\n"
"Có thể kiểm tra có phiên bản mới chưa ở\n"
"<center><a href=\"http://www.jalix.org/projects/showimg\">"
"trang dự án ShowImg</a></center>\n"
"</p>\n"

#: tips.cpp:15
msgid ""
"<p>...that you can <b>rename</b> your images using 'Tools' -> "
"<img src=\"../apps/showimg/icons/hicolor/16x16/actions/item_rename.png\" "
"width=\"16\" height=\"16\">&nbsp;'Batch&nbsp;rename'?</p>\n"
msgstr "<p>...rằng bạn có thể <b>thay đổi tên</b> của ảnh bằng « Công cụ > "
"<img src=\"../apps/showimg/icons/hicolor/16x16/actions/item_rename.png\" "
"width=\"16\" height=\"16\">&nbsp;Thay tên bó » không?</p>\n"

#: tips.cpp:20
msgid ""
"<p>...that you can search <b>similar</b> images by using 'Tools' -> "
"'Find&nbsp;images' -> 'Similar&nbsp;images'?</p>\n"
msgstr "<p>...rằng bạn có thể tìm kiếm các ảnh <b>tương tự</b> bằng « Công cụ > "
"Tìm ảnh > Ảnh tương tự » không?</p>\n"

#: tips.cpp:25
msgid ""
"<p>...that you can <b>convert</b> image format by using 'Tools' -> 'Convert' -> "
"'Format'?</p>\n"
msgstr "<p>...rằng bạn có thể <b>chuyển đổi</b> image format by using 'Tools' -> "
"'Convert' -> 'Format'?</p>\n"

#: tips.cpp:30
msgid ""
"<p>\n"
"...that ShowImg can use the <b><a href=\"http://digikam.sourceforge.net/\">"
"digikam</a> plugins</b>?\n"
"</p>\n"
"<p>Use 'Setting' -> 'Configure&nbsp;showimg' -> 'Plugins' to choose plugins you "
"want to enable.\n"
"</p>\n"
"<br>\n"
"<p>\n"
"You can see screenshots at the <a "
"href=\"http://digikam.sourceforge.net/plugins.html\">digikam plugins page</a>.\n"
"</p>\n"
msgstr "<p>\n"
"...rằng ShowImg có khả năng sử dụng các <b>phần bổ sung <a "
"href=\"http://digikam.sourceforge.net/\">digiKam</a></b> không?\n"
"</p>\n"
"<p>Dùng « Thiết lập > Cấu hình ShowImg > Phần bổ sung » để chọn những phần bổ "
"sung bạn muốn hiệu lực.\n"
"</p>\n"
"<br>\n"
"<p>\n"
"Cũng có các ảnh chụp màn hình ở <a "
"href=\"http://digikam.sourceforge.net/plugins.html\">"
"trang phần bổ sung digiKam</a>.\n"
"</p>\n"

#: tips.cpp:43
msgid ""
"<p>...that you can <b>extract images</b> in archives (<tt>.tar, .zip,...</tt>"
") using drag'n'drop?</p>\n"
msgstr "<p>...rằng bạn có thể <b>rút ảnh</b> ra kho nén (<tt>.tar, .zip,...</tt>"
") bằng kéo và thả không?</p>\n"

#: tips.cpp:48
msgid ""
"<p>...that you can <b>fit to screen</b> images using <img "
"src=\"../apps/showimg/icons/hicolor/32x32/actions/viewmag_enlarge.png\" "
"width=\"16\" height=\"16\">&nbsp;'Shrink if bigger' and &nbsp;<img "
"src=\"../apps/showimg/icons/hicolor/32x32/actions/viewmag_shrink.png\" "
"width=\"16\" height=\"16\">'Enlarge if smaller'?</p>\n"
msgstr "<p>...rằng bạn có thể <b>vừa khít màn hình</b> các ảnh bằng <img "
"src=\"../apps/showimg/icons/hicolor/32x32/actions/viewmag_enlarge.png\" "
"width=\"16\" height=\"16\">&nbsp;« Thu nhỏ nếu lớn hơn » và &nbsp;<img "
"src=\"../apps/showimg/icons/hicolor/32x32/actions/viewmag_shrink.png\" "
"width=\"16\" height=\"16\">« Phóng to nếu nhỏ hơn » không?</p>\n"

#: tips.cpp:53
msgid ""
"<p>...that you can <b>rotate</b> image files using 'Tools' -> 'Convert' -> "
"<img src=\"../apps/showimg/icons/hicolor/16x16/actions/rotation_acw.png\" "
"width=\"16\" height=\"16\">&nbsp;'Rotate left' and <img "
"src=\"../apps/showimg/icons/hicolor/16x16/actions/rotation_cw.png\" "
"width=\"16\" height=\"16\">&nbsp;'Rotate right'?</p>\n"
"<p>Moreover, if the <tt>jpegtran</tt> program is installed then JPEG files "
"rotations are lossless rotation.</p>\n"
msgstr "<p>...rằng bạn có thể <b>quay</b> các tập tin ảnh bằng Công cụ > Chuyển đổi >"
"<img src=\"../apps/showimg/icons/hicolor/16x16/actions/rotation_acw.png\" "
"width=\"16\" height=\"16\">&nbsp;« Quay bên trái » và <img "
"src=\"../apps/showimg/icons/hicolor/16x16/actions/rotation_cw.png\" "
"width=\"16\" height=\"16\">&nbsp;« Quay bên phải » không?</p>\n"
"<p>Hơn nữa, nếu chương trình <tt>jpegtran</tt> cũng được cài đặt, tiến trình "
"quay tập tin JPEG không mất gì.</p>\n"

#: tips.cpp:59
msgid ""
"<p>...that using <b>albums</b> can drag'n'drop icons from the icon view to the "
"album icon to select and manage images?</p>\n"
msgstr "<p>...rằng khi dùng <b>tập ảnh</b>, bạn có thể kéo và thả biểu tượng từ ô xem "
"biểu tượng vào ô xem tập ảnh, để chọn và quản lý các ảnh không?</p>\n"

#: tips.cpp:64
msgid ""
"<p>...that you can download and <b>display <tt>ftp/http</tt> URL files</b>"
"? Just write the URL in the <img "
"src=\"crystalsvg/22x22/actions/locationbar_erase.png\" width=\"16\" "
"height=\"16\">&nbsp;location&nbsp;toolbar and press enter.</p>\n"
msgstr "<p>...rằng bạn có thể tải về và <b>hiển thị tập tin <tt>FTP/HTTP</tt></b> "
"không? Chỉ gõ URL vào thanh công cụ <img "
"src=\"crystalsvg/22x22/actions/locationbar_erase.png\" width=\"16\" "
"height=\"16\">&nbsp;địa điểm&nbsp;rồi bấm phím Enter.</p>\n"

#: tips.cpp:69
msgid ""
"<p>...that you can <b>browse 'offline' your CD</b> with pictures by viewing the "
"thumbnails?</p>\n"
"<p>Choose the tab <img src=\"crystalsvg/16x16/mimetypes/cdimage.png\"  "
"width=\"16\" height=\"16\">\n"
"&nbsp;'CD Archive View', click on 'New Archive CD' then select your CD-ROM "
"path: your CD will be parsed and the thumbnails will be store on your hard "
"drive and can be easily browsed.</p>\n"
msgstr "<p>...rằng bạn có thể <b>duyệt ngoại tuyến đĩa CD</b> "
"theo ảnh bằng cách xem ảnh mẫu không?</p>\n"
"<p>Chọn thẻ<img src=\"crystalsvg/16x16/mimetypes/cdimage.png\"  width=\"16\" "
"height=\"16\">\n"
"&nbsp;« Xem kho CD », nhấn vào « Kho CD mới » rồi chọn đường dẫn CD-ROM: đĩa CD "
"sẽ được phân tách và các ảnh mẫu sẽ được lưu vào đĩa cứng của bạn, để duyệt qua "
"dễ dàng.</p>\n"

#: tips.cpp:76
msgid ""
"<p>...that you can <b>managed you images by using 'Categories'</b>?</p>\n"
"<p>\n"
"Choose the tab <img src=\"hicolor/16x16/apps/kexi.png\" width=\"16\" "
"height=\"16\">&nbsp;'Category View'.\n"
"Categories allows to tag images in order to find then easily. One picture can "
"have several tags.\n"
"One category can have sub-categories, for example the category 'People' can "
"have sub-categories 'Friends' and 'Familly'.\n"
"</p>\n"
msgstr "<p>...rằng bạn có thể <b>quản lý các ảnh theo Loại</b> không?</p>\n"
"<p>\n"
"Chọn thẻ <img src=\"hicolor/16x16/apps/kexi.png\" width=\"16\" height=\"16\">"
"&nbsp;« Xem Loại ».\n"
"Các phân loại cho bạn có khả năng đặt thẻ trên ảnh, để tìm dễ dàng. Có thể đặt "
"vài thẻ khác nhau trên cùng một ảnh.\n"
"Phân loại cũng có thể có loại phụ, v.d. loại « Người » có thể có loại phụ « Bạn "
"bè » và « Gia đình ».\n"
"</p>\n"

#: tips.cpp:86
msgid ""
"<p>...that you can <b>mixed your category criteria</b>?</p>\n"
"<p>For example if you want to display all pictures of you friend 'Robert' in "
"'Paris', then check both 'Robert' and 'Paris' category checkbox items.</p>\n"
msgstr "<p>...rằng bạn có thể <b>hợp nhất các tiêu chuẩn phân loại</b> không?</p>\n"
"<p>Chẳng hạn, nếu bạn muốn hiển thị mọi ảnh của người bạn « Văn » trong « Hà "
"Nội », đánh dấu trong hộp bên cạnh cả hai phân loại « Văn » và « Hà Nội ».</p>\n"

#: tips.cpp:92
msgid ""
"<p>...that you can <b>give a note</b> to your pictures?</p>\n"
"<p>\n"
"  Drag'n'drop your pictures over the <img "
"src=\"crystalsvg/16x16/actions/flag.png\" width=\"16\" height=\"16\">"
"&nbsp;note you want to set."
"<br>\n"
"  Click on the note to display  all  pictures having this note."
"<br>\n"
"  Click on two notes to display all pictures having note setting between both "
"these notes.\n"
"</p>\n"
msgstr "<p>...rằng bạn có thể <b>ghi chép</b> vào ảnh không?</p>\n"
"<p>\n"
"  Kéo và thả ảnh ở trên <img src=\"crystalsvg/16x16/actions/flag.png\" "
"width=\"16\" height=\"16\">&nbsp;ghi chép bạn muốn đặt."
"<br>\n"
"Nhấn vào ghi chép để hiển thị mọi ảnh có ghi chép đó"
"<br>\n"
"Nhấn vào hai ghi chép để hiển thị mọi ảnh có đặt ghi chép ở giữa.\n"
"</p>\n"

#: tips.cpp:102
msgid ""
"<p>...that you can <b>search by name</b> images?</p>\n"
"<p>\n"
"Choose the tab <img src=\"hicolor/16x16/apps/kexi.png\" width=\"16\" "
"height=\"16\">&nbsp;'Category View' and click on <img "
"src=\"crystalsvg/16x16/actions/filefind.png\" width=\"16\" height=\"16\">"
"&nbsp;'Search\"'\n"
"</p>\n"
msgstr "<p>...rằng bạn có thể <b>tìm ảnh theo tên</b> không?</p>\n"
"<p>\n"
"Chọn thẻ <img src=\"hicolor/16x16/apps/kexi.png\" width=\"16\" height=\"16\">"
"&nbsp;« Xem loại » rồi nhấn vào <img "
"src=\"crystalsvg/16x16/actions/filefind.png\" width=\"16\" height=\"16\">"
"&nbsp;« Tìm kiếm »\n"
"</p>\n"

#: tips.cpp:110
msgid ""
"<p>...that you can <b>search by date</b> images?</p>\n"
"<p>\n"
"Choose the tab <img src=\"hicolor/16x16/apps/kexi.png\">"
"&nbsp;'Category View' and click on <img src=\"crystalsvg/16x16/apps/date.png\" "
"width=\"16\" height=\"16\">&nbsp;'Date'.\n"
"</p>\n"
msgstr "<p>...rằng bạn có thể <b>tìm kiếm ảnh theo ngày tháng</b> không?</p>\n"
"<p>\n"
"Chọn thẻ <img src=\"hicolor/16x16/apps/kexi.png\">&nbsp;« Xem loại » rồi nhấn "
"vào <img src=\"crystalsvg/16x16/apps/date.png\" width=\"16\" height=\"16\">"
"&nbsp;« Ngày ».\n"
"</p>\n"

#: tips.cpp:118
msgid ""
"<p>...that you can <b>mix all criteria</b> in <img "
"src=\"hicolor/16x16/apps/kexi.png\" width=\"16\" height=\"16\">"
"&nbsp;'Category View'?</p>\n"
"<p>\n"
"Just check all checkboxes you want to add and choose between <img "
"src=\"./hicolor/22x22/actions/raise.png\" width=\"16\" height=\"16\">"
"'Add' and <img src=\"./hicolor/22x22/actions/lower.png\" width=\"16\" "
"height=\"16\">'Or' in the toolbar to join them.\n"
"</p>\n"
msgstr "<p>...rằng bạn có thể <b>hợp nhất mọi tiêu chuẩn</b> "
"trong <img src=\"hicolor/16x16/apps/kexi.png\" width=\"16\" height=\"16\">"
"&nbsp;ô « Xem loại » không?</p>\n"
"<p>\n"
"Chỉ đánh dấu trong hộp bên cạnh mỗi mục bạn muốn thêm, rồi chọn trong hai tùy "
"chọn <img src=\"./hicolor/22x22/actions/raise.png\" width=\"16\" height=\"16\">"
"« Và » hay <img src=\"./hicolor/22x22/actions/lower.png\" width=\"16\" "
"height=\"16\">« Hoặc » trên thanh công cụ, để hợp nhất.\n"
"</p>\n"

#: tips.cpp:126
msgid ""
"<p>...that you can <b>copy</b> your selected files <b>"
"into the last directory</b> you move files by pressing '<b>F12</b>"
"' (default key)?</p>\n"
msgstr "<p>...rằng bạn có thể <b>sao chép</b> các tập tin đã chọn <b>"
"vào thư mục cuối</b> cùng vào đó bạn đã di chuyển tập tin, bằng cách bấm phím "
"chức năng <b>F12</b> (mặc định) không?</p>\n"

#: tips.cpp:131
msgid ""
"<p>...that you can <b>play video file<b> into showimg?</p>\n"
"<p>You can choose the embeded player in 'Configure'/'Configure "
"Showimg'/'Video'.</p>\n"
msgstr "<p>...rằng bạn có thể <b>phát tập tin ảnh động<b> bằng showimg không?</p>\n"
"<p>Bạn có thể chọn bộ xem nhúng bằng « Cấu hình > Cấu hình ShowImg > "
"Ảnh động ».</p>\n"

#: tips.cpp:137
msgid ""
"<p>...that you have read all the tooltips and you can contribute to ShowImg "
"(add feature, write documention, ...) by <a href='mailto:rgroult@jalix.org'>"
"contacting me</a> by email.</p>\n"
msgstr "<p>...rằng bạn đã đọc mọi mẹo công cụ, nhưng cũng có thể đóng góp cho ShowImg "
"(thêm tính năng, tạo tài liệu) bằng cách <a href='mailto:rgroult@jalix.org'>"
"liên lạc với tôi</a> bằng thư.</p>\n"
