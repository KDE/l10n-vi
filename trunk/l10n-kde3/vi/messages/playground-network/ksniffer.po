#: ksniffer.cpp:372
msgid "<b>Stop</b><br>Stop the packet-capture session."
msgstr "<b>Ngừng</b><br>Ngừng chạy phiên bắt gói tin."

#: ksniffer.cpp:377
msgid "<b>Print...</b><br>Print the packet-capture session."
msgstr "<b>In...</b><br>In ra phiên chạy bắt gói tin."

#: ksniffer.cpp:382
msgid "<b>Quit</b><br>Stop the packet-capture session and quit from KSniffer."
msgstr "<b>Thoát</b><br>Ngừng chạy phiên bắt gói tin rồi thoát khỏi KSniffer."

#: ksniffer.cpp:421 ksniffer.cpp:436
