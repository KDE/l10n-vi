msgstr "<b>In...</b><br>In ra phiên chạy bắt gói tin."

#: ksniffer.cpp:383
msgid "<b>Quit</b><br>Stop the packet-capture session and quit from KSniffer."
msgstr "<b>Thoát</b><br>Ngừng chạy phiên bắt gói tin rồi thoát khỏi KSniffer."

