#~ msgid "Case &sensitive"
#~ msgstr "&Phân biệt hoa/thường"

#~ msgid ""
#~ "<p>If enabled, the pattern matching will be case sensitive, otherwise not."
#~ "</p>"
#~ msgstr ""
#~ "<p>Bật thì cách khớp mẫu sẽ phân biệt chữ hoa/thường, không thì không.</p>"

