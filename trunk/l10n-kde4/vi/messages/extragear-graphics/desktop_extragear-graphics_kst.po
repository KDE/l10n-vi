msgid "Data Viewer"
msgstr "Bộ xem dữ liệu"

#: src/kst/x-kst.desktop:7
msgctxt "Comment"
msgid "Kst Data File"
msgstr "Tập tin dữ liệu Kst"

#: src/plugins/bin/kstobject_bin.desktop:8
msgctxt "Name"
msgid "Bin"
msgstr "Bin"

#: src/plugins/bin/kstobject_bin.desktop:21
msgctxt "Comment"
msgid ""
"Bins data into the given size bins.  Each bin contains the mean of the "
"elements belonging to the bin."
msgstr ""
"Để dữ liệu vào các thùng có kích cỡ đã cho. Mỗi thùng chứa số trung bình các "
"yếu tố thuộc về thùng đó."

#: src/plugins/chop/kstobject_chop.desktop:8
msgctxt "Name"
msgid "Chop"
msgstr "Chop"

#: src/plugins/chop/kstobject_chop.desktop:21
msgctxt "Comment"
msgid "Chops a given data set into odd, even, difference, and Index data sets."
msgstr ""
"Cắt một tập dữ liệu đã cho ra các tập dữ liệu kiểu lẻ, chẵn, hiệu và chỉ mục."

#: src/plugins/convolution/convolve/kstobject_convolve.desktop:8
msgctxt "Name"
msgid "Convolution"
msgstr "Quấn lại"

#: src/plugins/convolution/convolve/kstobject_convolve.desktop:22
msgctxt "Comment"
msgid "Generates the convolution of one vector with another."
msgstr "Tạo ra sự quấn lại của véc-tơ này với véc-tơ khác."

#: src/plugins/convolution/deconvolve/kstobject_deconvolve.desktop:8
msgctxt "Name"
msgid "Deconvolution"
msgstr "Bỏ quấn lại"

#: src/plugins/convolution/deconvolve/kstobject_deconvolve.desktop:23
msgctxt "Comment"
msgid "Generates the deconvolution of one vector with another."
msgstr "Tạo ra sự bỏ quấn lại của véc-tơ này với véc-tơ khác."

#: src/plugins/correlation/autocorrelation/kstobject_autocorrelate.desktop:8
msgctxt "Name"
msgid "Auto-correlation"
msgstr "Tự động tương quan"

#: src/plugins/correlation/autocorrelation/kstobject_autocorrelate.desktop:22
msgctxt "Comment"
msgid "Generates the auto-correlation of a vector."
msgstr "Tạo ra sự tương quan tự động của véc-tơ."

#: src/plugins/correlation/crosscorrelation/kstobject_crosscorrelate.desktop:8
msgctxt "Name"
msgid "Cross-correlation"
msgstr "Tương quan chéo"

#: src/plugins/correlation/crosscorrelation/kstobject_crosscorrelate.desktop:22
msgctxt "Comment"
msgid "Generates the correlation of one vector with another."
msgstr "Tạo ra sự tương quan chéo của véc-tơ này với véc-tơ khác."

#: src/plugins/crossspectrum/kstobject_crossspectrum.desktop:8
msgctxt "Name"
msgid "Cross Power Spectrum"
msgstr "Quang phổ lũy thừa chéo"

#: src/plugins/crossspectrum/kstobject_crossspectrum.desktop:21
msgctxt "Comment"
msgid "Generates the cross power spectrum of one vector with another."
msgstr "Tạo ra quang phổ lũi thừa chéo của véc-tơ này với véc-tơ khác."

#: src/plugins/cumulative_sum/kstobject_cumulative_sum.desktop:8
msgctxt "Name"
msgid "Cumulative sum (integral)"
msgstr "Tổng lũy tích (tích phân)"

#: src/plugins/cumulative_sum/kstobject_cumulative_sum.desktop:23
msgctxt "Comment"
msgid "Computes the cumulative sum (integral) of the input vector."
msgstr "Tính tổng lũy tích (tích phân) cũa véc-tơ nhập."

#: src/plugins/differentiation/kstobject_differentiation.desktop:8
msgctxt "Name"
msgid "Fixed-step differentiation"
msgstr "Vi phân bước cố định"

#: src/plugins/differentiation/kstobject_differentiation.desktop:21
msgctxt "Comment"
msgid "Computes the discrete derivative of an input vector"
msgstr "Tính tổng đạo hàm rời rạc cũa véc-tơ nhập."

#: src/plugins/discretizing_filters/kstobject_discretizing_filters.desktop:8
msgctxt "Name"
msgid "Generic filter"
msgstr "Bộ lọc giống loài"

#: src/plugins/discretizing_filters/kstobject_discretizing_filters.desktop:23
msgctxt "Comment"
msgid "Generates a discrete filter from a continuous-time definition."
msgstr "Tạo ra một bộ lọc rời rạc từ lời định nghĩa thời gian liên tục."

#: src/plugins/effective_bandwidth/kstobject_effbandwidth.desktop:8
msgctxt "Name"
msgid "Effective Bandwidth"
msgstr "Băng thông hiệu dụng"

#: src/plugins/effective_bandwidth/kstobject_effbandwidth.desktop:22
msgctxt "Comment"
msgid "Calculates effective bandwidth from an amplitude spectrum."
msgstr "Tính băng thông hiệu dụng từ quang phổ biên tần."

#: src/plugins/interpolations/akima/kstobject_akima.desktop:8
msgctxt "Name"
msgid "Interpolation akima spline"
msgstr "Chốt trục akima nội suy"

#: src/plugins/interpolations/akima/kstobject_akima.desktop:21
msgctxt "Comment"
msgid "Generates a non-rounded Akima interpolation for a set of data."
msgstr "Tạo ra sự nội suy Akima khác tròn cho một tập dữ liệu."

#: src/plugins/interpolations/akima_periodic/kstobject_akima_periodic.desktop:8
msgctxt "Name"
msgid "Interpolation akima spline periodic"
msgstr "Chốt trục akima nội suy định kỳ"

#: src/plugins/interpolations/akima_periodic/kstobject_akima_periodic.desktop:21
msgctxt "Comment"
msgid "Generates a non-rounded periodic Akima interpolation for a set of data."
msgstr "Tạo ra sự nội suy Akima định kỳ khác tròn cho một tập dữ liệu."

#: src/plugins/interpolations/cspline/kstobject_cspline.desktop:8
msgctxt "Name"
msgid "Interpolation cubic spline"
msgstr "Chốt trục bậc ba nội suy"

#: src/plugins/interpolations/cspline/kstobject_cspline.desktop:21
msgctxt "Comment"
msgid "Generates a spline interpolation for a set of data."
msgstr "Tạo ra sự nội suy chốt trục cho một tập dữ liệu."

#: src/plugins/interpolations/cspline_periodic/kstobject_cspline_periodic.desktop:8
msgctxt "Name"
msgid "Interpolation cubic spline periodic"
msgstr "Chốt trục bậc ba nội suy định kỳ"

#: src/plugins/interpolations/cspline_periodic/kstobject_cspline_periodic.desktop:21
msgctxt "Comment"
msgid "Generates a cubic spline interpolation for a set of data."
msgstr "Tạo ra sự nội suy chốt trục bậc ba cho một tập dữ liệu."

#: src/plugins/interpolations/linear/kstobject_linear.desktop:8
msgctxt "Name"
msgid "Interpolation linear"
msgstr "Nội suy tuyến tính"

#: src/plugins/interpolations/linear/kstobject_linear.desktop:22
msgctxt "Comment"
msgid "Generates a linear interpolation for a set of data."
msgstr "Tạo ra sự nội suy tuyến tính cho một tập dữ liệu."

#: src/plugins/interpolations/polynomial/kstobject_polynomial.desktop:8
msgctxt "Name"
msgid "Interpolation polynomial"
msgstr "Nội suy đa thức"

#: src/plugins/interpolations/polynomial/kstobject_polynomial.desktop:21
msgctxt "Comment"
msgid "Generates a polynomial interpolation for a set of data."
msgstr "Tạo ra sự nội suy đa thức cho một tập dữ liệu."

#: src/plugins/linefit/kstobject_linefit.desktop:8
msgctxt "Name"
msgid "Line Fit"
msgstr "Vừa dòng"

#: src/plugins/linefit/kstobject_linefit.desktop:22
msgctxt "Comment"
msgid "Generates a line of best fit for a set of data."
msgstr "Tạo ra dòng vừa nhất cho một tập dữ liệu."

#: src/plugins/noise_addition/kstobject_noise_addition.desktop:8
msgctxt "Name"
msgid "Noise addition"
msgstr "Thêm nhiễu"

#: src/plugins/noise_addition/kstobject_noise_addition.desktop:22
msgctxt "Comment"
msgid ""
"Adds Gaussian noise to a set of data, of a specified standard deviation."
msgstr "Thêm nhiễu kiểu Gauss vào một tập dữ liệu có độ lệch riêng."

#: src/plugins/periodogram/kstobject_periodogram.desktop:8
msgctxt "Name"
msgid "Periodogram"
msgstr "Chu kỳ đồ"

#: src/plugins/periodogram/kstobject_periodogram.desktop:19
msgctxt "Comment"
msgid ""
"Takes the periodogram of a given data set. The data is not assumed to be "
"sampled at equal time intervals."
msgstr ""
"Tính chu kỳ đồ của một tập dữ liệu đã cho. Không giả sử dữ liệu được lấy mẫu "
"sau mỗi khoảng thời gian."

#: src/plugins/phase/kstobject_phase.desktop:8
msgctxt "Name"
msgid "Phase"
msgstr "Giải đoạn"

#: src/plugins/phase/kstobject_phase.desktop:23
msgctxt "Comment"
msgid "Phases a given data set to the specified period and zero phase."
msgstr "Chuyển một tập dữ liệu đã sang thời kỳ và giải đoạn số không riêng."

#: src/plugins/shift/kstobject_shift.desktop:8
msgctxt "Name"
msgid "Shift"
msgstr "Dịch"

#: src/plugins/shift/kstobject_shift.desktop:23
msgctxt "Comment"
msgid "Shifts (and truncates) a vector."
msgstr "Dịch (và cắt ngắn) một véc-tơ."

#: src/plugins/statistics/kstobject_statistics.desktop:8
msgctxt "Name"
msgid "Statistics"
msgstr "Thống kê"

#: src/plugins/statistics/kstobject_statistics.desktop:26
msgctxt "Comment"
msgid "Determines statistics for a given data set."
msgstr "Tính thống kê cho một tập dữ liệu đã cho."

#: src/plugins/syncbin/kstobject_syncbin.desktop:8
msgctxt "Name"
msgid "Syncbin"
msgstr "Syncbin"

#: src/plugins/syncbin/kstobject_syncbin.desktop:19
msgctxt "Comment"
msgid ""
"Synchronously coadd vector Y into bins defined by vector X.  Like a 1D map."
msgstr ""
"Đồng thêm véc-tơ Y vào các thùng được xác định bằng véc-tơ X. Giống như sơ "
"đồ một chiều."

#: src/plugins/testplugin/kstobject_testplugin.desktop:8
msgctxt "Name"
msgid "Test Plugin"
msgstr "Bổ sung thử ra"

#: src/plugins/testplugin/kstobject_testplugin.desktop:25
msgctxt "Comment"
msgid "A test of new data object plugin system."
msgstr "Việc thử ra hệ thống bổ sung đối tượng mới."
