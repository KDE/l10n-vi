#: dviRenderer.cpp:448
msgid "Not all PostScript files could be embedded into your document."
msgstr "Không phải tất cả các tập tin PostScript có thể được nhúng vào tài liệu của bạn."

#: dviRenderer.cpp:451
msgid ""
"All external PostScript files were embedded into your document. You will "
"probably want to save the DVI file now."
msgstr "Tất cả các tập tin PostScript bên ngoài đã được nhúng vào tài liệu của bạn. Khuyên bạn lưu tập tin DVI ngay bây giờ."

#: dviRenderer.cpp:543
#, qt-format
msgid ""
"<qt><strong>File error.</strong> The specified file '%1' does not exist. "
"KDVI already tried to add the ending '.dvi'.</qt>"
msgstr "<qt><strong>Lỗi tập tin.</strong> Tập tin đã xác định « %1 » không tồn tại. KDVI đã thử thêm phần mở rộng « .dvi ».</qt>"

#: dviRenderer.cpp:545
msgid "File Error"
msgstr "Lỗi tập tin"

#: dviRenderer.cpp:556
#, qt-format
msgid ""
"<qt>Could not open file <nobr><strong>%1</strong></nobr> which has type "
"<strong>%2</strong>. KDVI can only load DVI (.dvi) files.</qt>"
msgstr "<qt>Không thể mở tập tin <nobr><strong>%1</strong></nobr> mà có kiểu <strong>%2</strong>. KDVI chỉ có khả năng nạp tập tin kiểu DVI (.dvi).</qt>"

#: dviRenderer.cpp:567
#, qt-format
msgid ""
"<qt>File corruption! KDVI had trouble interpreting the file <nobr><strong>%"
"1</strong></nobr>. Most likely this means that the DVI file is broken.</qt>"
msgstr "<qt>Tập tin bị hỏng. KDVI gặp khó khăn trong việc giải thích tập tin <nobr><strong>%"
"1</strong></nobr>. Rất có thể do tập tin DVI bị hỏng.</qt>"

#: dviRenderer.cpp:585
msgid ""
"<qt>File corruption. KDVI could not interprete your DVI file. This is most "
"commonly caused by a corrupted file.</qt>"
msgstr "<qt>Tập tin bị hỏng. KDVI không thể giải thích tập tin DVI của bạn. Vấn đề này thường do tập tin bị hỏng.</qt>"

#: dviRenderer.cpp:742
#, qt-format
msgid ""
"<qt>You have asked KDVI to locate the place in the DVI file which "
"corresponds to line %1 in the TeX-file <strong>%2</strong>. It seems, "
"however, that the DVI file does not contain the necessary source file "
"information. We refer to the manual of KDVI for a detailed explanation on "
"how to include this information. Press the F1 key to open the manual.</qt>"
msgstr "<qt>Bạn đã yêu cầu KDVI tìm nơi trong tập tin DVI mà tương ứng với dòng %1 trong tập tin TeX <strong>%2</strong>. Tuy nhiên, có vẻ là tập tin DVI này không chứa thông tin tập tin nguồn cần thiết. Xem sổ tay KDVI để tìm lời giảng chi tiết về phương pháp gộp thông tin này. Bấm phím chức năng F1 để mở sổ tay này.</qt>"

#: dviRenderer.cpp:747
#: dviRenderer.cpp:785
msgid "Could Not Find Reference"
msgstr "Không tìm thấy tham chiếu"

#: dviRenderer.cpp:783
#, qt-format
