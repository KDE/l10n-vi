#: dviRenderer.cpp:310
#: dviRenderer.cpp:587
msgid "DVI File Error"
msgstr "Lỗi tập tin DVI"

#: dviRenderer.cpp:364
msgid "KDVI: Information"
msgstr "KDVI: Thông tin"

#: dviRenderer.cpp:379
msgid ""
"<qt>This DVI file contains source file information. You may click into the "
"text with the middle mouse button, and an editor will open the TeX-source "
"file immediately.</qt>"
msgstr "<qt>Tập tin DVI này chứa thông tin tập tin nguồn. Bạn có thể nhấn-giữa vào văn bản để mở tập tin nguồn TeX bằng bộ sửa.</qt>"

#: dviRenderer.cpp:386
msgid "Do not show this message again"
msgstr "Đừng hiện thông điệp này lần nữa"

#: dviRenderer.cpp:388
