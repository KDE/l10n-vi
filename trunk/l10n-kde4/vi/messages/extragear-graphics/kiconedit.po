#, kde-format
msgid "Show &Grid"
msgstr "Hiện &lưới"

#: kiconedit.cpp:380
#, kde-format
msgid "Hide &Grid"
msgstr "Ẩn &lưới"

#: kiconedit.cpp:381
#, kde-format
msgid ""
"Show grid\n"
"\n"
"Toggles the grid in the icon edit grid on/off"
msgstr ""
"Hiện lưới\n"
"\n"
"Hiển thị hay ẩn lưới sửa biểu tượng."

#: kiconedit.cpp:388
#, kde-format
msgid "Color Picker"
msgstr "Bộ kén màu"

#: kiconedit.cpp:392
#, kde-format
msgid ""
"Color Picker\n"
"\n"
"The color of the pixel clicked on will be the current draw color"
msgstr ""
"Bộ kén màu\n"
"\n"
"Màu của điểm ảnh bị nhấn thì là màu vẽ đang dùng."

#: kiconedit.cpp:397
#, kde-format
msgid "Freehand"
msgstr "Bằng tay"

#: kiconedit.cpp:401
#, kde-format
msgid ""
"Free hand\n"
"\n"
"Draw non-linear lines"
msgstr ""
"Bằng tay\n"
"\n"
"Vẽ dòng khác tuyến"

#: kiconedit.cpp:408
#, kde-format
msgid "Rectangle"
msgstr "Chữ nhật"

#: kiconedit.cpp:412
#, kde-format
msgid ""
"Rectangle\n"
"\n"
"Draw a rectangle"
msgstr ""
"Chữ nhật\n"
"\n"
"Vẽ hình chữ nhật"

#: kiconedit.cpp:416
#, kde-format
msgid "Filled Rectangle"
msgstr "Chữ nhật đặc"

#: kiconedit.cpp:420
#, kde-format
msgid ""
"Filled rectangle\n"
"\n"
"Draw a filled rectangle"
msgstr ""
"Chữ nhật đặc\n"
"\n"
"Vẽ hình chữ nhật đặc"

#: kiconedit.cpp:424
#, kde-format
msgid "Circle"
msgstr "Tròn"

#: kiconedit.cpp:428
#, kde-format
msgid ""
"Circle\n"
"\n"
"Draw a circle"
msgstr ""
"Tròn\n"
"\n"
"Vẽ hình tròn"

#: kiconedit.cpp:432
#, kde-format
msgid "Filled Circle"
msgstr "Tròn đặc"

#: kiconedit.cpp:436
#, kde-format
msgid ""
"Filled circle\n"
"\n"
"Draw a filled circle"
msgstr ""
"Tròn đặc\n"
"\n"
"Vẽ hình tròn đặc"

#: kiconedit.cpp:440
#, kde-format
msgid "Ellipse"
msgstr "Bầu dục"

#: kiconedit.cpp:444
#, kde-format
msgid ""
"Ellipse\n"
"\n"
"Draw an ellipse"
msgstr ""
"Bầu dục\n"
"\n"
"Vẽ hình bầu dục"

#: kiconedit.cpp:448
#, kde-format
msgid "Filled Ellipse"
msgstr "Bầu dục đặc"

#: kiconedit.cpp:452
#, kde-format
msgid ""
"Filled ellipse\n"
"\n"
"Draw a filled ellipse"
msgstr ""
"Bầu dục đặc\n"
"\n"
"Vẽ hình bầu dục đặc"

#: kiconedit.cpp:456
#, kde-format
msgid "Spray"
msgstr "Phun"

#: kiconedit.cpp:460
#, kde-format
msgid ""
"Spray\n"
"\n"
"Draw scattered pixels in the current color"
msgstr ""
"Phun\n"
"\n"
"Vẽ các điểm ảnh rải rác theo màu đang dùng."

#: kiconedit.cpp:465
#, kde-format
msgid "Flood Fill"
msgstr "Tràn ngập tô đầy"

#: kiconedit.cpp:469
#, kde-format
msgid ""
"Flood fill\n"
"\n"
"Fill adjoining pixels with the same color with the current color"
msgstr ""
"Tràn ngập tô đầy\n"
"\n"
"Tô đầy các điểm ảnh bên cạnh theo màu đang dùng."

#: kiconedit.cpp:474
#, kde-format
msgid "Line"
msgstr "Dòng"

#: kiconedit.cpp:478
#, kde-format
msgid ""
"Line\n"
"\n"
"Draw a straight line vertically, horizontally or at 45 deg. angles"
msgstr ""
"Dòng\n"
"\n"
"Vẽ dòng thẳng theo chiều dọc, theo chiều ngang hay ở góc 45º."

#: kiconedit.cpp:483
#, kde-format
msgid "Eraser (Transparent)"
msgstr "Xoá (trong suốt)"

#: kiconedit.cpp:487
#, kde-format
msgid ""
"Erase\n"
"\n"
"Erase pixels. Set the pixels to be transparent\n"
"\n"
"(Tip: If you want to draw transparency with a different tool, first click on "
"\"Erase\" then on the tool you want to use)"
msgstr ""
"Xoá\n"
"\n"
"Xoá điểm ảnh. Đặt điểm ảnh là trong suốt.\n"
"\n"
"(Mẹo : nếu bạn muốn vẽ trong suốt bằng công cụ khác, trước tiên nhấn vào « "
"Xoá » rồi vào công cụ cần dùng.)"

# Rect is abbreviation for Rectangle / Rect là viết tắt cho Chữ nhật
#: kiconedit.cpp:494
#, kde-format
msgid "Rectangular Selection"
msgstr "Vùng chọn hình chữ nhật"

#: kiconedit.cpp:498
#, kde-format
msgid ""
"Select\n"
"\n"
"Select a rectangular section of the icon using the mouse."
msgstr ""
"Chọn\n"
"\n"
"Chọn một vùng hình chữ nhật của biểu tượng, bằng con chuột."

#: kiconedit.cpp:503
#, kde-format
msgid "Circular Selection"
msgstr "Vùng chọn hình tròn"

#: kiconedit.cpp:507
#, kde-format
msgid ""
"Select\n"
"\n"
"Select a circular section of the icon using the mouse."
msgstr ""
"Chọn\n"
"\n"
"Chọn một vùng hình tròn của biểu tượng, bằng con chuột."

#: kiconedit.cpp:535
#, kde-format
msgid ""
"Statusbar\n"
"\n"
"The statusbar gives information on the status of the current icon. The "
"fields are:\n"
"\n"
"\t- Application messages\n"
"\t- Cursor position\n"
"\t- Size\n"
"\t- Zoom factor\n"
"\t- Number of colors"
msgstr ""
"Thanh trạng thái\n"
"\n"
"Thanh trạng thái cung cấp thông tin về trạng thái của biểu tượng hiện thời. "
"Các trường:\n"
"\n"
" • Thông điệp ứng dụng\n"
" • Vị trí con trỏ\n"
" • Kích cỡ\n"
" • Hệ số thu phóng\n"
" • Số màu"

