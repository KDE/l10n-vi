msgstr "Lỗi tập tin."

#: pdfRenderer.cpp:655
msgid ""
"<qt>Could not start the <strong>cp</strong> copy command. The document is "
"<strong>not</strong> saved.</qt>"
msgstr ""
"<qt>Không thể khởi chạy lệnh sao chép <strong>cp</strong>. Vì thế tài liệu "
"<strong>chưa</strong> được lưu.</qt>"

#: pdfRenderer.cpp:661
msgid ""
"<qt>Error saving the document. The document is <strong>not</strong> saved.</"
"qt>"
msgstr ""
