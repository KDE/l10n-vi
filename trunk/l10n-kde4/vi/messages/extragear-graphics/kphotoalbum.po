#: DB/NewImageFinder.cpp:159
msgid ""
"<p><b>Loading information from new files</b></p><p>Depending on the number "
"of images, this may take some time.<br/>However, there is only a delay when "
"new images are found.</p>"
msgstr ""
"<p><p><b>Đang nạp thông tin từ các tập tin mới</b></p><p>Phụ thuộc vào tổng "
"số ảnh, việc này có thể kéo dài một lát.<br/>Tuy nhiên, chỉ chạy trễ khi tìm "
"ảnh mới.</p></p>"

#: DB/NewImageFinder.cpp:231
#, qt-format
msgid ""
"<p><b>Calculating checksum for %1 files<b></p><p>By storing a checksum for "
"each image KPhotoAlbum is capable of finding images even when you have moved "
"them on the disk.</p>"
msgstr ""
"<p><p><b>Đang tính tổng kiểm tra cho %1 tập tin<b></p><p>Bằng cách cất giữ "
"một tổng kiểm tra (checksum) riêng cho mỗi ảnh, KPhotoAlbum có khả năng tìm "
"ảnh ngay cả khi bạn đã di chuyển nó vào vị trí khác trên đĩa.</p></p>"

