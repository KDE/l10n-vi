msgstr "<qt><strong>Lỗi tập tin</strong> Không thể tạo tập tin tạm thời.</qt>"

#: ligaturepart.cpp:788
#, qt-format
msgid ""
"<qt><strong>File Error</strong> Could not create temporary file "
"<nobr><strong>%1</strong></nobr>.</qt>"
msgstr ""
"<qt><strong>Lỗi tập tin</strong> Không thể tạo tập tin tạm thời<nobr><strong>"
"%1</strong></nobr>.</qt>"

#: ligaturepart.cpp:809
#, qt-format
msgid ""
"<qt><strong>File Error</strong> Could not open the file <nobr><strong>%1</"
"strong></nobr> for uncompression. The file will not be loaded.</qt>"
msgstr ""
"<qt><strong>Lỗi tập tin</strong> Không thể mở tập tin <nobr><strong>%1</"
"strong></nobr> để giải nén. Vì thế tập tin sẽ không được nạp.</qt>"

#: ligaturepart.cpp:812
msgid ""
"<qt>This error typically occurs if you do not have enough permissions to "
"read the file. You can check ownership and permissions if you right-click on "
"the file in the Konqueror file manager and then choose the 'Properties' menu."
"</qt>"
msgstr ""
"<qt>Lỗi này thường xảy ra nếu bạn không có đủ quyền để đọc tập tin. Bạn có "
"thể kiểm tra tình trạng sở hữu và quyền hạn bằng cách nhấn-phải vào tập tin "
"trong bộ quản lý tập tin Konqueror rồi chọn trình đơn <b>Thuộc tính</b>.</qt>"

#: ligaturepart.cpp:822
msgid "Uncompressing..."
msgstr "Đang giải nén..."

#: ligaturepart.cpp:823
#, qt-format
msgid ""
"<qt>Uncompressing the file <nobr><strong>%1</strong></nobr>. Please wait.</"
"qt>"
msgstr ""
"<qt>Đang giải nén tập tin <nobr><strong>%1</strong></nobr>. Hãy đợi.</qt>"

#: ligaturepart.cpp:853
#, qt-format
msgid ""
"<qt><strong>File Error</strong> Could not uncompress the file <nobr><strong>%"
"1</strong></nobr>. The file will not be loaded.</qt>"
msgstr ""
"<qt><strong>Lỗi tập tin</strong> Không thể giải nén tập tin <nobr><strong>%"
"1</strong></nobr>. Vì thế tập tin sẽ không được nạp.</qt>"

#: ligaturepart.cpp:855
msgid ""
"<qt>This error typically occurs if the file is corrupt. If you want to be "
"sure, try to decompress the file manually using command-line tools.</qt>"
msgstr ""
"<qt>Lỗi này thường xảy ra nếu tập tin bị hỏng. Để chắc chắn, hãy thử tự giải "
"nén tập tin bằng công cụ dòng lệnh.</qt>"

#: ligaturepart.cpp:912
#, qt-format
msgid ""
"<qt>The document <b>%1</b> cannot be shown because its file type is not "
"supported.</qt>"
msgstr ""
"<qt>Tài liệu <b>%1</b> không thể được hiển thị vì nó có kiểu tập tin không "
"được hỗ trợ.</qt>"

#: ligaturepart.cpp:914
#, qt-format
msgid ""
"<qt>The file has mime type <b>%1</b> which is not supported by any of the "
"installed Ligature plugins.</qt>"
msgstr ""
"<qt>Tập tin có kiểu MIME <b>%1</b> mà không được hỗ trợ bởi phần bổ sung "
"Ligature nào được cài đặt.</qt>"

#: ligaturepart.cpp:943
msgid ""
"<qt>No service implementing the given mimetype and fullfilling the given "
"constraint expression can be found.</qt>"
msgstr ""
"<qt>Không tìm thấy dịch vụ thực hiện kiểu MIME đưa ra và thoả biểu thức ràng "
"buộc đã cho.</qt>"

#: ligaturepart.cpp:946
