#: kprintDialogPage_pageoptions.cpp:25
msgid "Page Size & Placement"
msgstr "Kích cỡ/Vị trí trang"

#: kprintDialogPage_pageoptions.cpp:38
msgid "Center the page on paper"
msgstr "Giữa lại trang trên giấy"

#: kprintDialogPage_pageoptions.cpp:39
msgid "If this option is enabled, the pages are centered on the paper."
msgstr "Bật tùy chọn này thì các trang được giữa lại trên tờ giấy."

#: kprintDialogPage_pageoptions.cpp:40
msgid ""
"<qt><p>If this option is enabled, the pages will be printed centered on the "
"paper; this makes more visually-appealing printouts.</p><p>If the option is "
"not enabled, all pages will be placed in the top-left corner of the paper.</"
"p></qt>"
msgstr "<qt><p>Bật tùy chọn này thì in ra các trang được giữa lại trên tờ giấy. Tùy chọn này tạo bản in đẹp hơn.</p><p>Tắt thì các trang được in ra từ góc trên bên trái tờ giấy.</"
"p></qt>"

#: kprintDialogPage_pageoptions.cpp:46
msgid "Automatically choose landscape or portrait orientation"
msgstr "Tự động chọn hướng nằm ngang hay thẳng đứng"

#: kprintDialogPage_pageoptions.cpp:47
msgid ""
"If this option is enabled, some pages might be rotated to better fit the "
"paper size."
msgstr "Bật tùy chọn này thì một số trang có thể được xoay để vừa khít kích cỡ tờ giấy một cách tốt hơn."

#: kprintDialogPage_pageoptions.cpp:48
msgid ""
"<qt><p><qt><p>If this option is enabled, landscape or portrait orientation "
"are automatically chosen on a page-by-page basis. This makes better use of "
"the paper and gives more visually-appealing printouts.</p><p><b>Note:</b> "
"This option overrides the Portrait/Landscape option chosen in the printer "
"properties. If this option is enabled, and if the pages in your document "
"have different sizes, then some pages might be rotated while others are not."
"</p></qt>"
msgstr "<qt><p><qt><p>Bật tùy chọn này thì hướng nằm ngang hay thẳng đứng được chọn tự động đặc trưng cho trang. Tùy chọn này dùng giấy một cách hữu ích hơn, và tạo bản in đẹp hơn.</p><p><b>Ghi chú :</b> tùy chọn này có quyền cao hơn tùy chọn Nằm ngang/Thẳng đứng trong thuộc tính máy in. Nếu tùy chọn này được bật, và tài liệu có các trang kích cỡ khác nhau, một số trang có thể được xoay còn trang khác không phải.</p></qt>"

#: kprintDialogPage_pageoptions.cpp:63
msgid "Shrink oversized pages to fit paper size"
msgstr "Thu nhỏ trang quá lớn để vừa cỡ giấy"

#: kprintDialogPage_pageoptions.cpp:64
msgid ""
"If this option is enabled, large pages that would not fit the printer's "
"paper size will be shrunk."
msgstr "Bật tùy chọn này thì các trang lớn hơn kích cỡ giấy trong máy in sẽ bị thu nhỏ."

#: kprintDialogPage_pageoptions.cpp:65
msgid ""
"<qt><p>If this option is enabled, large pages that would not fit the "
"printer's paper size will be shrunk so that edges won't be cut off during "
"printing.</p><p><b>Note:</b> If this option is enabled, and if the pages in "
"your document have different sizes, then different pages might be shrunk by "
"different scaling factors.</p></qt>"
msgstr "<qt><p>Bật tùy chọn này thì các trang lớn hơn kích cỡ giấy trong máy in sẽ bị thu nhỏ để tránh cạnh bị xén trong khi in.</p><p><b>Note:</b> Ghi chú :</b> nếu tùy chọn này được bật, và tài liệu có các trang kích cỡ khác nhau, những trang khác nhau có thể bị thu nhỏ theo hệ số co dãn khác nhau.</p></qt>"

#: kprintDialogPage_pageoptions.cpp:72
msgid "Expand small pages to fit paper size"
msgstr "Phóng to trang nhỏ hơn để vừa cỡ giấy"

#: kprintDialogPage_pageoptions.cpp:73
msgid ""
"If this option is enabled, small pages will be enlarged so that they fit the "
"printer's paper size."
msgstr "Bật tùy chọn này thì các trang nhỏ sẽ được phóng to để vừa khít kích cỡ giấy trong máy in."

#: kprintDialogPage_pageoptions.cpp:74
msgid ""
"<qt><p>If this option is enabled, small pages will be enlarged so that they "
"fit the printer's paper size.</p><p><b>Note:</b> If this option is enabled, "
"and if the pages in your document have different sizes, then different pages "
"might be expanded by different scaling factors.</p></qt>"
msgstr "<qt><p>Bật tùy chọn này thì các trang nhỏ hơn kích cỡ giấy trong máy in sẽ được phóng to để vừa khít kích cỡ giấy trong máy in.</p><p><b>Note:</b> Ghi chú :</b> nếu tùy chọn này được bật, và tài liệu có các trang kích cỡ khác nhau, những trang khác nhau có thể bị thu nhỏ theo hệ số co dãn khác nhau.</p></qt>"

#: ligature.cpp:84
msgid ""
"<qt>A fatal error ocurred. An important library could not be found. Ligature "
"will not work.</qt>"
msgstr "<qt>Gặp lỗi nghiêm trọng. Không tìm thấy thư viện quan trọng. Vì vậy Ligature sẽ không chạy được.</qt>"

#: ligature.cpp:85
msgid ""
"<qt><p>The Ligature application uses the <strong>ligaturepart</strong> "
"library internally. This  library was not found on your computer.</p><p>The "
"problem is most likely a broken installation of the Ligature application. "
"You could try to uninstall all instances of Ligature and then re-install the "
"latest version.</p></qt>"
msgstr "<qt><p>Ứng dụng Ligature sử dụng nội bộ thư viện <strong>ligaturepart</strong>. Không tìm thấy thư viện này trên máy tính của bạn.</p><p>Vấn đề rất có thể là bản cài đặt bị hỏng của ứng dụng Ligature. Đề nghị bạn hủy cài đặt mọi thể hiện Ligature rồi cài đặt lại phiên bản mới nhất.</p></qt>"

#: ligature.cpp:89
#: ligature.cpp:111
msgid "Ligature - Critical Error"
msgstr "Ligature — lỗi nghiêm trọng"

#: ligature.cpp:102
msgid ""
"<qt>A fatal error ocurred. An incompatible version of an important library "
"was found. Ligature will not work.</qt>"
msgstr "<qt>Gặp lỗi nghiêm trọng. Tìm thấy một phiên bản không tương thích của thư viện quan trọng. Vì vậy Ligature sẽ không chạy được.</qt>"

#: ligature.cpp:103
#, qt-format
msgid ""
"<qt><p>The Ligature application uses the <strong>ligaturepart</strong> "
"library internally. A version of this library was found, but this version is "
"<strong>not</strong> compatible with the current version of the Ligature "
"application.</p><p>Version found: <strong>%1</strong></p><p>Version "
"required: <strong>%2</strong></p><p>The problem is most likely that two "
"incompatible versions of Ligature are simultaneously installed on your "
"computer. You could try to uninstall all instances of Ligature and then re-"
"install the latest version.</p></qt>"
msgstr "<qt><p>Ứng dụng Ligature sử dụng nội bộ thư viện <strong>ligaturepart</strong>. Tìm thấy một phiên bản của thư viện này, nhưng phiên bản đó <strong>không phải</strong> tương thích với phiên bản hiện thời của ứng dụng Ligature.</p><p>Phiên bản đã tìm: <strong>%1</strong></p><p>Phiên bản cần thiết: <strong>%2</strong></p><p>Vấn đề rất có thể là hai phiên bản Ligature không tương thích với nhau được nằm đồng thời trên máy tính này. Đề nghị bạn hủy cài đặt mọi thể hiện Ligature rồi cài đặt lại phiên bản mới nhất.</p></qt>"

