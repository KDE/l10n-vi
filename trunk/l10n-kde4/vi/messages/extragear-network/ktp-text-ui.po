msgstr "Thẻ &sau"

#: chat-window.cpp:581
msgid "&Previous Tab"
msgstr "Thẻ &trước"

#: chat-window.cpp:585
msgid "&Audio Call"
msgstr "&Gọi thoại"

#: chat-window.cpp:586
msgctxt "Toolbar icon tooltip"
msgid "Start an audio call with this contact"
msgstr "Bắt đầu một cuộc gọi thoại tới liên lạc này"

#: chat-window.cpp:589 chat-window.cpp:829
msgid "&Block Contact"
msgstr "&Chặn liên lạc"

#: chat-window.cpp:591
msgctxt "Toolbar icon tooltip"
msgid ""
"Blocking means that this contact will not see you online and you will not "
"receive any messages from this contact"
msgstr ""
"Chặn nghĩa là liên lạc này sẽ không còn nhìn thấy bạn trực tuyến và bạn cũng "
"không phải nhận bất cứ tin nhắn nào từ liên lạc này"

#: chat-window.cpp:594
msgid "&Send File"
msgstr "&Gửi tập tin"

#: chat-window.cpp:595
msgctxt "Toolbar icon tooltip"
msgid "Send a file to this contact"
msgstr "Gửi một tập tin tới liên lạc này"

#: chat-window.cpp:598
msgid "&Invite to Chat"
msgstr "&Mời trò chuyện"

#: chat-window.cpp:599
msgctxt "Toolbar icon tooltip"
msgid "Invite another contact to join this chat"
msgstr "Mời một liên lạc khác tham gia vào cuộc trò chuyện này"

#: chat-window.cpp:602
msgid "&Video Call"
msgstr "&Gọi có hình"

#: chat-window.cpp:603
msgctxt "Toolbar icon tooltip"
msgid "Start a video call with this contact"
msgstr "Bắt đầu một cuộc gọi có hình tới liên lạc này"

#: chat-window.cpp:606
msgid "Share My &Desktop"
msgstr "Chia sẻ &màn hình làm việc"

#: chat-window.cpp:607
msgctxt "Toolbar icon tooltip"
msgid "Start an application that allows this contact to see your desktop"
msgstr "Chạy một ứng dụng cho phép liên lạc này nhìn thấy màn hình của bạn"

#: chat-window.cpp:618
msgid "Choose Spelling Language"
msgstr "Chọn ngôn ngữ chính tả"

#: chat-window.cpp:621
