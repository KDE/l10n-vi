msgid "Failed to register new account."
msgstr "Thất bại khi đăng ký tài khoản mới."

#: providerconfigwidget.cpp:208
msgid "Failed to register new account: invalid password."
msgstr "Thất bại khi đăng ký tài khoản mới: mật khẩu không hợp lệ."

#: providerconfigwidget.cpp:212
msgid "Failed to register new account: invalid username."
msgstr "Thất bại khi đăng ký tài khoản mới: tên người dùng không hợp lệ."

#: providerconfigwidget.cpp:216
msgid ""
"Failed to register new account: the requested username is already taken."
msgstr ""
"Thất bại khi đăng ký tài khoản mới: tên người dùng yêu cầu đã được dùng."

#: providerconfigwidget.cpp:220
msgid ""
"Failed to register new account: the specified email address is already taken."
msgstr "Thất bại khi đăng ký tài khoản mới: địa chỉ thư đã được dùng."

#: providerconfigwidget.cpp:224
msgid "Failed to register new account: the specified email address is invalid."
msgstr "Thất bại khi đăng ký tài khoản mới: địa chỉ thư không hợp lệ."

#: providerconfigwidget.cpp:269
msgid "Registration is in progress..."
msgstr "Đang trong quá trình đăng ký..."

#: providerconfigwidget.cpp:282
msgid ""
"Registration complete. New account was successfully registered. Please "
"<b>check your Email</b> to <b>activate</b> the account."
msgstr ""
"Đăng ký hoàn tất. Tài khoản mới đã được đăng ký thành công. Hãy <b>kiểm tra "
"thư của bạn</b> để <b>kích hoạt</b> tài khoản."

