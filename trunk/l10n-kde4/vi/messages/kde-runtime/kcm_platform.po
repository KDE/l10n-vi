msgid "Custom desktop shell"
msgstr "Vỏ môi trường làm việc tuỳ biến"

#: shellEdit.cpp:24
msgid ""
"This shell is reserved for user's custom shell. Press \"Setup\" button to "
"setup your favourite shell."
msgstr ""
"Vỏ này được giữ cho vỏ tuỳ biến của người dùng. Nhấn nút cài đặt để cài đặt "
"vỏ yêu thích của bạn."

#~ msgid "Platform Specific Configuration Module"
#~ msgstr "Mô-đun cấu hình phụ thuộc nền tảng"

#~ msgctxt "'Windows' means the OS"
#~ msgid "Windows Desktop Shell"
#~ msgstr "Vỏ môi trường làm việc Windows"

#~ msgid "Native Windows Explorer shell"
#~ msgstr "vỏ Windows Explorer bản địa"

#~ msgid ""
#~ "This is the standard Windows Desktop shell. Choose this if you want to "
#~ "return your system to the default desktop."
#~ msgstr ""
#~ "Đây là vỏ Môi trường làm việc Windows chuẩn. Chọn cái này nếu bạn muốn "
#~ "đưa hệ thống của mình về môi trường làm việc mặc định."

#~ msgid "Native desktop shell"
#~ msgstr "Vỏ môi trường làm việc bản địa"

#~ msgid "System's default desktop shell"
#~ msgstr "Vỏ môi trường làm việc mặc định của hệ thống"

#~ msgid "Use the KDE desktop shell, as it is seen on Linux."
#~ msgstr "Sử dụng vỏ môi trường làm việc KDE như được thấy trên Linux"

#~ msgid ""
#~ "Choose this option if you would like to use the Plasma desktop shell for "
#~ "your Windows system."
#~ msgstr ""
#~ "Chọn tuỳ chọn này nếu bạn muốn vỏ môi trường làm việc Plasma cho hệ thống "
#~ "Windows của bạn."

#~ msgid "Plasma desktop shell"
#~ msgstr "Vỏ môi trường làm việc Plasma"

#~ msgid "KDE4 Plasma desktop shell"
#~ msgstr "Vỏ môi trường làm việc KDE4 Plasma"

#~ msgid "Your custom desktop shell"
#~ msgstr "Vỏ môi trường làm việc tuỳ biến của bạn"

#~ msgid ""
#~ "Choose this and press the <i>\"Setup...\"</i> button to configure you "
#~ "custom desktop shell. Not recommended for the average user."
#~ msgstr ""
#~ "Chọn điều này và nhấn nút <i>\"Cài đặt...\"</i> để cấu hình vỏ môi trường "
#~ "làm việc tuỳ biến của bạn. Không khuyến khích cho người dùng thông thường."

#~ msgid ""
#~ "This shell is reserved for the user's custom shell. Press the \"Setup\" "
#~ "button to setup your favorite shell."
#~ msgstr ""
#~ "Vỏ này được giữ cho vỏ tuỳ biến của người dùng. Nhấn nút \"Cài đặt\" để "
#~ "cài đặt vỏ yêu thích của bạn."

#~ msgid "Press to setup your custom desktop shell"
#~ msgstr "Nhấn để cài đặt vỏ môi trường làm việc tuỳ biến của bạn"

#~ msgid ""
#~ "Press this and a configuration dialog will appear to allow you to "
#~ "configure your custom desktop shell."
#~ msgstr ""
#~ "Nhấn và một hộp thoại cấu hình sẽ xuất hiện để cho phép bạn cấu hình vỏ "
#~ "môi trường làm việc tuỳ biến của mình."

#~ msgid "Setup..."
#~ msgstr "Cài đặt..."

#~ msgid "System Integration"
#~ msgstr "Tích hợp hệ thống"

#~ msgid ""
#~ "This will enable automatic regeneration of Windows' Start menu entries "
#~ "for KDE applications"
#~ msgstr ""
#~ "Điều này sẽ cho phép tự động tạo các mục trình đơn Start của Windows cho "
#~ "các ứng dụng KDE"

#~ msgid ""
#~ "This option defines if Windows' Start menu entries should be regenerated "
#~ "or not. By default start menu entries are regenerated automatically, but "
#~ "you may wish to disable it if you have issues with that."
#~ msgstr ""
#~ "Tuỳ chọn này cho biết các mục trình đơn Start của Windows có nên được tạo "
#~ "lại hay không. Mặc định, các mục trình đơn được tạo lại tự động, nhưng "
#~ "bạn có thể muốn tắt đi nếu gặp vấn đề với điều đó."

#~ msgid "Enable automatic regeneration of start menu entries"
#~ msgstr "Bật tự động tạo lại các mục trình đơn khởi động"

#~ msgid "Use native Windows file dialogs instead of KDE ones"
#~ msgstr "Sử dụng hộp thoại tập tin của Windows thay cho của KDE"

#~ msgid ""
#~ "Choose this option to make KDE applications use the standard Windows Open/"
#~ "Save file dialogs, instead of those normally used in KDE."
#~ msgstr ""
#~ "Chọn tuỳ chọn này để các ứng dụng KDE sử dụng hộp thoại Mở/Lưu chuẩn của "
#~ "Windows, thay cho những hộp thoại thường dùng trong KDE."

#~ msgid "Use native system file dialogs"
#~ msgstr "Sử dụng hộp thoại tập tin của hệ thống"

#~ msgid "Install System Settings into the Windows Control Panel."
#~ msgstr "Cài đặt Thiết lập hệ thống vào Bảng điều khiển Windows"

#~ msgid ""
#~ "This will install the KDE 'System Settings' as an element in the Windows "
#~ "Control Panel.<br><b>Caution: This option tweaks your Windows registry.</"
#~ "b>"
#~ msgstr ""
#~ "Việc này sẽ cài đặt 'Thiết lập hệ thống' KDE như một thành phần trong "
#~ "Bảng điều khiển Windows.<br><b>Chú ý: Tuỳ chọn này sẽ tinh chỉnh registry "
#~ "của Windows.</b>"

#~ msgid "Install as control panel element"
#~ msgstr "Cài đặt như một thành phần bảng điều khiển"

#~ msgid "Install Oxygen cursors as Windows cursor schemes"
#~ msgstr "Cài đặt con trỏ Oxygen làm giao diện con trỏ Windows"

#~ msgid ""
#~ "This will install the Oxygen cursors into your system and combine them as "
#~ "a cursor theme.<br><b>Caution: This option tweaks your Windows registry.</"
#~ "b>"
#~ msgstr ""
#~ "Việc này sẽ cài đặt con trỏ Oxygen vào hệ thống của bạn và kết hợp chúng "
#~ "thành một giao diện con trỏ.<br><b>Chú ý: Việc này sẽ tinh chỉnh registry "
#~ "của Windows</b>"

#~ msgid "Install Oxygen cursor schemes"
#~ msgstr "Cài đặt giao diện con trỏ Oxygen"

#~ msgid ""
#~ "This option installs KDE wallpapers into your \"My Pictures\" directory"
#~ msgstr "Tuỳ chọn này sẽ cài đặt hình nền KDE vào thư mục \"Ảnh của tôi\""

#~ msgid ""
#~ "This will install KDE wallpapers into the <i>\"My Pictures\"</i> "
#~ "directory so they can be used as your Windows wallpaper. If the checkbox "
#~ "is set to half-checked then it means that there are new wallpapers "
#~ "available to update.<br> The wallpaper aspect ratio will be selected "
#~ "according to your current screen resolution."
#~ msgstr ""
#~ "Việc này sẽ cài đặt các hình nền KDE vào thư mục <i>\"Ảnh của tôi</i> để "
#~ "chúng có thể sử dụng làm hình nền Windows của bạn. Nếu hộp chọn được chọn "
#~ "một nửa có nghĩa là có các hình nền mới sẵn sàng để cập nhật.<br> Tỉ lệ "
#~ "chiều hình nền sẽ được chọn tương ứng với độ phân giải màn hình hiện tại "
#~ "của bạn."

#~ msgid "Install Oxygen wallpapers"
#~ msgstr "Cài đặt hình nền Oxygen"

#~ msgid "This will make essential KDE processes run at user login"
#~ msgstr ""
#~ "Việc này sẽ cho phép các tiến trình KDE thiết yếu được chạy khi đăng nhập"

#~ msgid ""
#~ "Enabling this option will start essential KDE processes at user login. "
#~ "Normally these processes are started when you first start a KDE "
#~ "application, thereby delaying the actual application launch.<br>It is "
#~ "recommended to enable this option to make your applications launch faster "
#~ "for the first time.<br><b>Caution: This option tweaks your Windows "
#~ "registry.</b>"
#~ msgstr ""
#~ "Bật tuỳ chọn này sẽ khởi động các tiến trình KDE thiết yếu khi người dùng "
#~ "đăng nhập. Thông thường các tiến trình này được khởi động khi bạn chạy "
#~ "một ứng dụng KDE lần đầu tiên, vì vậy sẽ trì hoãn việc chạy ứng dụng."
#~ "<br>Khuyến nghị bật tuỳ chọn này để khiến các ứng dụng của bạn chạy nhanh "
#~ "hơn lần đầu tiên.<br><b>Chú ý: Tuỳ chọn này sẽ tinh chỉnh registry "
#~ "Windows của bạn.</b>"

#~ msgid "Load KDE at user login"
#~ msgstr "Nạp KDE lúc đăng nhập"

