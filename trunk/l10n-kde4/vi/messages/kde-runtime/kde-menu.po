#: kde-menu.cpp:93
#, kde-format
msgid "Menu item '%1' could not be highlighted."
msgstr "Không thể tô sáng mục trình đơn '%1'."

#: kde-menu.cpp:106
msgid ""
"KDE Menu query tool.\n"
"This tool can be used to find in which menu a specific application is "
"shown.\n"
"The --highlight option can be used to visually indicate to the user where\n"
"in the KDE menu a specific application is located."
msgstr ""
"Công cụ truy vấn Trình đơn KDE.\n"
"Công cụ này được dùng để tìm kiếm một ứng dụng được hiện trong trình đơn "
"nào.\n"
"Tuỳ chọn --highlight có thể được dùng để hiển thị trực quan tới người dùng "
"nơi\n"
"một ứng dụng cụ thể được đặt trong trình đơn KDE."

#: kde-menu.cpp:111
msgid "kde-menu"
msgstr "kde-menu"

#: kde-menu.cpp:113
msgid "(c) 2003 Waldo Bastian"
msgstr "(c) 2003 Waldo Bastian"

#: kde-menu.cpp:114
msgid "Waldo Bastian"
msgstr "Waldo Bastian"

#: kde-menu.cpp:114
msgid "Author"
msgstr "Tác giả"

#: kde-menu.cpp:119
msgid "Output data in UTF-8 instead of local encoding"
msgstr "Xuất dữ liệu theo UTF-8 thay cho bộ mã ký tự cục bộ"

#: kde-menu.cpp:120
msgid ""
"Print menu-id of the menu that contains\n"
"the application"
msgstr "Hiện menu-id của trình đơn chứa ứng dụng"

#: kde-menu.cpp:121
msgid ""
"Print menu name (caption) of the menu that\n"
"contains the application"
msgstr "Hiện tên trình đơn chứa ứng dụng"

#: kde-menu.cpp:122
msgid "Highlight the entry in the menu"
msgstr "Tô sáng mục trong trình đơn"

#: kde-menu.cpp:123
msgid "Do not check if sycoca database is up to date"
msgstr "Không kiểm tra tính mới nhất của cơ sở dữ liệu sycoca"

#: kde-menu.cpp:124
msgid "The id of the menu entry to locate"
msgstr "ID của mục trình đơn để tìm"

#: kde-menu.cpp:133
msgid "You must specify an application-id such as 'kde4-konsole.desktop'"
msgstr "Bạn phải chỉ định một application-id như là 'kde4-console.desktop'"

#: kde-menu.cpp:142
msgid ""
"You must specify at least one of --print-menu-id, --print-menu-name or --"
"highlight"
msgstr ""
"Bạn phải chỉ định ít nhất một trong --print-menu-id, --print-menu-name hay --"
"highlight"

#: kde-menu.cpp:164
#, kde-format
msgid "No menu item '%1'."
msgstr "Không có mục trình đơn '%1'."

#: kde-menu.cpp:168
#, kde-format
msgid "Menu item '%1' not found in menu."
msgstr "Không tìm thấy mục '%1' trong trình đơn."

