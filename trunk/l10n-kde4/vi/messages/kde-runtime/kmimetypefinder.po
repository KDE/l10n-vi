#: kmimetypefinder.cpp:33
msgid "Gives the mimetype for a given file"
msgstr "Trả lại kiểu MIME của một tập tin cho trước"

#: kmimetypefinder.cpp:33
msgid "MimeType Finder"
msgstr "Trình tìm kiểu MIME"

#: kmimetypefinder.cpp:38
msgid "Use only the file content for determining the mimetype."
msgstr "Chỉ sử dụng nội dung tập tin để quyết định kiểu MIME"

#: kmimetypefinder.cpp:39
msgid ""
"Whether use the file name only for determining the mimetype. Not used if -c "
"is specified."
msgstr ""
"Sẽ chỉ dùng tên tập tin để quyết định kiểu MIME. Không dùng nếu đã chỉ định "
"tùy chọn -c."

#: kmimetypefinder.cpp:40
msgid "The filename to test. '-' to read from stdin."
msgstr "Tên tập tin để kiểm tra. '-' để đọc từ stdin (đầu vào tiêu chuẩn)."
