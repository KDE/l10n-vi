#: main.cpp:39
msgid "kwinstartmenu"
msgstr "kwinstartmenu"

#: main.cpp:40
msgid "An application to create/update or remove Windows Start Menu entries"
msgstr ""
"Một ứng dụng để tạo và cập nhật hay gỡ bỏ các mục Trình đơn khởi động Windows"

#: main.cpp:42
msgid "(C) 2008-2011 Ralf Habacker"
msgstr "(C) 2008-2011 Ralf Habacker"

#: main.cpp:46
msgid "remove installed start menu entries"
msgstr "gỡ bỏ các mục trình đơn khởi động đã cài đặt"

#: main.cpp:47
msgid "install start menu entries"
msgstr "cài đặt các mục trình đơn khởi động"

#: main.cpp:48
msgid "update start menu entries"
msgstr "cập nhật mục trình đơn khởi động"

#: main.cpp:49
msgid "remove start menu entries from unused kde installation"
msgstr "gỡ bỏ các mục trình đơn khởi động khỏi bản cài đặt kde không dùng"

#: main.cpp:51
msgid "query root path of start menu entries"
msgstr "truy vấn đường dẫn gốc của mục trình đơn khởi động"

#: main.cpp:53
msgid "use categories for start menu entries (default)"
msgstr "sử dụng thể loại cho các cục trình đơn khởi động (mặc định)"

#: main.cpp:54
msgid "don't use categories for start menu entries"
msgstr "không sử dụng thể loại cho các mục trình đơn khởi động"

#: main.cpp:55
msgid "query current value of categories in start menu"
msgstr "truy vấn giá trị hiện tại của các thể loại trong trình đơn khởi động"

#: main.cpp:57
msgid "set custom string for root start menu entry"
msgstr "đặt chuỗi tùy biến cho mục trình đơn khởi động gốc"

#: main.cpp:60
msgid "remove custom string from root start menu entry"
msgstr "bỏ chuỗi tùy biến khỏi mục trình đơn khởi động gốc"

#: main.cpp:61
msgid "query current value of root start menu entry custom string"
msgstr "truy vấn giá trị hiện tại của chuỗi tùy biến trình đơn khởi động gốc"

#: main.cpp:63
msgid "set custom name string for root start menu entry"
msgstr "đặt chuỗi tên tùy biến cho mục trình đơn khởi động gốc"

#: main.cpp:64
msgid "remove custom name string from root start menu entry"
msgstr "bỏ chuỗi tên tùy biến cho mục trình đơn khởi động gốc"

#: main.cpp:65
msgid "query current value of start menu entry custom name string"
msgstr ""
"truy vấn giá trị hiện tại của chuỗi tên tùy biến mục trình đơn khởi động"

#: main.cpp:67
msgid "set custom version string for root start menu entry"
msgstr "đặt chuỗi phiên bản tùy biến cho mục trình đơn khởi động gốc"

#: main.cpp:68
msgid "remove custom version string from root start menu entry"
msgstr "bỏ chuỗi phiên bản tùy biến khỏi mục trình đơn khởi động gốc"

#: main.cpp:69
msgid "query current value of root start menu entry version string"
msgstr ""
"truy vấn giá trị hiện tại của chuỗi phiên bản mục trình đơn khởi động gốc"
