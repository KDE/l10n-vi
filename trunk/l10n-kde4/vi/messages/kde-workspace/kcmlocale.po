#: kcmlocale.cpp:1083 kcmlocalewidget.ui:36
msgid "Country:"
msgstr "Quốc gia:"

#: kcmlocale.cpp:1084
msgid ""
"<p>This is the country where you live.  The KDE Workspace will use the "
"settings for this country or region.</p>"
msgstr ""
"<p>Đây là quốc gia bạn sinh sống. Không gian làm việc KDE sẽ sử dụng các "
"thiết lập cho quốc gia này.</p>"

