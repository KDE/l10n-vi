#. i18n: ectx: property (text), widget (QLabel, m_labelShortDateFormat)
#: kcmlocale.cpp:2987 kcmlocalewidget.ui:1302
msgid "Short date format:"
msgstr "Dạng thức ngày ngắn:"

#: kcmlocale.cpp:2988
msgid ""
"<p>The text in this textbox will be used to format short dates. For "
"instance, this is used when listing files. The sequences below will be "
"replaced:</p><table><tr><td><b>YYYY</b></td><td>The year with century as a "
"decimal number.</td></tr><tr><td><b>YY</b></td><td>The year without century "
"as a decimal number (00-99).</td></tr><tr><td><b>MM</b></td><td>The month as "
"a decimal number (01-12).</td></tr><tr><td><b>mM</b></td><td>The month as a "
"decimal number (1-12).</td></tr><tr><td><b>SHORTMONTH</b></td><td>The first "
"three characters of the month name.</td></tr><tr><td><b>MONTH</b></"
"td><td>The full month name.</td></tr><tr><td><b>DD</b></td><td>The day of "
"month as a decimal number (01-31).</td></tr><tr><td><b>dD</b></td><td>The "
"day of month as a decimal number (1-31).</td></tr><tr><td><b>SHORTWEEKDAY</"
"b></td><td>The first three characters of the weekday name.</td></"
"tr><tr><td><b>WEEKDAY</b></td><td>The full weekday name.</td></"
"tr><tr><td><b>ERAYEAR</b></td><td>The Era Year in local format (e.g. 2000 "
"AD).</td></tr><tr><td><b>SHORTERANAME</b></td><td>The short Era Name.</td></"
"tr><tr><td><b>YEARINERA</b></td><td>The Year in Era as a decimal number.</"
"td></tr><tr><td><b>DAYOFYEAR</b></td><td>The Day of Year as a decimal number."
"</td></tr><tr><td><b>ISOWEEK</b></td><td>The ISO Week as a decimal number.</"
"td></tr><tr><td><b>DAYOFISOWEEK</b></td><td>The Day of the ISO Week as a "
"decimal number.</td></tr></table>"
msgstr ""
"<p>Văn bản trong hộp này sẽ được dùng để định dạng ngày tháng rút gọn (dùng "
"khi liệt kê các tập tin. Các chuỗi sau sẽ được thay thế:</"
"p><table><tr><td><b>YYYY</b> </td><td>Số năm đầy đủ.</td> </"
"tr><tr><td><b>YY</b></td><td>Số năm ngắn (00-99).</td> </tr><tr><td><b>MM</"
"b></td><td>Tháng (01-12).</td></tr><tr><td><b>mM</b></td><td>Tháng (1-12).</"
"td></tr> <tr><td><b>SHORTMONTH</b></td><td>Ba ký tự đầu của tên tháng.</td></"
"tr><tr><td> <b>MONTH</b></td><td>Tên tháng đầy đủ.</td></tr><tr><td><b>DD</"
"b></td><td>Ngày trong tháng (01-31).</td></tr><tr><td><b>dD</b></td><td>Ngày "
"trong tháng (1-31).</td></tr><tr><td><b>SHORTWEEKDAY</b></td><td>Ba ký tự "
"đầu của thứ trong tuần.</td> </tr><tr><td><b>WEEKDAY</b></td><td>Tên thứ đầy "
"đủ.</td></tr><tr><td><b>ERAYEAR</b> </td><td>Năm kỷ nguyên theo định dạng "
"địa phương (VD: 2000 AD).</td></tr><tr><td> <b>SHORTERANAME</b></td><td>Năm "
"kỷ nguyên ngắn.</td></tr><tr><td><b>YEARINERA</b> </td><td>Năm trong kỷ "
"nguyên.</td></tr><tr><td><b>DAYOFYEAR</b></td><td>Ngày trong năm. </td></"
"tr><tr><td><b>ISOWEEK</b></td><td>Tuần chuẩn ISO.</td></tr><tr><td> "
"<b>DAYOFISOWEEK</b></td><td>Thứ trong tuần chuẩn ISO.</td></tr></table>"

