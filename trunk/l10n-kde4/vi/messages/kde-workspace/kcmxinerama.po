msgid "kcmxinerama"
msgstr "kcmxinerama"

#: kcmxinerama.cpp:56
msgid "KDE Multiple Monitor Configurator"
msgstr "Trình cấu hình nhiều màn hình của KDE"

#: kcmxinerama.cpp:58
