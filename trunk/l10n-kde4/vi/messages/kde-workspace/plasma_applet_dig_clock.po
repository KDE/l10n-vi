#. i18n: ectx: property (text), widget (QLabel, label_6)
#: clockConfig.ui:26
msgid "Font"
msgstr "Phông chữ"

#. i18n: ectx: property (text), widget (QLabel, label)
#: clockConfig.ui:33
msgid "Font style:"
msgstr "Kiểu phông:"

#. i18n: ectx: property (toolTip), widget (QCheckBox, plainClockFontBold)
#: clockConfig.ui:69
msgid "Check if you want the font in bold"
msgstr "Chọn nếu bạn muốn phông chữ đậm"

#. i18n: ectx: property (whatsThis), widget (QCheckBox, plainClockFontBold)
#: clockConfig.ui:72
msgid "When this is checked, the clock font will be bold."
msgstr "Nếu chọn, phông chữ đồng hồ sẽ đậm lên."

#. i18n: ectx: property (text), widget (QCheckBox, plainClockFontBold)
#: clockConfig.ui:75
msgid "&Bold"
msgstr "Đậ&m"

#. i18n: ectx: property (toolTip), widget (QCheckBox, plainClockFontItalic)
#: clockConfig.ui:82
msgid "Check if you want the font in italic"
msgstr "Chọn nếu bạn muốn phông chữ nghiêng"

#. i18n: ectx: property (whatsThis), widget (QCheckBox, plainClockFontItalic)
#: clockConfig.ui:85
msgid "When this is checked, the clock font will be in italic."
msgstr "Nếu chọn, phông chữ đồng hồ sẽ nghiêng sang bên."

#. i18n: ectx: property (text), widget (QCheckBox, plainClockFontItalic)
#: clockConfig.ui:88
msgid "&Italic"
msgstr "&Nghiêng"

#. i18n: ectx: property (text), widget (QLabel, label_2)
#: clockConfig.ui:111
msgid "Custom font color:"
msgstr "Màu phông riêng:"

#. i18n: ectx: property (toolTip), widget (KColorButton, plainClockColor)
#: clockConfig.ui:136
msgid "Color chooser"
msgstr "Trình chọn màu sắc"

#. i18n: ectx: property (whatsThis), widget (KColorButton, plainClockColor)
#: clockConfig.ui:139
msgid ""
"Click on this button and the KDE standard color dialog will show. You can "
"then choose the new color you want for your clock."
msgstr ""
"Nhấn nút này để mở hộp thoại chọn màu chuẩn của KDE. Sau đó bạn có thể chọn "
"màu sắc mà bạn muốn cho đồng hồ của mình."

#. i18n: ectx: property (text), widget (QLabel, label_9)
#: clockConfig.ui:161
msgid "Show shadow:"
msgstr "Hiện đổ bóng:"

#. i18n: ectx: property (text), widget (QLabel, customShadowColorLabel)
#: clockConfig.ui:198
msgid "Custom shadow color:"
msgstr "Màu đổ bóng riêng:"

#. i18n: ectx: property (toolTip), widget (KColorButton, plainClockShadowColor)
#: clockConfig.ui:216
msgid "Shadow color chooser"
msgstr "Trình chọn màu đổ bóng"

#. i18n: ectx: property (whatsThis), widget (KColorButton, plainClockShadowColor)
#: clockConfig.ui:219
msgid ""
"Click on this button and the KDE standard color dialog will show. You can "
"then choose the new color you want for the text shadow for your clock."
msgstr ""
"Nhấn nút này để mở hộp thoại chọn màu chuẩn của KDE. Sau đó bạn có thể chọn "
"màu sắc mà bạn muốn cho đổ bóng chữ của mình."

#. i18n: ectx: property (text), widget (QLabel, label_7)
#: clockConfig.ui:257
msgid "Information"
msgstr "Thông tin"

#. i18n: ectx: property (text), widget (QLabel, label_4)
#: clockConfig.ui:264
msgid "Show time zone:"
msgstr "Hiện múi giờ:"

#. i18n: ectx: property (toolTip), widget (QCheckBox, showTimeZone)
#: clockConfig.ui:279
msgid "Display the time zone name"
msgstr "Hiện tên múi giờ"

#. i18n: ectx: property (whatsThis), widget (QCheckBox, showTimeZone)
#: clockConfig.ui:282
msgid "Display the time zone name under the time."
msgstr "Hiện tên múi giờ bên dưới thời gian."

#. i18n: ectx: property (text), widget (QLabel, label_5)
#: clockConfig.ui:307
msgid "Show seconds:"
msgstr "Hiện giây:"

#. i18n: ectx: property (toolTip), widget (QCheckBox, secondsCheckbox)
#: clockConfig.ui:322
msgid "Show the seconds"
msgstr "Hiện số giây hiện tại"

#. i18n: ectx: property (whatsThis), widget (QCheckBox, secondsCheckbox)
#: clockConfig.ui:325
msgid "Check this if you want to show the seconds."
msgstr "Chọn nếu bạn muốn hiện số giây hiện tại."

#. i18n: ectx: property (text), widget (QLabel, label_3)
#: clockConfig.ui:350
msgid "Date format:"
msgstr "Định dạng ngày:"

