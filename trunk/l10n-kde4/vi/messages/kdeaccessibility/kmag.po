#: kmag.cpp:138
msgid "New &Window"
msgstr "Cửa sổ &Mới"

#: kmag.cpp:141
msgid "Open a new KMagnifier window"
msgstr "Mở cửa sổ Kính lúp K mới"

#: kmag.cpp:145
msgid "&Stop"
msgstr "&Dừng"

#: kmag.cpp:148
msgid "Click to stop window refresh"
msgstr "Bấm để dừng việc cập nhật cửa sổ"

#: kmag.cpp:149
msgid ""
"Clicking on this icon will <b>start</b> / <b>stop</b>  updating of the "
"display. Stopping the update will zero the processing power  required (CPU "
"usage)"
msgstr ""
"Bấm vào biểu tượng này sẽ <b>chạy</b> / <b>dừng</b> cập nhật hiển thị trong "
"cửa sổ. Dừng việc cập nhật sẽ giúp bộ vi xử lý (CPU) được nghỉ ngơi."

#: kmag.cpp:155
msgid "&Save Snapshot As..."
msgstr "&Lưu Khung nhìn..."

#: kmag.cpp:158
msgid "Saves the zoomed view to an image file."
msgstr "Lưu khung nhìn được phóng đại thành tập tin hình ảnh."

#: kmag.cpp:159
msgid "Save image to a file"
msgstr "Lưu hình ảnh vào một tập tin"

#: kmag.cpp:162
msgid "Click on this button to print the current zoomed view."
msgstr "Ấn vào nút này để in khung nhìn phóng đại hiện tại"

#: kmag.cpp:165 kmag.cpp:166
msgid "Quits the application"
msgstr "Thoát khỏi ứng dụng"

#: kmag.cpp:169
msgid ""
"Click on this button to copy the current zoomed view to the clipboard which "
"you can paste in other applications."
msgstr ""
"Ấn vào nút này để sao chép khung nhìn phóng đại hiện tại vào bảng nháp, để "
"bạn có thể dán vào các ứng dụng khác."

#: kmag.cpp:170
msgid "Copy zoomed image to clipboard"
msgstr "Sao chép hình phóng đại vào bảng nháp"

#: kmag.cpp:172
msgid "Show &Menu"
msgstr "Hiện T&hực đơn"

#: kmag.cpp:177
msgid "Hide &Menu"
msgstr "&Giấu Thực đơn"

#: kmag.cpp:179
msgid "Show Main &Toolbar"
msgstr "Hiện Thanh &công cụ Chính"

#: kmag.cpp:183
msgid "Hide Main &Toolbar"
msgstr "Giấu Thanh cô&ng cụ Chính"

#: kmag.cpp:185
msgid "Show &View Toolbar"
msgstr "Hiện Thanh công cụ &Xem"

#: kmag.cpp:189
msgid "Hide &View Toolbar"
msgstr "Giấu Thanh côn&g cụ Xem"

#: kmag.cpp:191
msgid "Show &Settings Toolbar"
msgstr "Hiện Thanh công cụ &Cài đặt"

#: kmag.cpp:195
msgid "Hide &Settings Toolbar"
msgstr "Giấu Thanh công cụ Cà&i đặt"

#: kmag.cpp:198
msgid "&Follow Mouse Mode"
msgstr "Th&eo Chế độ Chuột"

#: kmag.cpp:202
msgid "Magnify around the mouse cursor"
msgstr "Phóng đại xung quanh con trỏ chuột"

#: kmag.cpp:203
msgid "If selected, the area around the mouse cursor is magnified"
msgstr "Trong chế độ này, vùng xung quanh con trỏ chuột sẽ được phóng đại"

#: kmag.cpp:205
msgid "Se&lection Window Mode"
msgstr "Chọ&n Chế độ Cửa sổ"

#: kmag.cpp:209
msgid "Show a window for selecting the magnified area"
msgstr "Hiện một cửa sổ để chọn khu vực được phóng đại"

#: kmag.cpp:211
msgid "&Whole Screen Mode"
msgstr "Chế độ &Toàn Màn hình"

#: kmag.cpp:215
msgid "Magnify the whole screen"
msgstr "Phóng đại toàn bộ màn hình"

#: kmag.cpp:216
#, fuzzy
msgid "Click on this button to fit the zoom view to the zoom window."
msgstr "Ấn vào nút này để làm khung nhìn vừa với cửa sổ nhìn."

#: kmag.cpp:218
msgid "Hide Mouse &Cursor"
msgstr "&Giấu Con trỏ Chuột"

#: kmag.cpp:223
msgid "Show Mouse &Cursor"
msgstr "Hiện &Con trỏ Chuột"

#: kmag.cpp:225
msgid "Hide the mouse cursor"
msgstr "Giấu con trỏ chuột"

#: kmag.cpp:228
msgid "Click on this button to <b>zoom-in</b> on the selected region."
msgstr "Ấn vào nút này để <b>phóng đại</b> vùng được chọn."

#: kmag.cpp:230
msgid "&Zoom"
msgstr "&Phóng"

#: kmag.cpp:233
msgid "Select the zoom factor."
msgstr "Chọn mức độ phóng đại."

#: kmag.cpp:234
msgid "Zoom factor"
msgstr "Mức phóng đại"

#: kmag.cpp:237
msgid "Click on this button to <b>zoom-out</b> on the selected region."
msgstr "Ấn vào nút này để <b>thu nhỏ</b> vùng được chọn."

#: kmag.cpp:239
msgid "&Rotation"
msgstr "&Quay"

#: kmag.cpp:242
msgid "Select the rotation degree."
msgstr "Chọn góc quay."

#: kmag.cpp:243
msgid "Rotation degree"
msgstr "Góc quay"

#: kmag.cpp:250
msgid "&Refresh"
msgstr "&Cập nhật"

#: kmag.cpp:253
msgid ""
"Select the refresh rate. The higher the rate, the more computing power (CPU) "
"will be needed."
msgstr ""
"Chọn tốc độ cập nhật. Tốc độ cao đòi hỏi bộ vi xử lý (CPU) tính nhiều hơn."

#: kmag.cpp:254
msgid "Refresh rate"
msgstr "Tốc độ cập nhật"

#: kmag.cpp:256
#, fuzzy
#| msgid "&Invert Colors"
msgid "&Color"
msgstr "&Nghịch đảo Màu"

#: kmag.cpp:259
msgid "Select a mode to simulate various types of color-blindness."
msgstr ""

#: kmag.cpp:260
msgid "Color-blindness Simulation Mode"
msgstr ""

#: kmag.cpp:617
msgid "Save Snapshot As"
msgstr "Lưu Khung nhìn"

#: kmag.cpp:627
msgid ""
"Unable to save temporary file (before uploading to the network file you "
"specified)."
msgstr ""
"Không thể lưu vào tập tin tạm thời (trước khi tải lên tập tin mạng bạn chỉ "
"định)."

#: kmag.cpp:628 kmag.cpp:632 kmag.cpp:645
msgid "Error Writing File"
msgstr "Lỗi Ghi ra Tập tin"

#: kmag.cpp:631
msgid "Unable to upload file over the network."
msgstr "Không thể tải lên tập tin qua mạng."

#: kmag.cpp:634 kmag.cpp:647
#, kde-format
msgid ""
"Current zoomed image saved to\n"
"%1"
msgstr ""
"Hình phóng đại hiện nay đã lưu vào\n"
"%1"

#: kmag.cpp:635 kmag.cpp:648
msgid "Information"
msgstr "Thông tin"

#: kmag.cpp:644
msgid ""
"Unable to save file. Please check if you have permission to write to the "
"directory."
msgstr ""
"Không thể lưu tập tin. Xin kiểm tra lại bạn có được phép ghi vào thư mục đã "
"chọn không."

#: kmag.cpp:663
msgid "Stop"
msgstr "Dừng"

#: kmag.cpp:664
msgid "Click to stop window update"
