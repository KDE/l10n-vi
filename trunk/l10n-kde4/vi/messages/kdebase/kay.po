#: medianotifier.cpp:207
#, qt-format
msgid ""
"An autorun file as been found on your '%1'. Do you want to execute it?\n"
"Note that executing a file on a medium may compromise your system's security"
msgstr "Tìm thấy một tập tin tự động chạy trên « %1 ». Thực hiện nó?\n"
"Chú ý rằng thực hiện một tập tin trên một ổ tháo rời có thể là một lỗ hổng bảo mật."

#: medianotifier.cpp:211
#, qt-format
msgid "Autorun - %1"
msgstr "Tự động chạy - %1"

#: medianotifier.cpp:276
#, qt-format
msgid ""
"An autoopen file as been found on your '%1'. Do you want to open '%2'?\n"
"Note that opening a file on a medium may compromise your system's security"
msgstr "Tìm thấy một tập tin tự động mở trên « %1 ». Mở « %2 » không?\n"
"Chú ý rằng mở một tập tin trên một ổ tháo rời có thể là một lỗ hổng bảo mật."

#: medianotifier.cpp:280
#, qt-format
msgid "Autoopen - %1"
msgstr "Tự động mở - %1"

