#. i18n: tag string
#. i18n: file generaltab.ui line 43
#: rc.cpp:6
msgid ""
"If this option is enabled, the sound system will be loaded on KDE startup.\n"
"Recommended if you want sound."
msgstr ""
"Nếu dùng tuỳ chọn này, thì máy chủ sẽ được nạp khi KDE khởi động.\n"
"Khuyên dùng nếu bạn muốn có âm thanh."

#. i18n: tag string
#. i18n: file generaltab.ui line 65
#: rc.cpp:10
msgid "Networked Sound"
msgstr "Âm thanh mạng"

#. i18n: tag string
#. i18n: file generaltab.ui line 76
#: rc.cpp:13
msgid ""
"<i>Enable this option if you want to play sound on a remote computer or you "
"want to be able to control sound on this system from another computer.</i>"
msgstr ""
"<i>Dùng tùy chọn này nếu bạn muốn nghe âm thanh trên một máy ở xa hoặc muốn "
"điều khiển âm thanh trên máy này từ những máy khác.</i>"

#. i18n: tag string
#. i18n: file generaltab.ui line 84
#: rc.cpp:16
msgid "Enable &networked sound"
msgstr "Dùng âm thanh &mạng"

#. i18n: tag string
#. i18n: file generaltab.ui line 87
#: rc.cpp:19
msgid ""
"This option allows sound requests coming in from over the network to be "
"accepted, instead of just limiting the server to the local computer."
msgstr ""
"Tuỳ chọn này cho phép chấp nhận các yêu cầu âm thanh vào từ mạng, thay vì "
"giới hạn máy chủ trong phạm vi máy tính này."

#. i18n: tag string
#. i18n: file generaltab.ui line 97
#: rc.cpp:22
msgid "Skip Prevention"
msgstr "Bỏ qua sự cản trở"

#. i18n: tag string
#. i18n: file generaltab.ui line 108
#: rc.cpp:25
msgid ""
"<i>If your sound is skipping during playback, enable running with highest "
"possible priority. Increasing your sound buffer might also help.</i>"
msgstr ""
"<i>Nếu âm thanh bị bỏ qua khi đang nghe, thì hãy chạy với ưu tiên cao nhât. "
"Tăng bộ đệm âm thanh cũng có thể giúp ích.</i>"

#. i18n: tag string
#. i18n: file generaltab.ui line 116
#: rc.cpp:28
msgid "&Run with the highest possible priority (realtime priority)"
msgstr "&Chạy với ưu tiên cao nhất có thể (ưu tiên thời gian thực)"

#. i18n: tag string
#. i18n: file generaltab.ui line 122
#: rc.cpp:31
msgid ""
"On systems which support realtime scheduling, if you have sufficient "
"permissions, this option will enable a very high priority for processing "
"sound requests."
msgstr ""
"Trên những hệ thống hỗ trợ lên lịch thời gian thực, nếu bạn có quyền tương "
"ứng, thì tuỳ chọn này sẽ cho phép dùng ưu tiên rất cao cho việc xử lí các "
"yêu cầu âm thanh."

#. i18n: tag string
#. i18n: file generaltab.ui line 153
#: rc.cpp:34
msgid "Sound &buffer:"
msgstr "&Bộ đệm âm thanh:"

#. i18n: tag string
#. i18n: file generaltab.ui line 164
#: rc.cpp:37
msgid ""
"<p align=\"right\"><b>Huge</b> buffer, for <b>low-end</b> machines, <b>less "
"skipping</b></p>"
msgstr ""
"<p align=\"right\">Bộ đệm<b>khổng lồ</b>, đối với các máy <b>đời mới</b>, "
"<b>nhỏ hơn thì bỏ qua</b></p>"

