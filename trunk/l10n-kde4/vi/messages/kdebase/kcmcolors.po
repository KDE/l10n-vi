#~ msgstr ""
#~ "Nhấn nút này để xóa bỏ những bộ màu đã chọn. Chú ý là nút này sẽ không "
#~ "dùng được nếu bạn không có đủ quyền để xoá bộ màu."

#~ msgid ""
