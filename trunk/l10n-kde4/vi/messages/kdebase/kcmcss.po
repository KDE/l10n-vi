msgstr "<b>Trắng trên đen</b><p>Đảo lại của sự pha màu truyền thống.</p>"

#. i18n: tag string
#. i18n: file csscustom.ui line 335
#: rc.cpp:144
msgid "Cus&tom"
msgstr "&Tuỳ biến"

#. i18n: tag string
#. i18n: file csscustom.ui line 338
#: rc.cpp:147
msgid ""
"<b>Custom</b><p>Select this option to define a custom color for the default "
"font.</p>"
msgstr ""
"<b>Tuỳ biến</b><p>Chọn tuỳ chọn này để xác định màu cho phông mặc định.</p>"

#. i18n: tag string
#. i18n: file csscustom.ui line 356
#. i18n: tag string
#. i18n: file csscustom.ui line 433
#: rc.cpp:150 rc.cpp:156
msgid ""
"<b>Foreground color</b><p>The foreground color is the color that the text is "
"drawn in.</p>"
msgstr "<b>Màu chữ</b><p>Màu chữ là màu của văn bản sẽ được hiển thị.</p>"

#. i18n: tag string
#. i18n: file csscustom.ui line 427
#: rc.cpp:153
msgid "&Foreground:"
msgstr "Cảnh &gần:"

#. i18n: tag string
#. i18n: file csscustom.ui line 446
#: rc.cpp:159
msgid ""
"<b>Background</b><p>Behind this door lays the ability to choose a custom "
"default background.</p>"
msgstr "<b>Nền</b><p>Sau cánh cửa này là khả năng chọn một nền mặc định.</p>"

#. i18n: tag string
#. i18n: file csscustom.ui line 453
#: rc.cpp:162
msgid "Bac&kground:"
msgstr "&Nền:"

#. i18n: tag string
#. i18n: file csscustom.ui line 459
#: rc.cpp:165
msgid ""
"<b>Background</b><p>This background color is the one displayed behind the "
"text by default. A background image will override this.</p>"
msgstr ""
"<b>Nền</b> <p> Màu nền là màu được hiển thị phía sau văn bản. Một hình ảnh "
"nền có thể ghi chèn lên tùy chọn này. </p>"

#. i18n: tag string
#. i18n: file csscustom.ui line 471
#: rc.cpp:168
msgid "Use same color for all text"
msgstr "Dùng chung màu cho mọi văn bản"

#. i18n: tag string
#. i18n: file csscustom.ui line 474
#: rc.cpp:171
msgid ""
"<b>Use same color for all text</b><p>Select this option to apply your chosen "
"color to the default font as well as any custom fonts as specified in a "
"stylesheet.</p>"
msgstr ""
"<b>Dùng chung màu cho mọi văn bản</b><p>Chọn tuỳ chọn này để áp dụng màu đã "
"chọn cho phông mặc định cũng như bất kì phông nào được chỉ ra trong tờ kiểu "
"dáng.</p>"

