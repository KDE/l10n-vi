"bạn có muốn các tập tin được di chuyển từ « %2 » sang « %3 » không?"

#: globalpaths.cpp:349
msgid "Confirmation Required"
msgstr "Cần thiết xác nhận"

#: globalpaths.cpp:349
#, fuzzy
