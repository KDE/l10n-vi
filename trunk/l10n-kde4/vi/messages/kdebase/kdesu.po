#: kdesu.cpp:86
msgid "KDE su"
msgstr "su của KDE"

#: kdesu.cpp:87
msgid "Runs a program with elevated privileges."
msgstr "Chạy một chương trình với quyền ưu tiên cao hơn."

#: kdesu.cpp:89
msgid "Copyright (c) 1998-2000 Geert Jansen, Pietro Iglio"
msgstr ""

#: kdesu.cpp:90
msgid "Geert Jansen"
msgstr ""

#: kdesu.cpp:90
msgid "Maintainer"
msgstr "Nhà duy trì"

#: kdesu.cpp:92
msgid "Pietro Iglio"
msgstr ""

#: kdesu.cpp:92
msgid "Original author"
msgstr "Tác giả gốc"

#: kdesu.cpp:100 kdesu.cpp:101
msgid "Specifies the command to run"
msgstr "Chỉ ra câu lệnh cần chạy"

#: kdesu.cpp:102
msgid "Run command under target uid if <file> is not writable"
msgstr "Chạy câu lệnh dưới uid đã chọn nếu <tập tin> là không ghi được"

#: kdesu.cpp:103
msgid "Specifies the target uid"
msgstr "Chỉ ra uid đích"

#: kdesu.cpp:104
msgid "Do not keep password"
msgstr "Không nhớ mật khẩu"

#: kdesu.cpp:105
msgid "Stop the daemon (forgets all passwords)"
msgstr "Dừng trình nền (dọn hết mọi mật khẩu)"

#: kdesu.cpp:106
msgid "Enable terminal output (no password keeping)"
msgstr "Dùng kết quả trong trình lệnh (không nhớ mật khẩu)"

#: kdesu.cpp:107
msgid "Set priority value: 0 <= prio <= 100, 0 is lowest"
msgstr "Đặt giá trị ưu tiên: 0 ≤ ưu tiên ≤ 100, 0 là thấp nhất"

#: kdesu.cpp:108
msgid "Use realtime scheduling"
msgstr "Dùng kế hoạch thời gian thực"

#: kdesu.cpp:109
msgid "Let command use existing dcopserver"
msgstr ""

#: kdesu.cpp:111
msgid "Do not display ignore button"
msgstr "Đừng hiển thị nút Bỏ qua"

#: kdesu.cpp:112
msgid "Specify icon to use in the password dialog"
msgstr "Chỉ ra biểu tượng dùng trong hộp thoại mật khẩu"

#: kdesu.cpp:113
msgid "Do not show the command to be run in the dialog"
msgstr "Không hiển thị câu lệnh cần chạy trong hộp thoại"

#: kdesu.cpp:136
#, kde-format
msgid "Command '%1' not found."
msgstr "Không tìm thấy lệnh '%1'."

#: kdesu.cpp:211
#, kde-format
msgid "Illegal priority: %1"
msgstr "Ưu tiên không hợp lệ: %1"

#: kdesu.cpp:242
msgid "No command specified."
msgstr "Không có lệnh nào được chỉ ra."

#: kdesu.cpp:344
msgid "Su returned with an error.\n"
msgstr "Su trả lại lỗi.\n"

#: kdesu.cpp:367
msgid "Command:"
msgstr "Câu lệnh:"

#: kdesu.cpp:373
msgid "realtime: "
msgstr "thời gian thực: "

#: kdesu.cpp:376
msgid "Priority:"
msgstr "Ưu tiên:"

#: rc.cpp:1
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "Phan Vĩnh Thịnh"

#: rc.cpp:2
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "teppi82@gmail.com"

#: sudlg.cpp:26
msgid "Ignore"
msgstr "Bỏ qua"

#: sudlg.cpp:33
#, kde-format
msgid "Run as %1"
msgstr "Chạy dưới %1"

#: sudlg.cpp:37
msgid "Please enter your password below."
msgstr "Hãy nhập mật khẩu bên dưới."

#: sudlg.cpp:40
#, fuzzy
#| msgid ""
#| "The action you requested needs <b>root privileges</b>. Please enter "
#| "<b>root's<b> password below or click Ignore to continue with your current "
#| "privileges."
msgid ""
"The action you requested needs <b>root privileges</b>. Please enter "
"<b>root's</b> password below or click Ignore to continue with your current "
"privileges."
msgstr ""
"Hành động bạn yêu cầu cần <b>quyền của người chủ</b> (root). Hãy nhập mật "
"khẩu <b>chủ</b> dưới đây hoặc nhấn « Bỏ qua » để tiếp tục với quyền hạn hiện "
"tại của bạn."

#: sudlg.cpp:44
#, kde-format
msgid ""
"The action you requested needs additional privileges. Please enter the "
"password for <b>%1</b> below or click Ignore to continue with your current "
"privileges."
msgstr ""
"Hành động bạn yêu cầu đòi hỏi một số quyền bổ sung. Hãy nhập mật khẩu cho <b>"
"%1</b> dưới đây hay nhấn « Bỏ qua » để tiếp tục với quyền hạn hiện tại của "
"bạn."

#: sudlg.cpp:53
msgid "&Ignore"
msgstr "&Bỏ qua"

#: sudlg.cpp:68
msgid "Conversation with su failed."
msgstr "Giao tiếp với su thất bại."

#: sudlg.cpp:75
#, fuzzy
#| msgid ""
#| "The program 'su' is not found.<br>Make sure your PATH is set correctly."
msgid ""
"The program 'su' is not found.<br />Make sure your PATH is set correctly."
msgstr ""
"Không tìm thấy chương trình 'su';<br>hãy kiểm tra lại biến môi trường đường "
"dẫn PATH."

#: sudlg.cpp:86
msgid "Incorrect password, please try again."
msgstr "Mật khẩu sai; hãy thử lại."

#: sudlg.cpp:90
msgid "Internal error: illegal return from SuProcess::checkInstall()"
msgstr "Lỗi nội bộ: giá trị trả về không hợp lệ từ SuProcess::checkInstall()"
