msgstr ""
"Đưa ra danh sách mỗi mục trên một dòng (dùng cho các danh sách lựa chọn và "
"mở tập tin bằng --multiple)"

#: kdialog.cpp:808
msgid "Outputs the winId of each dialog"
msgstr "Đưa ra winId (mã số cửa sổ) của mỗi hộp thoại"

