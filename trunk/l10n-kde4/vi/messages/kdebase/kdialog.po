msgstr "Mục mặc định dùng cho các hộp kết hợp và thực đơn"

#: kdialog.cpp:92
msgid ""
"Allows the --getopenurl and --getopenfilename options to return multiple "
"files"
msgstr "Cho phép các tùy chọn --getopenurl và --getopenfilename trả lại nhiều tập tin"

#: kdialog.cpp:93
msgid ""
"Return list items on separate lines (for checklist option and file open with "
"--multiple)"
msgstr "Đưa ra danh sách mỗi mục trên một dòng (dùng cho các danh sách lựa chọn và "
"mở tập tin bằng --multiple)"

#: kdialog.cpp:94
msgid "Outputs the winId of each dialog"
msgstr "Đưa ra id cửa sổ của mỗi hộp thoại"

#: kdialog.cpp:95
msgid "Makes the dialog transient for an X app specified by winid"
msgstr "Khiến hộp thoại không lâu cho một ứng dụng X chỉ ra theo id cửa sổ"

#: kdialog.cpp:96
msgid ""
"Config file and option name for saving the \"dont-show/ask-again\" state"
msgstr "Tập tin cấu hình và tên tùy chọn để ghi nhớ trạng thái \"đừng hiển thị/hỏi "
"lại\""

#: kdialog.cpp:98
msgid "Arguments - depending on main option"
msgstr "Tham số phụ thuộc vào tùy chọn chính"

