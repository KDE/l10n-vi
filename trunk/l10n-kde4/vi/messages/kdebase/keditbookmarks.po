#: main.cpp:65
#, qt-format
msgid ""
"Another instance of %1 is already running, do you really want to open "
"another instance or continue work in the same instance?\n"
"Please note that, unfortunately, duplicate views are read-only."
msgstr ""
"Một thể hiện %1 khác cũng đang chạy: bạn thực sự muốn mở thể hiện thêm nữa, "
"hoặc tiếp tục sử dụng thể hiện này?\n"
"Ghi chú rằng ô xem trùng chỉ cho bạn có quyền đọc."

#: main.cpp:68
msgid "Warning"
msgstr "Cảnh báo"

#: main.cpp:69
msgid "Run Another"
msgstr "Chạy điều thêm"

#: main.cpp:70
msgid "Continue in Same"
msgstr "Tiếp tục trong cùng"

