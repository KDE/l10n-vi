msgstr "Cuộc gọi DBUS supportsMarkup (hỗ trợ mã định dạng) không thành công."

#: khtmlkttsd.cpp:122
msgid "The DBUS call setText failed."
msgstr "Cuộc gọi DBUS setText (đặt văn bản) không thành công."

#: khtmlkttsd.cpp:126
msgid "The DBUS call startText failed."
msgstr "Cuộc gọi DCOP startText (bắt đầu văn bản) không thành công."

