msgid "D-Bus Call Failed"
msgstr "Gọi qua D-Bus Không Thành công"

#: khtmlkttsd.cpp:86
msgid "The D-Bus call supportsMarkup failed."
msgstr "Gọi supportsMarkup (hỗ trợ mã định dạng) qua D-Bus không thành công."

#: khtmlkttsd.cpp:122
msgid "The D-Bus call setText failed."
msgstr "Gọi setText (đặt văn bản) qua D-Bus không thành công."

#: khtmlkttsd.cpp:126
msgid "The D-Bus call startText failed."
msgstr "Gọi startText (bắt đầu văn bản) qua D-Bus không thành công."

