#: panner.cpp:90
msgid "Scroll left"
msgstr "Cuộn trái"

#: panner.cpp:91
msgid "Scroll right"
msgstr "Cuộn phải"

#: panner.cpp:103
msgid "Scroll up"
msgstr "Cuộn lên"

#: panner.cpp:104
msgid "Scroll down"
msgstr "Cuộn xuống"

#. i18n: tag label
#. i18n: file extensionSettings.kcfg line 13
#: rc.cpp:4
#, no-c-format
msgid ""
"Whether this panel actually exists or not. Primarly to work around the fact "
"that KConfigXT won't write a config file unless there is at least one non-"
"default entry."
msgstr ""
"Bảng này có tồn tại không. Chính để chỉnh sửa trường hợp KConfigXT sẽ không "
"ghi tập tin cấu hình nếu không có mục nhập mặc định."

#. i18n: tag label
#. i18n: file extensionSettings.kcfg line 17
#: rc.cpp:8
#, no-c-format
msgid "The position of the panel"
msgstr "Vị trí của bảng"

#. i18n: tag label
#. i18n: file extensionSettings.kcfg line 24
#: rc.cpp:12
#, no-c-format
msgid "The alignment of the panel"
msgstr "Chỉnh canh bảng"

#. i18n: tag label
#. i18n: file extensionSettings.kcfg line 31
#: rc.cpp:16
#, no-c-format
msgid "Primary xinerama screen"
msgstr "Màn hình Xinerama chính"

#. i18n: tag label
#. i18n: file extensionSettings.kcfg line 36
#: rc.cpp:20
#, no-c-format
msgid "Hide button size"
msgstr "Ẩn cỡ nút"

#. i18n: tag label
#. i18n: file extensionSettings.kcfg line 43
#: rc.cpp:24
#, no-c-format
msgid "Show left panel hide button"
msgstr "Hiện nút ẩn bảng bên trái"

#. i18n: tag label
#. i18n: file extensionSettings.kcfg line 48
#: rc.cpp:28
#, no-c-format
msgid "Show right panel hide button"
msgstr "Hiện nút ẩn bảng bên phải"

#. i18n: tag label
#. i18n: file extensionSettings.kcfg line 53
#: rc.cpp:32
#, no-c-format
msgid "Auto hide panel"
msgstr "Tự động ẩn bảng"

#. i18n: tag label
#. i18n: file extensionSettings.kcfg line 58
#: rc.cpp:36
#, no-c-format
msgid "Enable auto hide"
msgstr "Bật tự động ẩn"

#. i18n: tag label
#. i18n: file extensionSettings.kcfg line 63
#: rc.cpp:40
#, no-c-format
msgid "Delay before auto hide"
msgstr "Trễ trước khi tự động ẩn"

#. i18n: tag label
#. i18n: file extensionSettings.kcfg line 68
#: rc.cpp:44
#, no-c-format
msgid "The trigger location for unhides"
msgstr "Vị trí gây ra hủy ẩn"

#. i18n: tag label
#. i18n: file extensionSettings.kcfg line 75
#: rc.cpp:48
#, no-c-format
msgid "Enable background hiding"
msgstr "Bật ẩn nền"

#. i18n: tag label
#. i18n: file extensionSettings.kcfg line 80
#: rc.cpp:52
#, no-c-format
msgid "Animate panel hiding"
msgstr "Hoạt ảnh ẩn bảng"

#. i18n: tag label
#. i18n: file extensionSettings.kcfg line 85
#: rc.cpp:56
#, no-c-format
msgid "Panel hiding animation speed"
msgstr "Tốc độ hoạt ảnh ẩn bảng"

#. i18n: tag label
#. i18n: file extensionSettings.kcfg line 90
#: rc.cpp:60
#, no-c-format
msgid "Length in percentage"
msgstr "Độ dài theo phần trăm"

#. i18n: tag label
#. i18n: file extensionSettings.kcfg line 97
#: rc.cpp:64
#, no-c-format
msgid "Expand as required to fit contents"
msgstr "Mở rộng như cần thiết để vừa khít nội dung"

#. i18n: tag label
#. i18n: file extensionSettings.kcfg line 102
#: rc.cpp:68
#, no-c-format
msgid "Size"
msgstr "Cỡ"

#. i18n: tag label
#. i18n: file extensionSettings.kcfg line 107
#: rc.cpp:72
#, no-c-format
msgid "Custom size"
msgstr "Cỡ tự chọn"

#. i18n: tag label
#. i18n: file kickerSettings.kcfg line 15
#: rc.cpp:76
#, no-c-format
msgid ""
"When this option is enabled, the panels may not be moved and items cannot be "
"removed or added"
msgstr ""
"Khi bật tùy chọn này, thì không di chuyển được các thanh panel và không xóa "
"hay thêm được các mục"

#. i18n: tag label
#. i18n: file kickerSettings.kcfg line 20
#: rc.cpp:80
#, no-c-format
msgid "Enable conserve space"
msgstr "Dùng sự giữ khoảng cách"

#. i18n: tag label
#. i18n: file kickerSettings.kcfg line 25
#: rc.cpp:84
#, no-c-format
msgid "Raise when the pointer touches the screen here"
msgstr "Hiện lên trên khi con trỏ chạm vào màn hình ở đây"

#. i18n: tag label
#. i18n: file kickerSettings.kcfg line 30
#: rc.cpp:88
#, no-c-format
msgid "Fade out applet handles"
msgstr "Mờ dần điều khiển trình nhỏ"

#. i18n: tag whatsthis
#. i18n: file kickerSettings.kcfg line 32
#: rc.cpp:92
#, no-c-format
msgid ""
"Select this option to make applet handles only visible on mouse hover. "
"Applet handles let you move, remove and configure applets."
msgstr ""
"Chọn tùy chọn này để khiến điều khiển trình nhỏ chỉ thấy khi đặt con trỏ "
"lên. Điều khiển cho phép bạn di chuyển, xóa và cấu hình trình nhỏ."

#. i18n: tag label
#. i18n: file kickerSettings.kcfg line 36
#: rc.cpp:96
#, no-c-format
msgid "Hide applet handles"
msgstr "Ẩn điều khiển trình nhỏ"

#. i18n: tag whatsthis
#. i18n: file kickerSettings.kcfg line 38
#: rc.cpp:100
#, no-c-format
msgid ""
"Select this option to always hide the applet handles. Beware this could "
"disable moving, removing or configuring some applets."
msgstr ""
"Chọn tùy chọn này để luôn luôn ẩn điều khiển trình nhỏ. Cần biết là như vậy "
"sẽ không thể di chuyển, xóa hoặc cấu hình một vài trình nhỏ."

#. i18n: tag label
#. i18n: file kickerSettings.kcfg line 42
#: rc.cpp:104
#, no-c-format
msgid ""
"A list of applets that have been loaded at runtime. In the case of a crash "
"these applets will not be loaded at the next Kicker start, in case they "
"caused the crash"
msgstr ""
"Một danh sách các trình nhỏ được nạp khi chạy. Trong trường hợp có lỗi crash "
"những trình nhỏ này sẽ không được nạp ở lần chạy Kicker tiếp theo, nếu chúng "
"gây ra lỗi này"

#. i18n: tag label
#. i18n: file kickerSettings.kcfg line 46
#: rc.cpp:108
#, no-c-format
msgid ""
"A list of extensions that have been loaded at runtime. In the case of a "
"crash these extensions will not be loaded at the next Kicker start, in case "
"they caused the crash"
msgstr ""
"Một danh sách các mở rộng được nạp khi chạy. Trong trường hợp có lỗi crash "
"những mở rộng này sẽ không được nạp ở lần chạy Kicker tiếp theo, nếu chúng "
"gây ra lỗi này"

#. i18n: tag label
#. i18n: file kickerSettings.kcfg line 56
#: rc.cpp:112
#, no-c-format
msgid "Show simple menu entries"
msgstr "Hiển thị các mục thực đơn đơn giản"

#. i18n: tag label
#. i18n: file kickerSettings.kcfg line 59
#: rc.cpp:116
#, no-c-format
msgid "Show names first on detailed entries"
msgstr "Hiển thị tên đầu tiên trong mục chi tiết"

#. i18n: tag label
#. i18n: file kickerSettings.kcfg line 62
#: rc.cpp:120
#, no-c-format
msgid "Show only description for menu entries"
msgstr "Chỉ hiển thị mô tả cho các mục thực đơn"

#. i18n: tag label
#. i18n: file kickerSettings.kcfg line 65
#: rc.cpp:124
#, no-c-format
msgid "Show detailed menu entries"
msgstr "Hiển thị các mục thực đơn chi tiết"

#. i18n: tag label
#. i18n: file kickerSettings.kcfg line 69
#: rc.cpp:128
#, no-c-format
msgid "Formation of the menu entry text"
msgstr "Định dạng chữ của mục thực đơn"

#. i18n: tag label
#. i18n: file kickerSettings.kcfg line 73
#: rc.cpp:132
#, no-c-format
msgid "Show section titles in Kmenu"
msgstr "Hiển thị tiêu đề phần trong thực đơn K"

#. i18n: tag label
#. i18n: file kickerSettings.kcfg line 78
#: rc.cpp:136
#, no-c-format
msgid "Height of menu entries in pixels"
msgstr "Chiều cao của mục thực đơn theo điểm"

#. i18n: tag label
#. i18n: file kickerSettings.kcfg line 83
#: rc.cpp:140
#, no-c-format
msgid "Show hidden files in Quick Browser"
msgstr "Hiển thị các tập tin ẩn trong Trình duyệt nhanh"

#. i18n: tag label
#. i18n: file kickerSettings.kcfg line 88
#: rc.cpp:144
#, no-c-format
msgid "Maximum number of entries"
msgstr "Số mục lớn nhất"

#. i18n: tag label
#. i18n: file kickerSettings.kcfg line 94
#: rc.cpp:148
#, no-c-format
msgid "Show bookmarks in KMenu"
msgstr "Hiển thị đánh dấu trong thực đơn K"

#. i18n: tag label
#. i18n: file kickerSettings.kcfg line 99
#: rc.cpp:152
#, no-c-format
msgid "Use the Quick Browser"
msgstr "Dùng Trình duyệt nhanh"

#. i18n: tag label
#. i18n: file kickerSettings.kcfg line 104
#: rc.cpp:156
#, no-c-format
msgid "Optional Menus"
msgstr "Thực đơn tự chọn"

#. i18n: tag label
#. i18n: file kickerSettings.kcfg line 108
#: rc.cpp:160
#, no-c-format
msgid "Recently used applications"
msgstr "Ứng dụng mới dùng"

#. i18n: tag label
#. i18n: file kickerSettings.kcfg line 112
#: rc.cpp:164
#, no-c-format
msgid "Number of visible entries"
msgstr "Số ứng dụng hiển thị"

#. i18n: tag label
#. i18n: file kickerSettings.kcfg line 118
#: rc.cpp:168
#, no-c-format
msgid "Show most recently used applications rather than most frequently used"
msgstr "Hiển thị những ứng dụng được dùng gần đây nhất thay cho thường dùng"

#. i18n: tag label
#. i18n: file kickerSettings.kcfg line 127
#: rc.cpp:172
#, no-c-format
msgid "Use side image in Kmenu"
msgstr "Dùng ảnh nằm bên trong thực đơn K"

#. i18n: tag label
#. i18n: file kickerSettings.kcfg line 132
#: rc.cpp:176
#, no-c-format
msgid "The name of the file to use as the side image in the K Menu"
msgstr "Tên của tập tin dùng làm ảnh nằm bên trong thực đơn K"

#. i18n: tag label
#. i18n: file kickerSettings.kcfg line 137
#: rc.cpp:180
#, no-c-format
msgid ""
"The name of the file used as a tile to fill the height of K Menu that "
"SidePixmapName does not cover"
msgstr ""
"Tên của tập tin dùng để lát nền theo chiều cao của thực đơn K mà "
"SidePixmapName không lát được"

#. i18n: tag label
#. i18n: file kickerSettings.kcfg line 142
#: rc.cpp:184
#, no-c-format
msgid "Show text on the K Menu button"
msgstr "Hiển thị chữ trên nút thực đơn K"

#. i18n: tag label
#. i18n: file kickerSettings.kcfg line 147
#: rc.cpp:188
#, no-c-format
msgid "Text to be shown on K Menu Button"
msgstr "Chữ hiển thị trên nút thực đơn K"

#. i18n: tag label
#. i18n: file kickerSettings.kcfg line 156
#: rc.cpp:192
#, no-c-format
msgid "Enable icon mouse over effects"
msgstr "Dùng hiệu ứng biểu tượng khi đặt chuột lên"

#. i18n: tag label
#. i18n: file kickerSettings.kcfg line 161
#: rc.cpp:196
#, no-c-format
msgid "Show icons in mouse over effects"
msgstr "Hiển thị biểu tượng trong hiệu ứng khi đặt chuột lên"

#. i18n: tag label
#. i18n: file kickerSettings.kcfg line 166
#: rc.cpp:200
#, no-c-format
msgid "Show text in mouse over effects"
msgstr "Hiển thị tên biểu tượng trong hiệu ứng khi đặt chuột lên"

#. i18n: tag label
#. i18n: file kickerSettings.kcfg line 171
#: rc.cpp:204
#, no-c-format
msgid ""
"Controls how fast the tooltips fade in, measured in thousandths of a second"
msgstr "Điều khiển thời gian mờ đi của lời mách, tính theo phần nghìn giây"

#. i18n: tag label
#. i18n: file kickerSettings.kcfg line 177
#: rc.cpp:208
#, no-c-format
msgid "Mouse over effects are shown after the defined time (in milliseconds)"
msgstr ""
"Hiệu ứng khi đặt chuột lên hiển thị sau thời gian chỉ ra (theo mili giây)"

#. i18n: tag label
#. i18n: file kickerSettings.kcfg line 182
#: rc.cpp:212
#, no-c-format
msgid "Mouse over effects are hidden after the defined time (in milliseconds)"
msgstr "Hiệu ứng khi đặt chuột lên ẩn đi sau thời gian chỉ ra (theo mili giây)"

#. i18n: tag label
#. i18n: file kickerSettings.kcfg line 187
#: rc.cpp:216
#, no-c-format
msgid "The margin between panel icons and the panel border"
msgstr "Khoảng cách lề giữa biểu tượng và đường biên thanh panel"

#. i18n: tag label
#. i18n: file kickerSettings.kcfg line 192
#: rc.cpp:220
#, no-c-format
msgid ""
"Buttons that represent KServices (applications, primarily) watch for the "
"removal of the service and delete themselves when this happens. This setting "
"turns this off."
msgstr ""
"Các nút KServices (chủ yếu là ứng dụng) theo dõi sự xóa bỏ ứng dụng và khi "
"đó chúng sẽ tự xóa. Thiết lập này sẽ tắt bỏ tính năng đó."

#. i18n: tag label
#. i18n: file kickerSettings.kcfg line 197
#: rc.cpp:224
#, no-c-format
msgid "Font for the buttons with text."
msgstr "Phông dùng cho các nút có chữ."

#. i18n: tag label
#. i18n: file kickerSettings.kcfg line 202
#: rc.cpp:228
#, no-c-format
msgid "Text color for the buttons."
msgstr "Màu chữ cho các nút."

#~ msgid "Enable transparency"
#~ msgstr "Dùng trong suốt"

#~ msgid ""
#~ "When this option is enabled, the panel will become pseudo-transparent"
#~ msgstr "Khi tùy chọn này bật, thanh panel sẽ trở thành giả trong suốt"

#~ msgid "Enable transparency for menubar panel"
#~ msgstr "Dùng trong suốt cho thanh panel thực đơn"

#~ msgid ""
#~ "When this option is enabled, the panel containing the menubar will become "
#~ "pseudo-transparent as well"
#~ msgstr ""
#~ "Khi tùy chọn này bật, thanh panel chứa thanh thực đơn cũng sẽ trở thành "
#~ "giả trong suốt"

#~ msgid ""
#~ "When this option is enabled, the panel will display a tiled image as its "
#~ "background"
#~ msgstr ""
#~ "Khi tùy chọn này bật, thanh panel sẽ hiển thị một hình để lát làm nền"

#~ msgid "Enable colourized background."
#~ msgstr "Dùng nền màu."

#~ msgid "Rotate background"
#~ msgstr "Quay nền"

#~ msgid ""
#~ "When this option is enabled, when the panel is placed on the side or top "
#~ "edges of the screen, the background image will be rotated to match the "
#~ "panel's orientation"
#~ msgstr ""
#~ "Khi tùy chọn này bật, khi thanh panel đặt ở bên hoặc đỉnh màn hình, thì "
#~ "ảnh nền sẽ được quay để hợp với hướng của panel"

#~ msgid "Background image"
#~ msgstr "Ảnh nền"

#~ msgid ""
#~ "Here you can choose an image to be displayed on the panel. Press the "
#~ "'browse' button to choose a theme using the file dialog. This option is "
#~ "only effective if 'Enable background image' is selected"
#~ msgstr ""
#~ "Ở đây bạn có thể chọn một hình ảnh để hiển thị trên thanh panel. Nhấn nút "
#~ "'duyệt' để chọn một sắc thái dùng hộp thoại tập tin. Tùy chọn này chỉ có "
#~ "tác dụng nếu chọn 'Dùng ảnh nền'"

#~ msgid ""
#~ "Controls the saturation level of the tint color used with transparent "
#~ "panels"
#~ msgstr ""
#~ "Điều khiển độ bão hoà của màu nhẹ sử dụng cho các thanh panel trong suốt"

#~ msgid "The tint color used to colorize transparent panels"
#~ msgstr "Màu nhẹ sử dụng cho các thanh panel trong suốt có màu"

#~ msgid "This option sets the color to use when tinting transparent panels"
#~ msgstr ""
#~ "Tùy chọn này chọn màu dùng khi tô màu nhẹ các thanh panel trong suốt"

#~ msgid "Show informational tooltips"
#~ msgstr "Hiển thị lời mách có ích"

#~ msgid "Enable a tile background image for the KMenu button"
#~ msgstr "Dùng ảnh nền lát cho nút thực đơn K"

#~ msgid "Enable a tile background image for the Desktop button"
#~ msgstr "Dùng ảnh nền lát cho nút Màn hình"

#~ msgid ""
#~ "Enable a tile background image for Application, URL and special buttons"
#~ msgstr "Dùng ảnh nền lát cho các nút Ứng dụng, URL và nút đặc biệt"

#~ msgid "Enable a tile background image for the Quick Browser button"
#~ msgstr "Dùng ảnh nền lát cho nút Trình duyệt nhanh"

#~ msgid "Enable a tile background image for the Window List button"
#~ msgstr "Dùng ảnh nền lát cho nút Danh sách cửa sổ"

#~ msgid "Image tile for Kmenu button background"
#~ msgstr "Ảnh lát nền cho nút thực đơn K"

#~ msgid "Color to use for Kmenu button background"
#~ msgstr "Màu dùng cho nền nút thực đơn K"

#~ msgid "Image tile for Desktop button background"
#~ msgstr "Ảnh lát nền cho nút Màn hình"

#~ msgid "Image tile for Application, URL and special button backgrounds"
#~ msgstr "Ảnh lát nền cho các nút Ứng dụng, URL và nút đặc biệt"

#~ msgid "Color to use for Application, URL and special button backgrounds"
#~ msgstr "Màu dùng cho nền của các nút Ứng dụng, URL và nút đặc biệt"

#~ msgid "Image tile for Browser button background"
#~ msgstr "Ảnh lát nền cho nút Trình duyệt"

#~ msgid "Color to use for Browser button background"
#~ msgstr "Màu dùng cho nền của nút Trình duyệt"

#~ msgid "Image tile for Window List button background"
#~ msgstr "Ảnh lát nền cho nút Danh sách cửa sổ"

#~ msgid "Color to use for Window List button background"
#~ msgstr "Màu dùng cho nền của nút Danh sách cửa sổ"

#~ msgid "Enable background tiles"
#~ msgstr "Dùng lát nền"
