#: interfaces/ktexteditor/kcm_ktexteditor.desktop:1
msgctxt "Name"
msgid "Embedded Text Editor"
msgstr "Bộ Soạn thảo Văn bản nhúng"

#: interfaces/ktexteditor/kcm_ktexteditor.desktop:80
msgctxt "Comment"
msgid ""
"The text editor service provides applications with a text viewer and editor. "
"KDE applications that provide text editing facilities should use this "
"service."
msgstr ""
"Dịch vụ soạn thảo văn bản cung cấp cho ứng dụng một bộ xem và soạn thảo văn "
"bản. Các ứng dụng KDE mà cung cấp khả năng soạn thảo văn bản nên dùng dịch "
"vụ này."

#: interfaces/ktexteditor/ktexteditor.desktop:5
msgctxt "Comment"
msgid "Embeddable Text Editor Component (with Doc/View Separation)"
msgstr ""
"Thành phần Soạn thảo Văn bản có nhúng được (có khả năng phân cách tài liệu/"
"khung xem)"

