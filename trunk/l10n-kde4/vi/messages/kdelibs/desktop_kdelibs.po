#: interfaces/kimproxy/interface/kcm_instantmessenger.desktop:1
msgctxt "Name"
msgid "Instant Messenger"
msgstr "Bộ tin nhắn"

#: interfaces/kimproxy/interface/kcm_instantmessenger.desktop:72
msgctxt "Comment"
msgid ""
"The instant messenger allows two-way chat between individuals and groups."
msgstr ""
"Bộ tin nhắn tức khắc cho phép trò chuyện hai chiều giữa người riêng và nhóm "
