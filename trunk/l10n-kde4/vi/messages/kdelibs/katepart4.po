"correct source encoding line for encoding \"%1\""
msgstr ""
"Bạn đang thử lưu một tập tin Python dạng khác ASCII, khi chưa xác định một "
"bảng mã nguồn đúng cho bảng mã « %1 »."

#: document/katedocument.cpp:135
msgid "No encoding header"
msgstr "Không có phần đầu bảng mã"

#: document/katedocument.cpp:136
#, qt-format
