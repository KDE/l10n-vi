msgstr "</p><ul><li>Địa chỉ Mạng: %1</li>"

#: kio/global.cpp:457
#, qt-format
msgid "<li>Protocol: %1</li>"
msgstr "<li>Giao thức: %1</li>"

#: kio/global.cpp:459
#, qt-format
