msgstr "Có lẽ thư mục đã ghi rõ không phải là rỗng."

#: kio/global.cpp:957
msgid "Ensure that the folder exists and is empty, and try again."
msgstr "Hãy kiểm tra xem thư mục này tồn tại, cũng là rỗng, rồi thử lại."

