#: volumeslider.cpp:36 volumeslider.cpp:48 volumeslider.cpp:161
#: volumeslider.cpp:172
#, qt-format
msgid "Volume: %1%"
msgstr "Âm lượng: %1%"

#: volumeslider.cpp:37 volumeslider.cpp:49 volumeslider.cpp:99
#, qt-format
msgid ""
"Use this slider to adjust the volume. The leftmost position is 0%, the "
"rightmost is %1%"
msgstr ""
"Hãy sử dụng con trượt này để điều chỉnh âm lượng. Vị trí ở cuối bên trái là "
"0, còn vị trí ở cuối bên phải là %1%."

#: volumeslider.cpp:158
msgid "Muted"
msgstr "Câm"

#: audiooutput.cpp:288
#, qt-format
msgid ""
"<html>The audio playback device <b>%1</b> does not work.<br/>Falling back to "
"<b>%2</b>.</html>"
msgstr ""
"<html>Thiết bị phát lại âm thanh <b>%1</b> không hoạt động được<br/>nên trở "
"về <b>%2</b>.</html>"

#: audiooutput.cpp:293
#, qt-format
msgid ""
"<html>Switching to the audio playback device <b>%1</b><br/>which just became "
"available and has higher preference.</html>"
msgstr ""
"<html>Đang chuyển đổi sang thiết bị phát lại âm thanh <b>%1</b><br/>mà mới "
"sẵn sàng và có ưu tiên cao hơn.</html>"

#: audiooutput.cpp:296
#, qt-format
msgid "Revert back to device '%1'"
msgstr "Trở về thiết bị « %1 »"

