#: kcm_krfb.cpp:60
msgid "Desktop Sharing Control Module"
msgstr "Môđun điều khiển chia sẻ màn hình"

#: kcm_krfb.cpp:62
msgid "Configure desktop sharing"
msgstr "Cấu hình chia sẻ màn hình"

#: kcm_krfb.cpp:63
msgid "(c) 2002, Tim Jansen\n"
msgstr "© năm 2002 của Tim Jansen\n"

#: kcm_krfb.cpp:65
msgid "Tim Jansen"
msgstr "Tim Jansen"

#: kcm_krfb.cpp:91
msgid "You have no open invitation."
msgstr "Bạn không có lời mời nào."

#: kcm_krfb.cpp:93
#, qt-format
msgid "Open invitations: %1"
msgstr "Tạo giấy mời: %1"

#: kcm_krfb.cpp:162
msgid ""
"<h1>Desktop Sharing</h1> This module allows you to configure the KDE desktop "
"sharing."
msgstr "<h1>Chia sẻ màn hình</h1> Môđun này cho phép bạn cấu hình sự chia sẻ màn "
"hình KDE."

#: rc.cpp:3
#. i18n: tag string
#. i18n: file configurationwidget.ui line 37
msgid "Acc&ess"
msgstr "&Truy cập"

#: rc.cpp:6
#. i18n: tag string
#. i18n: file configurationwidget.ui line 54
msgid "Invitations"
msgstr "Lời mời"

#: rc.cpp:9
#. i18n: tag string
#. i18n: file configurationwidget.ui line 74
msgid "You have no open invitations."
msgstr "Bạn không có lời mời nào."

#: rc.cpp:12
#. i18n: tag string
#. i18n: file configurationwidget.ui line 90
msgid "Create && &Manage Invitations..."
msgstr "Tạo && &quản lý giấy mời..."

#: rc.cpp:15
#. i18n: tag string
#. i18n: file configurationwidget.ui line 93
msgid "Click to view or delete the open invitations."
msgstr "Nhấn chuột để xem hay xóa lời mời."

#: rc.cpp:18
#. i18n: tag string
#. i18n: file configurationwidget.ui line 111
msgid "Uninvited Connections"
msgstr "Kết nối không được mời"

#: rc.cpp:21
#. i18n: tag string
#. i18n: file configurationwidget.ui line 128
msgid "Allow &uninvited connections"
msgstr "Cho phép kết nối &ngoài giấy mời"

#: rc.cpp:24
#. i18n: tag string
#. i18n: file configurationwidget.ui line 134
msgid "Select this option to allow connecting without inviting. This is useful if "
"you want to access your desktop remotely."
msgstr "Tùy chọn này cho phép kết nối mà không cần giấy mời. Có ích nếu bạn muốn "
"truy cập tới màn hình của mình từ xa."

#: rc.cpp:27
#. i18n: tag string
#. i18n: file configurationwidget.ui line 142
msgid "Announce service &on the network"
msgstr "Thông báo về &dịch vụ trong mạng"

#: rc.cpp:30
#. i18n: tag string
#. i18n: file configurationwidget.ui line 148
msgid "If you allow uninvited connections and enable this option, Desktop Sharing "
"will announce the service and your identity on the local network, so people "
"can find you and your computer."
msgstr "Nếu bạn cho phép các kết nối không cần giấy mời và bật tùy chọn này, trình "
"chia sẻ màn hình sẽ thông báo dịch vụ và thông tin của bạn lên mạng nội bộ. "
"Như thế, mọi người có thể tìm thấy máy tính này."

#: rc.cpp:33
#. i18n: tag string
#. i18n: file configurationwidget.ui line 156
msgid "Confirm uninvited connections &before accepting"
msgstr "Xem xét các kết nối &không giấy mời trước khi cho phép"

#: rc.cpp:36
#. i18n: tag string
#. i18n: file configurationwidget.ui line 159
msgid "If enabled, a dialog will appear when somebody attempts to connect, asking "
"you whether you want to accept the connection."
msgstr "Nếu bật, một hộp thoại sẽ hiện lên khi có ai đó muốn kết nối và hỏi bạn có "
"chấp nhận kết nối này hay không."

#: rc.cpp:39
#. i18n: tag string
#. i18n: file configurationwidget.ui line 167
msgid "A&llow uninvited connections to control the desktop"
msgstr "Ch&o phép các kết nối không giấy mời điều khiển màn hình"

#: rc.cpp:42
#. i18n: tag string
#. i18n: file configurationwidget.ui line 170
msgid "Enable this option to allow uninvited user to control your desktop (using "
"mouse and keyboard)."
msgstr "Bật tùy chọn này để cho phép người dùng không được mời điều khiển màn hình "
"(sử dụng chuột và bàn phím)."

#: rc.cpp:45
#. i18n: tag string
#. i18n: file configurationwidget.ui line 216
msgid "Pass&word:"
msgstr "&Mật khẩu:"

#: rc.cpp:48
#. i18n: tag string
#. i18n: file configurationwidget.ui line 233
msgid "If you allow uninvited connections, it is highly recommended to set a "
"password in order to protect your computer from unauthorized access."
msgstr "Nếu bạn cho phép kết nối không giấy mời, thì nên đặt một mật khẩu để phòng "
"ngừa các truy cập không mong muốn."

#: rc.cpp:51
#. i18n: tag string
#. i18n: file configurationwidget.ui line 264
msgid "&Session"
msgstr "Buổ&i làm việc"

#: rc.cpp:54
#. i18n: tag string
#. i18n: file configurationwidget.ui line 281
msgid "Session Preferences"
msgstr "Cấu hình buổi làm việc"

#: rc.cpp:57
#. i18n: tag string
#. i18n: file configurationwidget.ui line 298
msgid "Always disable &background image"
msgstr "Luôn luôn cắt bỏ &ảnh nền"

#: rc.cpp:60
#. i18n: tag string
#. i18n: file configurationwidget.ui line 304
msgid "Check this option to always disable the background image during a remote "
"session. Otherwise the client decides whether the background will be enabled "
"or disabled."
msgstr "Tùy chọn này cho phép cắt bỏ ảnh nền màn hình khi làm việc từ xa. Nếu không "
"máy khách sẽ quyết định có hiển thị ảnh nền hay không."

#: rc.cpp:63
#. i18n: tag string
#. i18n: file configurationwidget.ui line 333
msgid "&Network"
msgstr "Mạ&ng"

#: rc.cpp:66
#. i18n: tag string
#. i18n: file configurationwidget.ui line 350
msgid "Network Port"
msgstr "Cổng mạng"

#: rc.cpp:69
#. i18n: tag string
#. i18n: file configurationwidget.ui line 367
msgid "Assi&gn port automatically"
msgstr "Tự động chọn &cổng"

#: rc.cpp:72
#. i18n: tag string
#. i18n: file configurationwidget.ui line 373
msgid "Check this option to assign the network port automatically. This is "
"recommended unless your network setup requires you to use a fixed port, for "
"example because of a firewall."
msgstr "Tùy chọn này dùng để tự động chọn cổng. Nên dùng tùy chọn này, trừ khi thiết "
"lập mạng yêu cầu bạn sử dụng một cổng cố định. Ví dụ khi có tường lửa."

#: rc.cpp:75
#. i18n: tag string
#. i18n: file configurationwidget.ui line 404
msgid "P&ort:"
msgstr "Cổn&g:"

#: rc.cpp:78
#. i18n: tag string
#. i18n: file configurationwidget.ui line 424
msgid "Enter the TCP port number here"
msgstr "Nhập cổng TCP ở đây"

#: rc.cpp:81
#. i18n: tag string
#. i18n: file configurationwidget.ui line 428
msgid "Use this field to set a static port number for the desktop sharing service. "
"Note that if the port is already in use the Desktop Sharing service will not "
"be accessible until you free it. It is recommended to assign the port "
"automatically unless you know what you are doing.\n"
"Most VNC clients use a display number instead of the actual port. This "
"display number is the offset to port 5900, so port 5901 has the display "
"number 1."
msgstr "Sử dụng để đặt một cổng cố định cho dịch vụ chia sẻ màn hình. Chú ý rằng nếu "
"cổng đã được sử dụng, thì sẽ không thể dùng dịch vụ chia sẻ màn hình trước "
"khi cổng được giải phóng. Nên dùng chức năng tự động chọn cổng, nếu bạn "
"không biết phải làm gì.\n"
"Hầu hết các chương trình khách VNC sử dụng số màn hình thay cho cổng. Số màn "
"hình này được gắn với cổng 5900, vì thế cổng 5901 sẽ có số màn hình là 1."

