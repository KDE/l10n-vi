msgid ""
"All hosts with TCP/IP will respond,<br />whether or not they are samba "
"servers.<br />Don't use it if your network is very large, i.e. more than "
"1000 hosts.<br />"
msgstr ""
"Tất cả các máy có TCP/IP sẽ trả lời,<br> dù có là máy chủ samba hay không."
"<br>Không nên sử dụng nếu mạng rất lớn, ví dụ trên 1000 máy.<br>"

#: setupwizard.cpp:197
msgid "Send NetBIOS broadcasts"
msgstr "Gửi thông báo NetBIOS khắp nơi"

#: setupwizard.cpp:198
#, fuzzy
#| msgid ""
#| "You need to have the samba package (nmblookup) installed.<br>Only samba/"
#| "windows servers will respond.<br>This method is not very reliable.<br>You "
