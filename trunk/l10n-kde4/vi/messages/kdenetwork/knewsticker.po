#, qt-format
msgid "An error occurred while the program '%1' tried to read or write data."
msgstr "Gặp lỗi trong khi chương trình « %1 » thử đọc hay ghi dữ liệu."

#: common/newsengine.cpp:257
#, qt-format
msgid ""
"The program '%1' was passed too many arguments. Please adjust the command "
"line in the configuration dialog."
msgstr ""
"Chương trình « %1 » đã nhận quá nhiều đối số. Hãy điều chỉnh dòng lệnh trong "
"hộp thoại cấu hình."

#: common/newsengine.cpp:259
#, qt-format
msgid ""
"An external system program upon which the program '%1' relied could not be "
"executed."
msgstr ""
"Chương trình « %1 » nhờ một chương trình hệ thống bên ngoài không thể thực "
"hiện."

#: common/newsengine.cpp:261
#, qt-format
msgid ""
"The program '%1' tried to read or write a file or directory but lacks the "
"permission to do so."
msgstr ""
"Chương trình « %1 » đã thử đọc hay ghi một tập tin hay thư mục, nhưng không "
"có quyền làm việc đó."

#: common/newsengine.cpp:263
#, qt-format
msgid "The program '%1' tried to access a device which was not available."
msgstr "Chương trình « %1 » đã thử truy cập một thiết bị không phải sẵn sàng."

#: common/newsengine.cpp:265
#, qt-format
msgid "There is no more space left on the device used by the program '%1'."
msgstr ""
"Không có sức chứa còn rảnh trên thiết bị được dùng bởi chương trình « %1 »."

#: common/newsengine.cpp:267
#, qt-format
msgid ""
"The program '%1' tried to create a temporary file on a read only file system."
msgstr ""
"Chương trình « %1 » đã thử tạo một tập tin tạm thời trên hệ thống tập tin "
"chỉ đọc."

#: common/newsengine.cpp:269
#, qt-format
msgid ""
"The program '%1' tried to call a function which is not implemented or "
"attempted to access an external resource which does not exist."
msgstr ""
"Chương trình « %1 » đã thử gọi một hàm không được thực hiện, hoặc đã thử "
"truy cập một tài nguyên bên ngoài không phải tồn tại."

#: common/newsengine.cpp:272
#, qt-format
msgid ""
"The program '%1' was unable to retrieve input data and was therefore unable "
"to return any XML data."
msgstr ""
"Chương trình « %1 » không thể lấy dữ liệu nhập vào thì không thể trả lại dữ "
"liệu XML nào."

#: common/newsengine.cpp:274
#, qt-format
msgid ""
"The program '%1' tried to access a host which is not connected to a network."
msgstr ""
"Chương trình « %1 » đã thử truy cập một máy không được kết nối tới mạng."

#: common/newsengine.cpp:276
#, qt-format
msgid "The program '%1' tried to access a protocol which is not implemented."
msgstr ""
"Chương trình « %1 » đã thử truy cập một giao thức không được thực hiện."

#: common/newsengine.cpp:278
#, qt-format
msgid ""
"The program '%1' requires you to configure a destination address to retrieve "
"data from. Please refer to the documentation of the program for information "
"on how to do that."
msgstr ""
"Chương trình « %1 » cần thiết bạn cấu hình một địa chỉ đích từ đó cần lấy dữ "
"liệu. Xem tài liệu hướng dẫn của chương trình để tìm thông tin về việc này."

#: common/newsengine.cpp:281
#, qt-format
msgid ""
"The program '%1' tried to use a socket type which is not supported by this "
"system."
msgstr ""
"Chương trình « %1 » đã thử sử dụng một kiểu ổ cắm không được hỗ trợ bởi hệ "
"thống này."

#: common/newsengine.cpp:283
#, qt-format
msgid "The program '%1' tried to access an unreachable network."
msgstr "Chương trình « %1 » đã thử truy cập một mạng không thể tới."

#: common/newsengine.cpp:285
#, qt-format
msgid ""
"The network the program '%1' was trying to access dropped the connection "
"with a reset."
msgstr ""
"Chương trình « %1 » đã thử truy cập một mạng đã ngắt kết nối bằng tín hiệu "
"đặt lại (RESET)."

#: common/newsengine.cpp:287
#, qt-format
msgid "The connection of the program '%1' was reset by peer."
msgstr "Kết nối của chương trình « %1 » bị đặt lại bởi máy ngang hàng."

#: common/newsengine.cpp:289
#, qt-format
msgid "The connection the program '%1' was trying to establish timed out."
msgstr "Chương trình « %1 » đã thử tới một kết nối đã quá thời."

#: common/newsengine.cpp:291
#, qt-format
msgid "The connection the program '%1' was trying to establish was refused."
msgstr "Chương trình « %1 » đã thử thiết lập một kết nối bị từ chối."

#: common/newsengine.cpp:293
#, qt-format
msgid "The host the program '%1' was trying to reach is down."
msgstr "Chương trình « %1 » đã thử tới một máy không hoạt động."

#: common/newsengine.cpp:295
#, qt-format
msgid ""
"The host the program '%1' was trying to reach is unreachable, no route to "
"host."
msgstr ""
"Chương trình « %1 » đã thử tới một máy không thể tới: không có tuyến tới máy."

#: common/newsengine.cpp:297
#, qt-format
msgid ""
"KNewsTicker could not execute the program '%1' because its executable bit "
"was not set. You can mark that program as executable by executing the "
"following steps:<ul><li>Open a Konqueror window and browse to the program</"
"li><li>Click on the file with the right mouse button, and select "
"'Properties'</li><li>Open the 'Permissions' tab and make sure that the box "
"in the column 'Exec' and the row 'User' is checked to ensure that the "
"current user is allowed to execute that file.</li></ul>"
msgstr ""
"KNewsTicker không thể thực hiện chương trình « %1 » vì chưa đặt bit thực "
"hiện được của nó. Bạn vẫn còn có thể nhãn chương trình đó có khả năng thực "
"hiện bằng cách theo những bước này:<ul><li>Mở một cửa sổ Konqueror và duyệt "
"tới chương trình đó</li><li>Nhấn cái nút bên phải trên con chuột, rồi chọn "
"mục « Thuộc tính »</li><li>Chọn thể « Quyền hạn » và kiểm tra xem hộp chọn "
"trong cột « Thực hiện » (Exec.) và hàng « Người dùng » (User) đã được chọn, "
"để đảm bảo người dùng hiện thời có quyền thực hiện tập tin đó.</li></ul>"

#: common/newsengine.cpp:305
#, qt-format
msgid ""
"The program '%1' sent a bad request which was not understood by the server."
msgstr ""
"Chương trình « %1 » đã gửi một yêu cầu sai không được hiểu bởi máy phục vụ."

#: common/newsengine.cpp:307
#, qt-format
msgid ""
"The program '%1' failed to issue an authorization for an area which needs "
"some form of authorization before it can be accessed."
msgstr ""
"Chương trình « %1 » chưa xác thực để truy cập một vùng cần thiết xác thực."

#: common/newsengine.cpp:310
#, qt-format
msgid ""
"The program '%1' aborted because it could not access the data without paying "
"for it."
msgstr ""
"Chương trình « %1 » đã hủy bỏ vì nó không thể truy cập dữ liệu đó nếu không "
"trả tiền."

#: common/newsengine.cpp:312
#, qt-format
msgid "The program '%1' tried to access a forbidden source."
msgstr "Chương trình « %1 » đã thử truy cập một nguồn bị cấm."

#: common/newsengine.cpp:314
#, qt-format
msgid "The program '%1' tried to access data which could not be found."
msgstr "Chương trình « %1 » đã thử truy cập dữ liệu không tìm thấy."

#: common/newsengine.cpp:316
#, qt-format
msgid "The HTTP request of the program '%1' timed out."
msgstr "Chương trình « %1 » đã gửi một yêu cầu HTTP đã quá thời."

#: common/newsengine.cpp:317
msgid ""
"A server error has been encountered. It is likely that you cannot do "
"anything about it."
msgstr "Gặp lỗi máy phục vụ. Rất có thể là bạn không thể sửa chữa nó."

#: common/newsengine.cpp:319
#, qt-format
msgid ""
"The HTTP protocol version used by the program '%1' was not understood by the "
"HTTP server or source."
msgstr ""
"Chương trình « %1 » đã sử dụng một phiên bản giao thức HTTP không được hiểu "
"bởi máy phục vụ hay nguồn HTTP."

#: common/newsengine.cpp:321
msgid "KNewsTicker was unable to detect the exact reasons for the error."
msgstr "KNewsTicker không thể phát hiện lý do chính xác gặp lỗi."

