#: protocols/msn/msnnotifysocket.cpp:134
#, qt-format
msgid ""
"<qt>An internal error occurred in the MSN plugin.<br>MSN Error: %1<br>please "
"send us a detailed bug report at kopete-devel@kde.org containing the raw "
"debug output on the console (in gzipped format, as it is probably a lot of "
"output.)"
msgstr ""
"<qt>Gặp lỗi nội bộ trong bổ sung MSN.<br>Lỗi MSN: %1<br>Hãy gửi cho chúng "
"tôi một báo cáo lỗi ở « kopete-devel@kde.org » mà chứa kết xuất gỡ lỗi thô "
"qua bàn giao tiếp (theo định dạng gzip để giảm kích cỡ tập tin)."

#: protocols/msn/msnnotifysocket.cpp:148
msgid ""
"Unable to change your display name.\n"
"Please ensure your display is not too long and does not contains censored "
"words."
msgstr ""
"Không thể thay đổi tên hiển thị của bạn.\n"
"Hãy kiểm tra xem nó không phải quá dài, cũng không chứa từ bị cấm."

#: protocols/msn/msnnotifysocket.cpp:164
msgid "Your contact list is full; you cannot add any new contacts."
msgstr "Danh sách liên lạc của bạn đã đầy nên không thể thêm liên lạc mới."

#: protocols/msn/msnnotifysocket.cpp:171
#, qt-format
msgid ""
"<qt>The user '%1' already exists in this group on the MSN server;<br>if "
"Kopete does not show the user, please send us a detailed bug report at "
"kopete-devel@kde.org containing the raw debug output on the console (in "
"gzipped format, as it is probably a lot of output.)</qt>"
msgstr ""
"<qt>Người dùng « %1 » đã tồn tại trong nhóm này trên máy phục vụ MSN;<br>nếu "
"Kopete không hiển thị người dùng này, hãy gửi cho chúng tôi (kopete-"
"devel@kde.org) một báo cáo lỗi chi tiết chứa kết xuất gỡ lỗi thô qua bàn "
"giao tiếp (theo định dạng gzip để giảm kích cỡ tập tin).</qt>"

#: protocols/msn/msnnotifysocket.cpp:189
#, qt-format
