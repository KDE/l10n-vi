#: rc.cpp:229
#. i18n: tag string
#. i18n: file ./kopete/config/behavior/behaviorconfig_general.ui line 43
msgid ""
"By default, the system tray icon indicates new incoming messages by flashing "
"and showing a bubble. A left or middle mouse click on the icon will open the "
"message in a new chat window. Pressing the \"View\" button in the bubble has "
"the same effect."
msgstr ""
"Mặc định là biểu tượng khay hệ thống ngụ ý tin nhẳn mới gửi đến bằng cách "
"nháp và hiển thị bóng. Cú nhấn-trái hay nhấn-giữa vào biểu tượng sẽ mở tin "
"nhẳn đó trong cửa sổ trò chuyện mới. Việc bấm cái nút « Xem » trong bóng có "
"cùng tác động."

#: rc.cpp:232
#. i18n: tag string
#. i18n: file ./kopete/config/behavior/behaviorconfig_general.ui line 46
msgid "Show system &tray icon"
msgstr "Hiện biểu &tượng khay hệ thống"

#: rc.cpp:235
#. i18n: tag string
#. i18n: file ./kopete/config/behavior/behaviorconfig_general.ui line 56
msgid "Start with the main window minimized to the system tray"
msgstr "Khởi chạy có cửa sổ chính bị thu nhỏ ở khay hệ thống"

#: rc.cpp:238
#. i18n: tag string
#. i18n: file ./kopete/config/behavior/behaviorconfig_general.ui line 59
msgid ""
"Start with the main window hidden. The only visible item is the system tray "
"icon."
msgstr ""
"Khởi chạy có cửa sổ chính bị ẩn. Mục duy nhất hiển thị là biểu tượng khay hệ "
"thống."

#: rc.cpp:241
#. i18n: tag string
#. i18n: file ./kopete/config/behavior/behaviorconfig_general.ui line 62
msgid "Start &with hidden main window"
msgstr "Khởi chạy có cửa &sổ chính ẩn"

#: rc.cpp:244
#. i18n: tag string
#. i18n: file ./kopete/config/behavior/behaviorconfig_general.ui line 72
msgid "Message Handling"
msgstr "Quản lý tin nhẳn"

#: rc.cpp:247
#. i18n: tag string
#. i18n: file ./kopete/config/behavior/behaviorconfig_general.ui line 84
msgid "Instantly open incoming messages"
msgstr "Nhận được tin nhẳn thì mở ngay"

#: rc.cpp:250
#. i18n: tag string
#. i18n: file ./kopete/config/behavior/behaviorconfig_general.ui line 87
msgid ""
"If there is no existing chat window a new window will be opened when a new "
"message comes in. If there is already a chat window opened for the sender of "
"the message it will be displayed there instantly."
msgstr ""
"Nếu không có cửa sổ trò chuyện, một cửa sổ mới sẽ được mở khi nhận được tin "
"nhẳn mới. Còn nếu một cửa sổ trò chuyện đã có cho người gửi tin nhẳn đó, nó "
"sẽ hiển thị nó thay thế."

#: rc.cpp:253
#. i18n: tag string
#. i18n: file ./kopete/config/behavior/behaviorconfig_general.ui line 90
msgid "Open messages instantl&y"
msgstr "Mở nga&y tin nhẳn"

#: rc.cpp:256
#. i18n: tag string
#. i18n: file ./kopete/config/behavior/behaviorconfig_general.ui line 97
msgid "Use a message queue to store incoming messages"
msgstr "Phụ thêm các tin nhẳn gửi đến trong hàng đợi"

#: rc.cpp:259
#. i18n: tag string
#. i18n: file ./kopete/config/behavior/behaviorconfig_general.ui line 100
msgid ""
"Store new incoming messages in a message queue. New messages are messages "
"that cannot be displayed in an already open chat window. Only queued or "
"stacked messages trigger notification via bubble, a flashing tray icon, or "
"both.."
msgstr ""
"Cất giữ các tin nhẳn gửi đến mới trong hàng đợi tin nhẳn. Tin nhẳn mới là "
"tin nhản không thể được hiển thị trong cửa sổ trò chuyện còn mở. Chỉ tin "
"nhẳn hoãn trong hàng đợi hay tin nhẳn nằm trong đống sẽ gây ra thông báo "
"thông qua bóng, biểu tượng khay nháp hay cả hai."

#: rc.cpp:262
#. i18n: tag string
#. i18n: file ./kopete/config/behavior/behaviorconfig_general.ui line 103
msgid "Use message &queue"
msgstr "Dùng &hàng đời tin nhẳn"

#: rc.cpp:265
#. i18n: tag string
#. i18n: file ./kopete/config/behavior/behaviorconfig_general.ui line 110
msgid "Use a message stack to store incoming messages"
msgstr "Sắp xếp các tin nhẳn gửi đến trong đống"

#: rc.cpp:268
#. i18n: tag string
#. i18n: file ./kopete/config/behavior/behaviorconfig_general.ui line 113
msgid ""
"Store new incoming messages in a message stack. New messages are messages "
"that cannot be displayed in an already open chat window. Only queued or "
"stacked messages trigger notification via bubble and flashing tray."
msgstr ""
"Cất giữ các tin nhẳn gửi đến mới trong đống tin nhẳn. Tin nhẳn mới là tin "
"nhản không thể được hiển thị trong cửa sổ trò chuyện còn mở. Chỉ tin nhẳn "
"hoãn trong hàng đợi hay tin nhẳn nằm trong đống sẽ gây ra thông báo thông "
"qua bóng, biểu tượng khay nháp hay cả hai."

#: rc.cpp:271
#. i18n: tag string
#. i18n: file ./kopete/config/behavior/behaviorconfig_general.ui line 116
msgid "Use message stac&k"
msgstr "&Dùng đống tin nhẳn"

#: rc.cpp:274
#. i18n: tag string
#. i18n: file ./kopete/config/behavior/behaviorconfig_general.ui line 126
msgid "Also add unread messages to queue/stack"
msgstr "Cũng thêm các tin nhẳn chưa đọc và hàng đợi/đống"

#: rc.cpp:277
#. i18n: tag string
#. i18n: file ./kopete/config/behavior/behaviorconfig_general.ui line 129
msgid ""
"Unread messages are messages that will be displayed in an already opened but "
"inactive chat window. Only incoming queued messages trigger notification via "
