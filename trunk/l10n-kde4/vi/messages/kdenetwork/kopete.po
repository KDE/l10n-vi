#: libkopete/kopetecommandhandler.cpp:111
msgid ""
"USAGE: /help [<command>] - Used to list available commands, or show help for "
"a specified command."
msgstr ""
"Cách sử dụng: /help [<lệnh>]\n"
"Liệt kê các lệnh sẵn sàng, hoặc hiển thị trợ giúp về một lệnh riêng."

#: libkopete/kopetecommandhandler.cpp:114
msgid "USAGE: /close - Closes the current view."
msgstr "Cách sử dụng: /close\n"
"Đóng ô xem hiện thời."

#: libkopete/kopetecommandhandler.cpp:118
msgid "USAGE: /part - Closes the current view."
msgstr "Cách sử dụng: /part\n"
"Đóng ô xem hiện thời."

#: libkopete/kopetecommandhandler.cpp:121
msgid "USAGE: /clear - Clears the active view's chat buffer."
msgstr "Cách sử dụng: /clear\n"
"Xoá sạch bộ đệm trò chuyện của ô xem hoạt động."

#: libkopete/kopetecommandhandler.cpp:127
msgid ""
"USAGE: /away [<reason>] - Marks you as away/back for the current account "
"only."
msgstr ""
"Cách sử dụng: /away [<lý do>]\n"
"Nhãn bạn Vắng mặt/Trở về chỉ cho tài khoản hiện thời."

#: libkopete/kopetecommandhandler.cpp:130
msgid "USAGE: /awayall [<reason>] - Marks you as away/back for all accounts."
msgstr "Cách sử dụng: /awayall [<lý do>]\n"
"Nhãn bạn Vắng mặt/Trở về cho mọi tài khoản."

#: libkopete/kopetecommandhandler.cpp:133
msgid ""
"USAGE: /say <text> - Say text in this chat. This is the same as just typing "
"a message, but is very useful for scripts."
msgstr ""
"Cách sử dụng: /say <văn bản>\n"
"Nói văn bản này trong cuộc trò chuyện. Chỉ bằng với việc gõ tin nhẳn, nhưng rất hữu ích để chạy văn lệnh."

#: libkopete/kopetecommandhandler.cpp:137
msgid ""
"USAGE: /exec [-o] <command> - Executes the specified command and displays "
"the output in the chat buffer. If -o is specified, the output is sent to all "
"members of the chat."
msgstr ""
"Cách sử dụng: /exec [-o] <lệnh>\n"
"Thực hiện lệnh này, hiển thị kết xuất trong bộ đệm trò chuyện. Đặt [-o] thì kết xuất được gửi cho mọi thành viên đang trò chuyện."

#: libkopete/kopetecommandhandler.cpp:248
msgid "Available Commands:\n"
msgstr "Lệnh sẵn sàng:\n"

#: libkopete/kopetecommandhandler.cpp:261
msgid ""
"\n"
"Type /help <command> for more information."
msgstr ""
"\n"
"Hãy thử lệnh « /help <lệnh> » để xem thông tin thêm."

#: libkopete/kopetecommandhandler.cpp:270
#, qt-format
msgid "There is no help available for '%1'."
msgstr "Không có trợ giúp sẵn sàng cho « %1 »."

#: libkopete/kopetecommandhandler.cpp:321
msgid ""
"ERROR: Shell access has been restricted on your system. The /exec command "
"will not function."
msgstr ""
"LỖI: khả năng truy cập trình bao bị giới hạn trên hệ thống này nên lệnh « /exec » không hoạt động."

