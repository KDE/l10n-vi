#: command.cpp:127
msgid ""
"The server rejected both EHLO and HELO commands as unknown or "
"unimplemented.\n"
"Please contact the server's system administrator."
msgstr ""
"Máy phục vụ nhả ra hai câu lệnh EHLO và HELO vì không biết hoặc không hỗ "
"trợ.\n"
"Xin hãy liên hệ với nhà quản trị hệ thống của máy phục vụ."

#: command.cpp:141
#, kde-format
msgid ""
"Unexpected server response to %1 command.\n"
"%2"
msgstr ""
"Câu trả lời không mong đợi từ máy phục vụ tới lệnh %1.\n"
"%2"

#: command.cpp:161
msgid ""
"Your SMTP server does not support TLS. Disable TLS, if you want to connect "
"without encryption."
msgstr ""
"Máy phục vụ SMTP của bạn không hỗ trợ TLS. Hãy tắt bỏ TLS, nếu bạn muốn kết "
"nối không mã hóa."

#: command.cpp:172
#, fuzzy
#| msgid ""
#| "Your SMTP server claims to support TLS, but negotiation was "
#| "unsuccessful.\n"
#| "You can disable TLS in KDE using the crypto settings module."
msgid ""
"Your SMTP server claims to support TLS, but negotiation was unsuccessful.\n"
"You can disable TLS in the SMTP account settings dialog."
msgstr ""
"Máy phục vụ SMTP của bạn đòi hỏi hỗ trợ TLS, nhưng sự dàn xếp không thành "
"công.\n"
"Bạn có thể tắt bỏ TLS trong KDE bằng môđun thiết lập bí mật."

#: command.cpp:176
msgid "Connection Failed"
msgstr "Kết nối không thành công"

#: command.cpp:183
#, kde-format
msgid "An error occurred during authentication: %1"
msgstr "Gặp lỗi trong khi xác thực: %1"

#: command.cpp:249
msgid "No authentication details supplied."
msgstr "Chưa cung cấp chi tiết để xác thực."

