#: volumeslider.cpp:42 volumeslider.cpp:60 volumeslider.cpp:189
#: volumeslider.cpp:204
#, qt-format
msgid "Volume: %1%"
msgstr "Âm lượng: %1%"

#: volumeslider.cpp:45 volumeslider.cpp:63 volumeslider.cpp:117
#, qt-format
msgid ""
"Use this slider to adjust the volume. The leftmost position is 0%, the "
"rightmost is %1%"
msgstr ""
"Sử dụng con trượt này để điều chỉnh âm lượng. Vị trí ở cuối bên trái là 0%, "
"còn vị trí ở cuối bên phải là %1%."

#: volumeslider.cpp:184
msgid "Muted"
msgstr "Câm"

#: audiooutput.cpp:443 audiooutput.cpp:477
#, qt-format
msgid ""
"<html>The audio playback device <b>%1</b> does not work.<br/>Falling back to "
"<b>%2</b>.</html>"
msgstr ""
"<html>Thiết bị phát lại âm thanh <b>%1</b> không hoạt động được<br/>nên trở "
"về <b>%2</b>.</html>"

#: audiooutput.cpp:456
#, qt-format
msgid ""
"<html>Switching to the audio playback device <b>%1</b><br/>which just became "
"available and has higher preference.</html>"
msgstr ""
"<html>Đang chuyển đổi sang thiết bị phát lại âm thanh <b>%1</b><br/>mới sẵn "
"sàng và có ưu tiên cao hơn.</html>"

#: audiooutput.cpp:459 audiooutput.cpp:473
#, qt-format
msgid "Revert back to device '%1'"
msgstr "Trở về thiết bị « %1 »"

#: audiooutput.cpp:470
#, fuzzy, qt-format
#| msgid ""
#| "<html>Switching to the audio playback device <b>%1</b><br/>which just "
#| "became available and has higher preference.</html>"
msgid ""
"<html>Switching to the audio playback device <b>%1</b><br/>which has higher "
"preference or is specifically configured for this stream.</html>"
msgstr ""
"<html>Đang chuyển đổi sang thiết bị phát lại âm thanh <b>%1</b><br/>mới sẵn "
"sàng và có ưu tiên cao hơn.</html>"

