#~ "giờ (1-12).</td> </tr><tr><td><b>MM</b></td><td>Phút (00-59).</td></"
#~ "tr><tr><td><b>SS</b></td><td>Giây (00-59).</td></tr><tr><td><b>SACH</b></"
