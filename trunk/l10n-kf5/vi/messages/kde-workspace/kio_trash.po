#: kcmtrash.cpp:158 kcmtrash.cpp:256
msgid " day"
msgid_plural " days"
msgstr[0] " ngày"

#: kcmtrash.cpp:247
msgid "Delete files older than:"
msgstr "Xoá những tập tin cũ hơn:"

#: kcmtrash.cpp:249
msgctxt "@info:whatsthis"
msgid ""
"<para>Check this box to allow <b>automatic deletion</b> of files that are "
"older than the value specified. Leave this disabled to <b>not</b> "
"automatically delete any items after a certain timespan</para>"
msgstr ""
"<para>Chọn để cho phép <b>tự động xoá</b> các tập tin cũ hơn giá trị được "
"nhập. Không chọn để không tự động xoá tập tin nào</para>"

#: kcmtrash.cpp:258
msgctxt "@info:whatsthis"
msgid ""
"<para>Set the number of days that files can remain in the trash. Any files "
"older than this will be automatically deleted.</para>"
msgstr ""
"<para>Đặt số ngày mà một tập tin được lưu giữ trong thùng rác. Bất kỳ tập "
"tin nào cũ hơn sẽ tự động được xoá.</para>"

#: kcmtrash.cpp:266
msgid "Limit to maximum size"
msgstr "Giới hạn kích thước tối đa"

#: kcmtrash.cpp:268
msgctxt "@info:whatsthis"
msgid ""
"<para>Check this box to limit the trash to the maximum amount of disk space "
"that you specify below. Otherwise, it will be unlimited.</para>"
msgstr ""
"<para>Chọn để giới hạn dung lượng đĩa tối đa dành cho thùng rác. Sẽ không có "
"giới hạn nào nếu không chọn.</para>"

#: kcmtrash.cpp:286
msgctxt "@info:whatsthis"
msgid ""
"<para>This is the maximum percent of disk space that will be used for the "
"trash.</para>"
msgstr ""
"<para>Đây là số phần trăm dung lượng đĩa tối đa dành cho thùng rác.</para>"

#: kcmtrash.cpp:291
msgctxt "@info:whatsthis"
msgid ""
"<para>This is the calculated amount of disk space that will be allowed for "
"the trash, the maximum.</para>"
msgstr ""

#: kcmtrash.cpp:294
msgid "Maximum size:"
msgstr "Kích thước tối đa:"

#: kcmtrash.cpp:296
msgid "When limit reached:"
msgstr "Khi đạt giới hạn:"

#: kcmtrash.cpp:300
msgid "Warn Me"
msgstr "Hãy cảnh báo tôi"

#: kcmtrash.cpp:301
msgid "Delete Oldest Files From Trash"
msgstr "Xoá các tập tin cũ nhất trong thùng rác"

#: kcmtrash.cpp:302
msgid "Delete Biggest Files From Trash"
msgstr "Xoá các tập tin lớn nhất trong thùng rác"

#: kcmtrash.cpp:304
msgctxt "@info:whatsthis"
msgid ""
"<para>When the size limit is reached, it will prefer to delete the type of "
"files that you specify, first. If this is set to warn you, it will do so "
"instead of automatically deleting files.</para>"
msgstr ""
"<para>Khi đạt giới hạn dung lượng, thùng rác sẽ ưu tiên xoá kiểu tập tin mà "
"bạn đã chọn trước. Nếu được chọn là cảnh báo, nó sẽ làm như vậy thay vì xoá "
"bất cứ tập tin nào.</para>"

#: kio_trash.cpp:93 kio_trash.cpp:159 kio_trash.cpp:315 kio_trash.cpp:347
#: kio_trash.cpp:513 kio_trash.cpp:525
#, kde-format
msgid "Malformed URL %1"
msgstr "URL sai dạng %1"

#: kio_trash.cpp:115
#, kde-format
msgid ""
"The directory %1 does not exist anymore, so it is not possible to restore "
"this item to its original location. You can either recreate that directory "
"and use the restore operation again, or drag the item anywhere else to "
"restore it."
msgstr ""
"Thư mục %1 không còn nữa, vì thế không thể phục hồi tập tin về vị trí gốc "
"của nó. Có thể tạo lại thư mục đó và thực hiện thao tác phục hồi lại lần "
"nữa, hoặc kéo nó tới một nơi nào đó để phục hồi."

#: kio_trash.cpp:144 kio_trash_win.cpp:228
msgid "This file is already in the trash bin."
msgstr "Tập tin này đã nằm trong thùng rác."

#: kio_trash.cpp:233 kio_trash_win.cpp:252
msgid "Internal error in copyOrMove, should never happen"
msgstr "Lỗi nội bộ trong copyOrMove. Lỗi này không nên xảy ra."

#: kio_trash_win.cpp:241
msgid "not supported"
msgstr "không hỗ trợ"

#: ktrash.cpp:33
msgid "ktrash"
msgstr "ktrash"

#: ktrash.cpp:35
msgid ""
"Helper program to handle the KDE trash can\n"
"Note: to move files to the trash, do not use ktrash, but \"kioclient move "
"'url' trash:/\""
msgstr ""
"Chương trình hỗ trợ để quản lý thùng rác KDE\n"
"Lưu ý: để di chuyển tập tin vào thùng rác, hãy sử dụng \"kioclient move "
"'url' trash:/\" thay vì ktrash"

#: ktrash.cpp:39
msgid "Empty the contents of the trash"
msgstr "Dọn sạch sọt rác"

#: ktrash.cpp:41
msgid "Restore a trashed file to its original location"
msgstr "Phục hồi tập tin trong sọt rác về vị trí cũ của nó"

#: ktrash.cpp:43
msgid "Ignored"
msgstr "Bị bỏ qua"

#: trashimpl.cpp:1128
msgid ""
"The trash has reached its maximum size!\n"
"Cleanup the trash manually."
msgstr ""
"Thùng rác đã đạt giới hạn dung lượng tối đa!\n"
"Hãy dọn dẹp thùng rác."

#: trashimpl.cpp:1139
msgid "The file is too large to be trashed."
msgstr "Không thể bỏ thùng rác tập tin này do kích thước quá lớn."

