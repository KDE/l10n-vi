#: klineal.cpp:101
#, fuzzy, kde-format
#| msgid "KRuler"
msgctxt "@title:window"
msgid "KRuler"
msgstr "Thước kẻ K"

#: klineal.cpp:105
#, kde-format
msgid ""
"This is a tool to measure pixel distances and colors on the screen. It is "
"useful for working on layouts of dialogs, web pages etc."
msgstr ""
"Đây là công cụ để đo khoảng cách điểm ảnh (pixel) và màu trên màn hình. Nó "
"rất hữu dụng khi làm việc với trình bày hộp hội thoại, trang web, vân vân..."

#: klineal.cpp:132
#, kde-format
msgid "This is the current distance measured in pixels."
msgstr "Đây là khoảng cách hiện tại đo bằng điểm ảnh (pixel)."

#: klineal.cpp:138
#, fuzzy, kde-format
msgid ""
"This is the current color in hexadecimal rgb representation as you may use "
"it in HTML or as a QColor name. The rectangles background shows the color of "
"the pixel inside the little square at the end of the line cursor."
msgstr ""
"Đây là cách viết màu thập lục phân RGB dùng được trong HTML hay QColor. Màu "
"nền của hình chữ nhật là màu của điểm ảnh bên trong hình vuông nhỏ ở cuối "
"đường con trỏ."

