#: kio_man.cpp:639
msgid "There is more than one matching man page."
msgstr "Có nhiều hơn một trang sổ tay tương ứng."

#: kio_man.cpp:650
msgid ""
"Note: if you read a man page in your language, be aware it can contain some "
"mistakes or be obsolete. In case of doubt, you should have a look at the "
"English version."
msgstr ""
"Chú ý: nếu bạn đọc một trang sổ tay đã dịch sang ngôn ngữ của mình, thì có "
"thể nó có lỗi hoặc đã cũ. Trong trường hợp có vấn đề, bạn cần xem phiên bản "
"tiếng Anh của trang đó."

