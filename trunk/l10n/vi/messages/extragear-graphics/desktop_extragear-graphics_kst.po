#: src/plugins/bin/kstobject_bin.desktop:8
msgid "Name=Bin"
msgstr "Name=Bin"

#: src/plugins/bin/kstobject_bin.desktop:21
msgid ""
"Comment=Bins data into the given size bins.  Each bin contains the mean of the "
"elements belonging to the bin."
msgstr ""
"Comment=Để dữ liệu vào các thùng có kích cỡ đã cho. Mỗi thùng chứa số trung "
"bình các yếu tố thuộc về thùng đó."

#: src/plugins/chop/kstobject_chop.desktop:8
msgid "Name=Chop"
msgstr "Name=Chop"

#: src/plugins/chop/kstobject_chop.desktop:20
msgid ""
"Comment=Chops a given data set into odd, even, difference, and Index data sets."
msgstr ""
"Comment=Cắt một tập dữ liệu đã cho ra các tập dữ liệu kiểu lẻ, chẵn, hiệu và "
"chỉ mục."

#: src/plugins/convolution/convolve/kstobject_convolve.desktop:8
msgid "Name=Convolution"
msgstr "Name=Quấn lại"

#: src/plugins/convolution/convolve/kstobject_convolve.desktop:22
msgid "Comment=Generates the convolution of one vector with another."
msgstr "Comment=Tạo ra sự quấn lại của véc-tơ này với véc-tơ khác."

#: src/plugins/convolution/deconvolve/kstobject_deconvolve.desktop:8
msgid "Name=Deconvolution"
msgstr "Name=Bỏ quấn lại"

#: src/plugins/convolution/deconvolve/kstobject_deconvolve.desktop:22
msgid "Comment=Generates the deconvolution of one vector with another."
msgstr "Comment=Tạo ra sự bỏ quấn lại của véc-tơ này với véc-tơ khác."

#: src/plugins/correlation/autocorrelation/kstobject_autocorrelate.desktop:8
msgid "Name=Auto-correlation"
msgstr "Name=Tự động tương quan"

#: src/plugins/correlation/autocorrelation/kstobject_autocorrelate.desktop:21
msgid "Comment=Generates the auto-correlation of a vector."
msgstr "Comment=Tạo ra sự tương quan tự động của véc-tơ."

#: src/plugins/correlation/crosscorrelation/kstobject_crosscorrelate.desktop:8
msgid "Name=Cross-correlation"
msgstr "Name=Tương quan chéo"

#: src/plugins/correlation/crosscorrelation/kstobject_crosscorrelate.desktop:21
msgid "Comment=Generates the correlation of one vector with another."
msgstr "Comment=Tạo ra sự tương quan chéo của véc-tơ này với véc-tơ khác."

#: src/plugins/crossspectrum/kstobject_crossspectrum.desktop:8
msgid "Name=Cross Power Spectrum"
msgstr "Name=Quang phổ lũy thừa chéo"

#: src/plugins/crossspectrum/kstobject_crossspectrum.desktop:21
msgid "Comment=Generates the cross power spectrum of one vector with another."
msgstr "Comment=Tạo ra quang phổ lũi thừa chéo của véc-tơ này với véc-tơ khác."

#: src/plugins/cumulative_sum/kstobject_cumulative_sum.desktop:8
msgid "Name=Cumulative sum (integral)"
msgstr "Name=Tổng lũy tích (tích phân)"

#: src/plugins/cumulative_sum/kstobject_cumulative_sum.desktop:22
msgid "Comment=Computes the cumulative sum (integral) of the input vector."
msgstr "Comment=Tính tổng lũy tích (tích phân) cũa véc-tơ nhập."

#: src/plugins/differentiation/kstobject_differentiation.desktop:8
msgid "Name=Fixed-step differentiation"
msgstr "Name=Vi phân bước cố định"

#: src/plugins/differentiation/kstobject_differentiation.desktop:20
msgid "Comment=Computes the discrete derivative of an input vector"
msgstr "Comment=Tính tổng đạo hàm rời rạc cũa véc-tơ nhập."

#: src/plugins/discretizing_filters/kstobject_discretizing_filters.desktop:8
msgid "Name=Generic filter"
msgstr "Name=Bộ lọc giống loài"

#: src/plugins/discretizing_filters/kstobject_discretizing_filters.desktop:22
msgid "Comment=Generates a discrete filter from a continuous-time definition."
msgstr ""
"Comment=Tạo ra một bộ lọc rời rạc từ lời định nghĩa thời gian liên tục."

#: src/plugins/effective_bandwidth/kstobject_effbandwidth.desktop:8
msgid "Name=Effective Bandwidth"
msgstr "Name=Băng thông hiệu dụng"

#: src/plugins/effective_bandwidth/kstobject_effbandwidth.desktop:22
msgid "Comment=Calculates effective bandwidth from an amplitude spectrum."
msgstr "Comment=Tính băng thông hiệu dụng từ quang phổ biên tần."

#: src/plugins/interpolations/akima/kstobject_akima.desktop:8
msgid "Name=Interpolation akima spline"
msgstr "Name=Chốt trục akima nội suy"

#: src/plugins/interpolations/akima/kstobject_akima.desktop:20
msgid "Comment=Generates a non-rounded Akima interpolation for a set of data."
msgstr "Comment=Tạo ra sự nội suy Akima khác tròn cho một tập dữ liệu."

#: src/plugins/interpolations/akima_periodic/kstobject_akima_periodic.desktop:8
msgid "Name=Interpolation akima spline periodic"
msgstr "Name=Chốt trục akima nội suy định kỳ"

#: src/plugins/interpolations/akima_periodic/kstobject_akima_periodic.desktop:20
msgid ""
"Comment=Generates a non-rounded periodic Akima interpolation for a set of data."
msgstr "Comment=Tạo ra sự nội suy Akima định kỳ khác tròn cho một tập dữ liệu."

#: src/plugins/interpolations/cspline/kstobject_cspline.desktop:8
msgid "Name=Interpolation cubic spline"
msgstr "Name=Chốt trục bậc ba nội suy"

#: src/plugins/interpolations/cspline/kstobject_cspline.desktop:20
msgid "Comment=Generates a spline interpolation for a set of data."
msgstr "Comment=Tạo ra sự nội suy chốt trục cho một tập dữ liệu."

#: src/plugins/interpolations/cspline_periodic/kstobject_cspline_periodic.desktop:8
msgid "Name=Interpolation cubic spline periodic"
msgstr "Name=Chốt trục bậc ba nội suy định kỳ"

#: src/plugins/interpolations/cspline_periodic/kstobject_cspline_periodic.desktop:20
msgid "Comment=Generates a cubic spline interpolation for a set of data."
msgstr "Comment=Tạo ra sự nội suy chốt trục bậc ba cho một tập dữ liệu."

#: src/plugins/interpolations/linear/kstobject_linear.desktop:8
msgid "Name=Interpolation linear"
msgstr "Name=Nội suy tuyến tính"

#: src/plugins/interpolations/linear/kstobject_linear.desktop:21
msgid "Comment=Generates a linear interpolation for a set of data."
msgstr "Comment=Tạo ra sự nội suy tuyến tính cho một tập dữ liệu."

#: src/plugins/interpolations/polynomial/kstobject_polynomial.desktop:8
msgid "Name=Interpolation polynomial"
msgstr "Name=Nội suy đa thức"

#: src/plugins/interpolations/polynomial/kstobject_polynomial.desktop:20
msgid "Comment=Generates a polynomial interpolation for a set of data."
msgstr "Comment=Tạo ra sự nội suy đa thức cho một tập dữ liệu."

#: src/plugins/linefit/kstobject_linefit.desktop:8
msgid "Name=Line Fit"
msgstr "Name=Vừa dòng"

#: src/plugins/linefit/kstobject_linefit.desktop:22
msgid "Comment=Generates a line of best fit for a set of data."
msgstr "Comment=Tạo ra dòng vừa nhất cho một tập dữ liệu."

#: src/plugins/noise_addition/kstobject_noise_addition.desktop:8
msgid "Name=Noise addition"
msgstr "Name=Thêm nhiễu"

#: src/plugins/noise_addition/kstobject_noise_addition.desktop:20
msgid ""
"Comment=Adds Gaussian noise to a set of data, of a specified standard "
"deviation."
msgstr "Comment=Thêm nhiễu kiểu Gauss vào một tập dữ liệu có độ lệch riêng."

#: src/plugins/periodogram/kstobject_periodogram.desktop:8
msgid "Name=Periodogram"
msgstr "Name=Chu kỳ đồ"

#: src/plugins/periodogram/kstobject_periodogram.desktop:18
msgid ""
"Comment=Takes the periodogram of a given data set. The data is not assumed to "
"be sampled at equal time intervals."
msgstr ""
"Comment=Tính chu kỳ đồ của một tập dữ liệu đã cho. Không giả sử dữ liệu được "
"lấy mẫu sau mỗi khoảng thời gian."

#: src/plugins/phase/kstobject_phase.desktop:8
msgid "Name=Phase"
msgstr "Name=Giải đoạn"

#: src/plugins/phase/kstobject_phase.desktop:22
msgid "Comment=Phases a given data set to the specified period and zero phase."
msgstr ""
"Comment=Chuyển một tập dữ liệu đã sang thời kỳ và giải đoạn số không riêng."

#: src/plugins/shift/kstobject_shift.desktop:8
msgid "Name=Shift"
msgstr "Name=Dịch"

#: src/plugins/shift/kstobject_shift.desktop:22
msgid "Comment=Shifts (and truncates) a vector."
msgstr "Comment=Dịch (và cắt ngắn) một véc-tơ."

#: src/plugins/statistics/kstobject_statistics.desktop:8
msgid "Name=Statistics"
msgstr "Name=Thống kê"

#: src/plugins/statistics/kstobject_statistics.desktop:25
msgid "Comment=Determines statistics for a given data set."
msgstr "Comment=Tính thống kê cho một tập dữ liệu đã cho."

#: src/plugins/syncbin/kstobject_syncbin.desktop:8
msgid "Name=Syncbin"
msgstr "Name=Syncbin"

#: src/plugins/syncbin/kstobject_syncbin.desktop:19
msgid ""
"Comment=Synchronously coadd vector Y into bins defined by vector X.  Like a 1D "
"map."
msgstr ""
"Comment=Đồng thêm véc-tơ Y vào các thùng được xác định bằng véc-tơ X. Giống như "
"sơ đồ một chiều."

#: src/plugins/testplugin/kstobject_testplugin.desktop:8
msgid "Name=Test Plugin"
msgstr "Name=Bổ sung thử ra"

#: src/plugins/testplugin/kstobject_testplugin.desktop:24
msgid "Comment=A test of new data object plugin system."
msgstr "Comment=Việc thử ra hệ thống bổ sung đối tượng mới."
