#: kexi/kexidb/drivers/mySQL/showimg_kexidb_mysqldriver.desktop:3
#, fuzzy
msgid "Name=mySQL"
msgstr "mySQL"

#: kexi/kexidb/drivers/mySQL/showimg_kexidb_mysqldriver.desktop:10
#, fuzzy
msgid ""
"Comment=mySQL is a fast database engine. It is used for personal purposes as "
"well as for huge databases in big companies and organizations. We recommend "
"using mySQL for projects shared in networks."
msgstr ""
"mySQL là một cơ chế cơ sở dữ liệu nhanh. Nó dùng cho mục tiêu cá nhân cũng như "
"với cơ sở dữ liệu rất lớn trong công ty và tổ chức quan trọng. Khuyên bạn sử "
"dụng mySQL với dự án chia sẻ qua mạng."

