msgstr "SQLite3"

#: kexi/kexidb/drivers/sqlite/showimg_kexidb_sqlite3driver.desktop:5
#: kexi/kexidb/drivers/sqlite2/showimg_kexidb_sqlite2driver.desktop:5
msgid "Comment=SQLite is default Kexi embedded SQL engine"
msgstr "SQLite3 là một cơ chế SQL nhúng Kexi mặc định"

