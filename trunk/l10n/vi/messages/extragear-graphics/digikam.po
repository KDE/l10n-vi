"tool"
msgstr ""
"Bạn cần phải chọn một vùng chứa mắt để dùng công cụ sửa chửa mắt màu đỏ."

#: imageplugins/imageeffect_redeye.cpp:224
msgid "Red Eyes Correction"
msgstr "Sửa mắt đỏ"

#: imageplugins/imageeffect_redeye.cpp:231
