msgstr "Đang tải: "

#: utilities/setup/dcrawsettingswidget.cpp:241
#, fuzzy
msgid ""
"<p><b>Domain</b>"
"<p>Set here the noise reduction Sigma Domain in units of pixels. The default "
"value is 2.0."
"<p>"
msgstr ""
"<p>Miền Sigma giảm ồn theo đơn vị là điểm ảnh. Giá trị mặc định là 2.0."
"<p>"

#: utilities/setup/dcrawsettingswidget.cpp:252
#, fuzzy
msgid ""
"<p><b>Range</b>"
"<p>Set here the noise reduction Sigma Range in units of CIELab colorspace. The "
"default value is 4.0."
"<p>"
msgstr ""
"<p>Miền Sigma giảm ồn theo đơn vị là miền màu CIELab. Giá trị mặc định là 4.0."
