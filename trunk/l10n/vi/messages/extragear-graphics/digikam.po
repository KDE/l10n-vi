#: libs/dcraw/dcrawsettingswidget.cpp:111
msgid ""
"<p>If enabled, all RAW files will be decoded to 16-bit color depth using a "
"linear gamma curve. To prevent black picture rendering in the editor, it is "
"recommended to use Color Management in this mode."
"<p>If disabled, all RAW files will be decoded to 8-bit color depth with a "
"BT.709 gamma curve and a 99th-percentile white point. This mode is faster than "
"16-bit decoding."
msgstr ""
"<p>Bật thì mọi tập tin RAW sẽ được giải mã thành độ sâu màu 16 bit bằng đường "
"cong Gama tuyến tính. Để ngăn cản việc vẽ hình màu đen trong bộ sửa đổi, khuyên "
"bạn dùng khả năng Quản lý Màu trong chế độ này."
"<p>Tắt thì mọi tập tin RAW sẽ được giải mã thành độ sâu màu 8 bit với đường "
"cong Gama BT.709 và điểm màu trắng tỷ lệ 99 phần trăm. Chế độ này chạy nhanh "
"hơn việc giải mã 16 bit."

#: libs/dcraw/dcrawsettingswidget.cpp:120
#, fuzzy, c-format
msgid "dcraw version %1"
msgstr "Kipi phiên bản %1"

#: libs/dcraw/dcrawsettingswidget.cpp:123
#, fuzzy
msgid "Visit dcraw project website"
msgstr "Thăm nơi Mạng của dự án digiKam"

#: libs/dcraw/dcrawsettingswidget.cpp:126
msgid "Interpolate RGB as four colors"
msgstr "Nội suy RGB là bốn màu"

#: libs/dcraw/dcrawsettingswidget.cpp:127
msgid ""
"<p><b>Interpolate RGB as four colors</b>"
"<p>The default is to assume that all green pixels are the same. If even-row "
"green pixels are more sensitive to ultraviolet light than odd-row this "
"difference causes a mesh pattern in the output; using this option solves this "
"problem with minimal loss of detail."
"<p>To resume, this option blurs the image a little, but it eliminates false 2x2 "
"mesh patterns with VNG quality method or mazes with AHD quality method."
msgstr ""
"<p><b>Nội suy RGB dạng bốn màu</b>"
"<p>Mặc định là giả sử mọi điểm ảnh màu lục là bằng nhau. Nếu các điểm ảnh màu "
"lục kiểu hàng chẵn phản ứng nhiều với ánh sáng cực tím hơn điều hàng lẻ, sự "
"khác nhau này gây ra mẫu mắc lưới trong kết xuất; việc bật tùy chọn này thì "
"quyệt định vấn đề này, mất chi tiết tối thiểu."
"<p>Để tóm tắt, tùy chọn này ít che mờ ảnh, nhưng cũng loại trừ các mẫu mắc lưới "
"2×2 giả với phương pháp chất lượng VNG hay làm cung mê với phương pháp chất "
"lượng AHD."

#: libs/dcraw/dcrawsettingswidget.cpp:141
msgid "Use camera white balance"
msgstr "Dùng cán cân màu trắng máy ảnh"

#: libs/dcraw/dcrawsettingswidget.cpp:142
msgid ""
"<p><b>Use camera white balance</b>"
"<p>Use the camera's custom white-balance settings. The default is to use fixed "
"daylight values, calculated from sample images. If this can't be found, reverts "
"to the default."
msgstr ""
"<p><b>Dùng cán cân màu trắng máy ảnh</b>"
"<p>Dùng thiết lập cán cân màu trắng của máy ảnh. Mặc định là dùng các giá trị "
"ánh nắng ban ngày cố định, được tính từ các ảnh mẫu. Không tìm thấy thì hoàn "
"nguyên thiết lập mặc định."

#: libs/dcraw/dcrawsettingswidget.cpp:151
msgid "Automatic color balance"
msgstr "Cán cân màu tự động"

#: libs/dcraw/dcrawsettingswidget.cpp:152
msgid ""
"<p><b>Automatic color balance</b>"
"<p>The default is to use a fixed color balance based on a white card "
"photographed in sunlight."
"<p>"
msgstr ""
"<p><b>Cán cân màu tự động</b>"
"<p>Mặc định là dùng cán cân màu cố định dựa vào thẻ màu trắng được chụp ảnh "
"trong ánh mặt trời."
"<p>"

#: libs/dcraw/dcrawsettingswidget.cpp:160
msgid "Use Super-CCD secondary sensors"
msgstr "Dùng bộ nhạy phụ Super-CCD"

#: libs/dcraw/dcrawsettingswidget.cpp:161
msgid ""
"<p><b>Use Super CCD secondary sensors</b>"
"<p>For Fuji Super CCD SR cameras, use the secondary sensors, in effect "
"underexposing the image by four stops to reveal detail in the highlights. For "
"all other camera types this option is ignored."
"<p>"
msgstr ""
"<p><b>Dùng bộ nhạy phụ Super-CCD</b>"
"<p>Đối với máy ảnh kiểu Fuji Super CCD SR, hãy dùng những bộ nhạy phụ, có kết "
"quả là chụp non ảnh theo bốn bước để tỏ ra chi tiết trong các chỗ nổi bật. Đối "
"với các kiểu máy ảnh khác thì tùy chọn bị bỏ qua."
"<p>"

#: libs/dcraw/dcrawsettingswidget.cpp:171
msgid "Highlights:"
msgstr "Chỗ nổi bật:"

#: libs/dcraw/dcrawsettingswidget.cpp:173
msgid "Solid white"
msgstr "Trắng đặc"

#: libs/dcraw/dcrawsettingswidget.cpp:174
msgid "Unclip"
msgstr "Hủy xén"

#: libs/dcraw/dcrawsettingswidget.cpp:175
msgid "Reconstruct"
msgstr "Cấu tạo lại"

#: libs/dcraw/dcrawsettingswidget.cpp:176
msgid ""
"<p><b>Highlights</b>"
"<p>Select here the highlight clipping method:"
"<p><b>Solid white</b>: Clip all highlights to solid white"
"<p><b>Unclip</b>: Leave highlights unclipped in various shades of pink"
"<p><b>Reconstruct</b>: Reconstruct highlights using a level value."
msgstr ""
"<p><b>Chỗ nổi bật</b>"
"<p>Ở đây hãy chọn phương pháp xén chỗ nổi bật:"
"<p><b>Trắng đặc</b>: xén mọi chỗ nổi bật thành màu trắng đặc"
"<p><b>Hủy xén</b>: để lại các chỗ nổi bật không được xén bằng các sắc màu hồng "
"khác nhau."
"<p><b>Cấu tạo lại</b>: cấu tạo lại các chỗ nổi bật bằng giá trị lớp."

#: libs/dcraw/dcrawsettingswidget.cpp:186
msgid "Level:"
msgstr "Lớp:"

#: libs/dcraw/dcrawsettingswidget.cpp:189
msgid ""
"<p><b>Level</b>"
"<p>Specify the reconstruct highlights level of output image. Low values favor "
"whites and high values favor colors."
msgstr ""
"<p><b>Lớp</b>"
"<p>Xác định lớp cấu tạo chỗ nổi bật của ảnh xuất. Giá trị thấp thì thiên vị màu "
"trắng, còn giá trị cao thiên vị các màu khác."

#: imageplugins/imageeffect_bcg.cpp:147 libs/dcraw/dcrawsettingswidget.cpp:197
msgid "Brightness:"
msgstr "Độ sáng:"

#: libs/dcraw/dcrawsettingswidget.cpp:201
#, fuzzy
msgid ""
"<p><b>Brightness</b>"
"<p>Specify the brightness level of output image.The default value is 1.0."
"<p>"
msgstr ""
"<p><b>Độ sáng</b>"
"<p>Hãy xác định độ sãng của ảnh xuất. Giá trị mặc định là 1.0."
"<p>"

#: libs/dcraw/dcrawsettingswidget.cpp:209
msgid "Quality:"
msgstr "Chất lượng:"

#: libs/dcraw/dcrawsettingswidget.cpp:211
msgid "Bilinear interpolation"
msgstr "Nội suy tuyến kép"

#: libs/dcraw/dcrawsettingswidget.cpp:212
msgid "VNG interpolation"
msgstr "Nội suy VNG"

#: libs/dcraw/dcrawsettingswidget.cpp:213
msgid "AHD interpolation"
msgstr "Nội suy AHD"

#: libs/dcraw/dcrawsettingswidget.cpp:214
msgid ""
"<p><b>Quality</b>"
"<p>Select here the demosaicing RAW images decoding interpolation method. A "
"demosaicing algorithm is a digital image process used to interpolate a complete "
"image from the partial raw data received from the color-filtered image sensor "
"internal to many digital cameras in form of a matrix of colored pixels. Also "
"known as CFA interpolation or color reconstruction, another common spelling is "
"demosaicking. There are 3 methods to demosaic RAW images:"
"<p><b>Bilinear</b>: use high-speed but low-quality bilinear interpolation "
"(default - for a slow computer). In this method, the red value of a non-red "
"pixel is computed as the average of the adjacent red pixels, and similar for "
"blue and green."
"<p><b>VNG</b>: use Variable Number of Gradients interpolation. This method "
"computes gradients near the pixel of interest and uses the lower gradients "
"(representing smoother and more similar parts of the image) to make an "
"estimate."
"<p><b>AHD</b>: use Adaptive Homogeneity-Directed interpolation. This method "
"selects the direction of interpolation so as to maximize a homogeneity metric, "
"thus typically minimizing color artifacts."
"<p>"
msgstr ""
"<p><b>Chất lượng</b>"
"<p>Ở đây hãy chọn phương pháp nội suy giải mã RAW demosaicing. Thuật toán "
"demosaic là tiến trình ảnh điện số dùng để nội suy một ảnh hoàn toàn từ dữ liệu "
"thô bộ phận được nhận từ bộ nhạy ảnh đã lọc màu bên ngoài rất nhiều máy ảnh "
"điện số, kết quả có dạng ma trận các điểm ảnh có màu sắc. Cũng được biết như là "
"sự nội suy CFA hay sự cấu tạo màu; cách chính tả thường khác là « demosaicking "
"»."
"<p><b>Tuyến kép</b>: dùng khả năng nội suy tuyến kép có tốc độ cao còn chất "
"lượng thấp (mặc định cho máy tính chạy chậm hơn). Phương pháp này tính giá trị "
"màu đỏ của một điểm ảnh khác màu đỏ nào đó bằng giá trị trung bình của các điểm "
"ảnh màu đỏ kề nhau; tương tự với màu lục và xanh."
"<p><b>VNG</b>: dùng khả năng nội suy kiểu Số Dốc Biến. Phương pháp này tính các "
"dốc gần điểm quan tâm và dùng những dốc thấp hơn (đại diện các phần ảnh mịn hơn "
"và tương tự hơn) để tính số lượng ước đoán."
"<p><b>AHD</b>: dùng khả năng nội suy Hướng Đồng Nhất Mang Tính Thích Nghi. "
"Phương pháp này chọn hướng nội suy để tối ưu hoá số đo độ đồng nhất thì thường "
"tối thiểu hoá các đồ tạo tác màu."
"<p>"

#: libs/dcraw/dcrawsettingswidget.cpp:237
msgid "Enable noise reduction"
msgstr "Bật khả năng giảm nhiễu"

#: libs/dcraw/dcrawsettingswidget.cpp:238
msgid ""
"<p><b>Enable Noise Reduction</b>"
"<p>Toggle bilateral filter to smooth noise while preserving edges. This option "
"can be use to reduce low noise. The pictures edges are preserved because it is "
"applied in CIELab color space instead of RGB."
"<p>"
msgstr ""
"<p><b>Bật khả năng giảm nhiễu</b>"
"<p>Bật/tắt bộ lọc tuyến kép để làm mịn nhiễu còn bảo tồn các cạnh. Có thể sử "
"dụng tùy chọn này để giảm nhiễu thấp. Các cạnh ảnh được bảo tồn vì khả năng này "
"được áp dụng trong vùng màu CIELab thay cho RGB."
"<p>"

#: libs/dcraw/dcrawsettingswidget.cpp:248
msgid "Domain:"
msgstr "Miền:"

#: libs/dcraw/dcrawsettingswidget.cpp:249
msgid ""
"<p><b>Domain</b>"
"<p>Set here the noise reduction Sigma Domain in units of pixels. The default "
"value is 2.0."
"<p>"
msgstr ""
"<p><b>Miền</b>"
"<p>Ở đây hãy đặt Miền Sigma giảm nhiễu theo đơn vị là điểm ảnh. Giá trị mặc "
"định là 2.0."
"<p>"

#: libs/dcraw/dcrawsettingswidget.cpp:260
msgid ""
"<p><b>Range</b>"
"<p>Set here the noise reduction Sigma Range in units of CIELab colorspace. The "
"default value is 4.0."
"<p>"
msgstr ""
"<p><b>Phạm vị</b>"
"<p>Ở đây hãy đặt Miền Sigma giảm nhiễu theo đơn vị là vùng màu CIELab. Giá trị "
"mặc định là 4.0."
"<p>"

