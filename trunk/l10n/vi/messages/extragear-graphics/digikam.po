#: imageplugins/imageeffect_bwsepia.cpp:257
msgid "No Black & White Filter"
msgstr "Không lọc đen trắng"

#: imageplugins/imageeffect_bwsepia.cpp:258
#, fuzzy
msgid ""
"<b>No Black & White Filter</b>:"
"<p>Do not apply a black and white filter to the image.</p>"
msgstr ""
"<b>Không lọc đen trắng</b>:"
"<p>đừng áp dụng bộ lọc đen trắng cho ảnh đó.</p>"

#: imageplugins/imageeffect_bwsepia.cpp:262
msgid "Neutral"
msgstr "Trung lập"

#: imageplugins/imageeffect_bwsepia.cpp:263
msgid ""
"<img source=\"%1\"> <b>Neutral Black & White</b>:"
"<p>Simulate black and white neutral film exposure.</p>"
msgstr ""
"<img source=\"%1\"> <b>Đen trắng trung lập</b>:"
"<p>mô phỏng sự phơi nắng phim ảnh trung lập đen trắng.</p>"

#: imageplugins/imageeffect_bwsepia.cpp:268
msgid "Green Filter"
msgstr "Lọc xanh lá cây"

#: imageplugins/imageeffect_bwsepia.cpp:269
msgid ""
"<img source=\"%1\"> <b>Black & White with Green Filter</b>:"
"<p>Simulate black and white film exposure using green filter. This provides an "
"universal asset for all scenics, especially suited for portraits photographed "
"against sky.</p>"
msgstr ""
"<img source=\"%1\"> <b>Đen trắng lọc xanh lá cây</b>:"
"<p>mô phỏng sự phơi nắng phim ảnh đen trắng dùng bộ lọc màu xanh lá cây. Tính "
"năng này cung cấp một tài sản chung với mọi cảnh, thích hợp nhất với ảnh chân "
"dung được chụp trước bầu trời.</p>"

#: imageplugins/imageeffect_bwsepia.cpp:275
msgid "Orange Filter"
msgstr "Lọc cam"

#: imageplugins/imageeffect_bwsepia.cpp:276
msgid ""
"<img source=\"%1\"> <b>Black & White with Orange Filter</b>:"
"<p>Simulate black and white film exposure using orange filter. This will "
"enhances landscapes, marine scenes and aerial photography.</p>"
msgstr ""
"<img source=\"%1\"> <b>Đen trắng lọc cam</b>:"
"<p>mô phỏng sự phơi nắng phim ảnh đen trắng dùng bộ lọc màu cam. Tính năng này "
"sẽ tăng cường ảnh phong cảnh, cảnh biển và ảnh chụp trên không.</p>"

#: imageplugins/imageeffect_bwsepia.cpp:282
msgid "Red Filter"
msgstr "Lọc đỏ"

#: imageplugins/imageeffect_bwsepia.cpp:283
msgid ""
"<img source=\"%1\"> <b>Black & White with Red Filter</b>:"
"<p>Simulate black and white film exposure using red filter. Using this one "
"creates dramatic sky effects and simulates moonlight scenes in daytime.</p>"
msgstr ""
"<img source=\"%1\"> <b>Đen trắng lọc đỏ</b>:"
"<p>mô phỏng sự phơi nắng phim ảnh đen trắng dùng bộ lọc màu đỏ. Dùng tính năng "
"này tạo hiệu ứng bầu trời kịch và mô phỏng cảnh dưới ánh trăng trong ngày.</p>"

#: imageplugins/imageeffect_bwsepia.cpp:289
msgid "Yellow Filter"
msgstr "Lọc vàng"

#: imageplugins/imageeffect_bwsepia.cpp:290
msgid ""
"<img source=\"%1\"> <b>Black & White with Yellow Filter</b>:"
"<p>Simulate black and white film exposure using yellow filter. Most natural "
"tonal correction and improves contrast. Ideal for landscapes.</p>"
msgstr ""
"<img source=\"%1\"> <b>Đen trắng lọc vàng</b>:"
"<p>mô phỏng sự phơi nắng phim ảnh đen trắng dùng bộ lọc màu vàng. Tính năng này "
"sửa chữa sắc màu một cách tự nhiên nhất và tăng độ tương phản. Rất thích hợp "
"với ảnh phong cảnh.</p>"

#: imageplugins/imageeffect_bwsepia.cpp:295
msgid "Filters"
msgstr "Lọc"

#: imageplugins/imageeffect_bwsepia.cpp:307
msgid "No Tone Filter"
msgstr "Không lọc sắc"

#: imageplugins/imageeffect_bwsepia.cpp:308
msgid "<b>No Tone Filter</b>:<p>Do not apply a tone filter to the image.</p>"
msgstr "<b>Không lọc sắc</b>:<p>đừng áp dụng bộ lọc sắc màu cho ảnh đó.</p>"

#: imageplugins/imageeffect_bwsepia.cpp:312
msgid "Sepia Tone"
msgstr "Sắc nâu đỏ"

#: imageplugins/imageeffect_bwsepia.cpp:313
msgid ""
"<img source=\"%1\"> <b>Black & White with Sepia Tone</b>:"
"<p>Gives a warm highlight and mid-tone while adding a bit of coolness to the "
"shadows-very similar to the process of bleaching a print and re-developing in a "
"sepia toner.</p>"
msgstr ""
"<img source=\"%1\"> <b>Đen trắng có sắc màu nâu đỏ</b>:"
"<p>cung cấp chỗ sáng nhất và nửa sắc ấm còn thêm một ít sự mát mẻ vào bóng — "
"rất tương tự với tiến trình tẩy trắng bản in và rửa lại nó trong bộ tạo sắc màu "
"nâu đỏ.</p>"

#: imageplugins/imageeffect_bwsepia.cpp:319
msgid "Brown Tone"
msgstr "Sắc nâu"

#: imageplugins/imageeffect_bwsepia.cpp:320
msgid ""
"<img source=\"%1\"> <b>Black & White with Brown Tone</b>:"
"<p>This filter is more neutral than Sepia Tone filter.</p>"
msgstr ""
"<img source=\"%1\"> <b>Đen trắng có sắc nâu</b>:"
"<p>bộ lọc này là trung lập hơn bộ lọc Sắc Nâu Đỏ.</p>"

#: imageplugins/imageeffect_bwsepia.cpp:324
msgid "Cold Tone"
msgstr "Sắc mát"

#: imageplugins/imageeffect_bwsepia.cpp:325
msgid ""
"<img source=\"%1\"> <b>Black & White with Cold Tone</b>:"
"<p>Start subtle and replicate printing on a cold tone black and white paper "
"such as a bromide enlarging paper.</p>"
msgstr ""
"<img source=\"%1\"> <b>Đen trắng với sắc mát</b>:"
"<p>bắt đầu tế nhị và sao lại bản in trên giấy đen trắng sắc mát như giấy phóng "
"bromua.</p>"

#: imageplugins/imageeffect_bwsepia.cpp:330
msgid "Selenium Tone"
msgstr "Sắc Selen"

#: imageplugins/imageeffect_bwsepia.cpp:331
msgid ""
"<img source=\"%1\"> <b>Black & White with Selenium Tone</b>:"
"<p>This effect replicate traditional selenium chemical toning done in the "
"darkroom.</p>"
msgstr ""
"<img source=\"%1\"> <b>Đen trắng với sắc Selen</b>:"
"<p>hiệu ứng này sao lại việc tạo sắc màu hoá chất Selen truyền thống được làm "
"trong buồng tối.</p>"

#: imageplugins/imageeffect_bwsepia.cpp:336
msgid "Platinum Tone"
msgstr "Sắc bạch kim"

#: imageplugins/imageeffect_bwsepia.cpp:337
msgid ""
"<img source=\"%1\"> <b>Black & White with Platinum Tone</b>:"
"<p>This effect replicate traditional platinum chemical toning done in the "
"darkroom.</p>"
msgstr ""
"<img source=\"%1\"> <b>Đen trắng với sắc bạch kim</b>:"
"<p>hiệu ứng này sao lại việc tạo sắc màu hoá chất bạch kim truyền thống được "
"làm trong buồng tối.</p>"

