#: imageeffect_antivignetting.cpp:60 imageeffect_antivignetting.cpp:311
#: imageplugin_antivignetting.cpp:63
msgid "Anti-Vignetting"
msgstr "Chống làm mờ nét ảnh"

#: imageeffect_antivignetting.cpp:62
msgid "A digiKam image plugin to reduce image vignetting."
msgstr "Một bổ sung digiKam để giảm hiệu ứng làm mờ nét ảnh."

#: imageeffect_antivignetting.cpp:68
msgid "Author and maintainer"
msgstr "Tác giả và nhà duy trì"

#: imageeffect_antivignetting.cpp:71
msgid "Anti Vignetting algorithm"
msgstr "Thuật toán làm mờ nét ảnh"

#: imageeffect_antivignetting.cpp:83
msgid ""
"<p>You can see here a thumbnail preview of the anti-vignetting mask applied to "
"the image."
msgstr ""
"<p>Ở đây có ô xem thử hình thu nhỏ của mặt nạ làm mờ nét ảnh được áp dụng cho "
"ảnh."

#: imageeffect_antivignetting.cpp:89
msgid "Density:"
msgstr "Mật độ :"

#: imageeffect_antivignetting.cpp:94
msgid ""
"<p>This value controls the degree of intensity attenuation by the filter at its "
"point of maximum density."
msgstr ""
"<p>Giá trị này điều khiển độ suy giảm mật độ do bộ lọc tại điểm mật độ tối đa."

#: imageeffect_antivignetting.cpp:102
msgid "Power:"
msgstr "Mũ :"

#: imageeffect_antivignetting.cpp:107
msgid ""
"<p>This value is used as the exponent controlling the fall-off in density from "
"the center of the filter to the periphery."
msgstr ""
"<p>Giá trị này được dùng như là số mũ điều khiển độ giảm sú mật độ từ trung tâm "
"của bộ lọc đến chu vi."

#: imageeffect_antivignetting.cpp:115
msgid "Radius:"
msgstr "Bán kính:"

#: imageeffect_antivignetting.cpp:120
msgid ""
"<p>This value is the radius of the center filter. It is a multiple of the "
"half-diagonal measure of the image, at which the density of the filter falls to "
"zero."
msgstr ""
"<p>Giá trị là bán kính của bộ lọc trung tâm. Nó là bội số cho số đo ảnh kiểu "
"nửa chéo, nơi mật độ của bộ lọc giảm xuống số không."

#: imageeffect_antivignetting.cpp:129
msgid "Brightness:"
msgstr "Độ sáng:"

#: imageeffect_antivignetting.cpp:133
msgid "<p>Set here the brightness re-adjustment of the target image."
msgstr "<p>Ở đây hãy đặt cách điều chỉnh lại độ sáng của ảnh đích."

#: imageeffect_antivignetting.cpp:140
msgid "Contrast:"
msgstr "Độ tương phản:"

#: imageeffect_antivignetting.cpp:144
msgid "<p>Set here the contrast re-adjustment of the target image."
msgstr "<p>Ở đây hãy đặt cách điều chỉnh lại độ tương phản của ảnh đích."

#: imageeffect_antivignetting.cpp:151
msgid "Gamma:"
msgstr "Gamma:"

#: imageeffect_antivignetting.cpp:155
msgid "<p>Set here the gamma re-adjustment of the target image."
msgstr "<p>Ở đây hãy đặt cách điều chỉnh lại gamma của ảnh đích."

#: imageplugin_antivignetting.cpp:43
msgid "Anti Vignetting..."
msgstr "Chống làm mờ nết ảnh..."

