#: imageeffect_blowup.cpp:129
msgid "Blowup Photograph"
msgstr "Phóng to ảnh chụp"

#: imageeffect_blowup.cpp:87
msgid "&Save As..."
msgstr "&Lưu dạng..."

#: imageeffect_blowup.cpp:88
msgid "&Load..."
msgstr "&Tải..."

#: imageeffect_blowup.cpp:92
msgid "<p>Reset all filter parameters to their default values."
msgstr "<p>Đặt lại mọi tham số lọc thành giá trị mặc định."

#: imageeffect_blowup.cpp:93
msgid "<p>Load all filter parameters from settings text file."
msgstr "<p>Tải mọi tham số lọc từ tập tin văn bản thiết lập."

#: imageeffect_blowup.cpp:94
msgid "<p>Save all filter parameters to settings text file."
msgstr "<p>Lưu mọi tham số lọc vào tập tin văn bản thiết lập."

#: imageeffect_blowup.cpp:104
msgid "A digiKam image plugin to blowup a photograph."
msgstr "Một bổ sung ảnh digiKam để phóng ảnh chụp."

#: imageeffect_blowup.cpp:110
msgid "Author and maintainer"
msgstr "Tác giả và nhà duy trì"

#: imageeffect_blowup.cpp:113
msgid "CImg library"
msgstr "Thư viện CImg"

#: imageeffect_blowup.cpp:116
msgid "Feedback and plugin polishing"
msgstr "Phản hồi và điều chỉnh bổ sung"

#: imageeffect_blowup.cpp:122
msgid "Plugin Handbook"
msgstr "Sổ tay bổ sung"

#: imageeffect_blowup.cpp:139
msgid "New Size"
msgstr "Kích cỡ mới"

#: imageeffect_blowup.cpp:147
msgid "Visit CImg library website"
msgstr "Thăm nơi Mạng của thư viện CImg"

#: imageeffect_blowup.cpp:149
msgid "Width:"
msgstr "Rộng:"

#: imageeffect_blowup.cpp:153
msgid "<p>Set here the new imager width in pixels."
msgstr "<p>Ở đây hãy đặt độ rộng mới của ảnh theo điểm ảnh."

#: imageeffect_blowup.cpp:155
msgid "Height:"
msgstr "Cao :"

#: imageeffect_blowup.cpp:159
msgid "<p>Set here the new image height in pixels."
msgstr "<p>Ở đây hãy đặt độ cao mới của ảnh theo điểm ảnh."

#: imageeffect_blowup.cpp:161
msgid "Maintain aspect ratio"
msgstr "Duy trì tỷ lệ hình thể"

#: imageeffect_blowup.cpp:162
msgid "<p>Enable this option to maintain aspect ratio with new image sizes."
msgstr "<p>Bật tùy chọn này để duy trì tỷ lệ hình thể với kích cỡ ảnh mới."

#: imageeffect_blowup.cpp:173
msgid "<p>This is the current percentage of the task completed."
msgstr "<p>Đây là phần trăm công việc làm xong hiện thời."

#: imageeffect_blowup.cpp:180
msgid "Smoothing"
msgstr "Làm mịn"

#: imageeffect_blowup.cpp:182
msgid "Detail preservation:"
msgstr "Bảo tồn chi tiết:"

#: imageeffect_blowup.cpp:187
msgid ""
"<p>Preservation of details to set the sharpening level of the small features "
"in the target image. Higher values leave details sharp."
msgstr "<p>Sự bảo tồn chi tiết để đặt độ mài sắc của những tính năng nhỏ trong ảnh đích. Giá trị cao hơn để lại chi tiết sắc."

#: imageeffect_blowup.cpp:193
msgid "Anisotropy:"
msgstr "Tính dị hướng:"

#: imageeffect_blowup.cpp:198
msgid ""
"<p>Anisotropic (directional) modifier of the details. Keep it small for "
"Gaussian noise."
msgstr "<p>Bộ sửa đổi chi tiết một cách định hướng. Đặt nhỏ đối với ồn Gauss."

#: imageeffect_blowup.cpp:202
msgid "Smoothing:"
msgstr "Làm mịn:"

#: imageeffect_blowup.cpp:207
msgid ""
"<p>Total smoothing power: if Detail Factor sets the relative smoothing and "
"Gradient Factor the direction, Time Step sets the overall effect."
msgstr "<p>Tổng độ mạnh làm mịn: nếu Hệ số Chi tiết đặt độ làm mịn tương đối còn Hệ số Bán kính đặt hướng, Bước Thời Gian đặt hiệu ứng toàn bộ."

#: imageeffect_blowup.cpp:212
msgid "Regularity:"
msgstr "Tính đều đặn:"

#: imageeffect_blowup.cpp:217
msgid ""
"<p>This value controls the smoothing regularity of the target image. Do not "
"use an high value here, else the target image will be completely blurred."
msgstr "<p>Giá trị này điều khiển độ tính đều đặn làm mịn của ảnh đích. Đừng dùng giá trị cao ở đây: nó sẽ tạo ảnh đích bị che mờ hoàn toàn."

#: imageeffect_blowup.cpp:223
msgid "Iterations:"
msgstr "Lần lặp lại:"

#: imageeffect_blowup.cpp:228
msgid "<p>Sets the number of times the filter is applied on the target image."
msgstr "<p>Đặt số lần áp dụng bộ lọc cho ảnh đích."

#: imageeffect_blowup.cpp:236
msgid "Advanced Settings"
msgstr "Thiết lập cấp cao"

#: imageeffect_blowup.cpp:238
msgid "Angular step:"
msgstr "Bước góc:"

#: imageeffect_blowup.cpp:243
msgid ""
"<p>Set here the angular integration step in degrees in analogy to anisotropy."
msgstr "<p>Ở đây hãy đặt bước phép lấy tích phân góc theo độ tương tự với tính dị hướng."

#: imageeffect_blowup.cpp:247
msgid "Integral step:"
msgstr "Bước tích phân:"

#: imageeffect_blowup.cpp:252
msgid "<p>Set here the spatial integral step. Stay below 1."
msgstr "<p>Ở đây hãy đặt bước tích phân không gian. Cứ dưới 1."

#: imageeffect_blowup.cpp:256
msgid "Gaussian:"
msgstr "Gaussian:"

#: imageeffect_blowup.cpp:261
msgid "<p>Set here the precision of the Gaussian function."
msgstr "<p>Ở đây hãy đặt độ chính xác của hàm Gauss."

#: imageeffect_blowup.cpp:265
msgid "Use linear interpolation"
msgstr "Dùng sự nội suy tuyến."

#: imageeffect_blowup.cpp:266
msgid "<p>Enable this option to quench the last bit of quality (slow)."
msgstr "<p>Bật tùy chọn này để làm hết ít chất lượng còn lại (chạy chậm)."

#: imageeffect_blowup.cpp:269
msgid "Normalize photograph"
msgstr "Tiêu chuẩn hoá ảnh chụp"

#: imageeffect_blowup.cpp:270
msgid "<p>Enable this option to process an output image normalization."
msgstr "<p>Bật tùy chọn này để xử lý sự tiêu chuẩn hoá ảnh xuất."

#: imageeffect_blowup.cpp:466
msgid "BlowUp"
msgstr "Phóng"

#: imageeffect_blowup.cpp:491
msgid "Photograph Blowup Settings File to Load"
msgstr "Tập tin thiết lập phóng ảnh chụp cần tải"

#: imageeffect_blowup.cpp:503
msgid "\"%1\" is not a Photograph Blowup settings text file."
msgstr "« %1 » không phải là một tập tin văn bản thiết lập phóng ảnh chụp."

#: imageeffect_blowup.cpp:524
msgid "Cannot load settings from the Photograph Blowup text file."
msgstr "Không thể tải thiết lập từ tập tin văn bản phóng ảnh chụp."

#: imageeffect_blowup.cpp:533
msgid "Photograph Blowup Settings File to Save"
msgstr "Tập tin thiết lập phóng ảnh chụp cần lưu"

#: imageeffect_blowup.cpp:555
msgid "Cannot save settings to the Photograph Blowup text file."
msgstr "Không thể lưu thiết lập vào tập tin văn bản phóng ảnh chụp."

#: imageplugin_blowup.cpp:42
msgid "Blowup..."
msgstr "Phóng..."

