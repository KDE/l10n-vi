#: channelmixer.cpp:85 imageplugin_channelmixer.cpp:68
msgid "Color Channel Mixer"
msgstr "Bộ hoà kênh màu"

#: channelmixer.cpp:87
msgid "An image color channel mixer plugin for digiKam."
msgstr "Bổ sung hoà kênh màu ảnh cho digiKam."

#: channelmixer.cpp:93
msgid "Author and maintainer"
msgstr "Tác giả và nhà duy trì"

#: channelmixer.cpp:101
msgid ""
"<p>You can see here the image's color channels' gains adjustments preview. You "
"can pick color on image to see the color level corresponding on histogram."
msgstr ""
"<p>Ở đây có ô xem thử cách điều chỉnh khuếch đại của các kênh màu của ảnh. Bạn "
"có thể kén màu trên ảnh để xem cấp màu tương ứng trong biểu đồ tần xuất. "

#: channelmixer.cpp:111
msgid "Channel:"
msgstr "Kênh:"

#: channelmixer.cpp:114 channelmixer.cpp:117
msgid "Red"
msgstr "Đỏ"

#: channelmixer.cpp:115
msgid "Green"
msgstr "Xanh lá cây"

#: channelmixer.cpp:116
msgid "Blue"
msgstr "Xanh dương"

#: channelmixer.cpp:118
msgid ""
"<p>Select here the color channel to mix:"
"<p><b>Red</b>: display the red image-channel values."
"<p><b>Green</b>: display the green image-channel values."
"<p><b>Blue</b>: display the blue image-channel values."
"<p>"
msgstr ""
"<p>Ở đây hãy chọn kênh màu cần hoà:"
"<p><b>Đỏ</b>: hiển thị những giá trị của kênh màu đỏ."
"<p><b>Xanh lá cây</b>: hiển thị những giá trị của kênh màu xanh lá cây."
"<p><b>Xanh dương</b>: hiển thị những giá trị của kênh màu xanh dương."
"<p>"

#: channelmixer.cpp:127
msgid ""
"<p>Select here the histogram scale."
"<p>If the image's maximal counts are small, you can use the linear scale."
"<p>Logarithmic scale can be used when the maximal counts are big; if it is "
"used, all values (small and large) will be visible on the graph."
msgstr ""
"<p>Ở đây hãy chọn tỷ lệ biểu đồ tần xuất."
"<p>Nếu các số đếm tối đa của ảnh là nhỏ, bạn có thể dùng tỷ lệ tuyến."
"<p>Còn tỷ lệ loga có thể được dùng khi các số đếm tối đa là lớn; nếu dùng, mọi "
"giá trị (cả lớn lẫn nhỏ) sẽ được hiển thị trên đồ thị."

#: channelmixer.cpp:133
msgid "<p>Linear"
msgstr "<p>Tuyến"

#: channelmixer.cpp:141
msgid "<p>Logarithmic"
msgstr "<p>Loga"

#: channelmixer.cpp:157
msgid ""
"<p>Here you can see the target preview image histogram drawing of the selected "
"image channel. This one is re-computed at any mixer settings changes."
msgstr ""
"<p>Ở đây có bản vẽ biểu đồ tần xuất ảnh xem thử đích của kênh ảnh được chọn. "
"Điều này được tính lại khi nào thay đổi thiết lập bộ hoà."

#: channelmixer.cpp:169
msgid "Red:"
msgstr "Đỏ :"

#: channelmixer.cpp:173
msgid "<p>Select here the red color gain in percent for the current channel."
msgstr "<p>Ở đây hãy chọn khuếch đại màu đỏ theo phần trăm cho kênh hiện có."

#: channelmixer.cpp:175
msgid "Blue:"
msgstr "Xanh dương:"

#: channelmixer.cpp:179
msgid "<p>Select here the green color gain in percent for the current channel."
msgstr ""
"<p>Ở đây hãy chọn khuếch đại màu xanh lá cây theo phần trăm cho kênh hiện có."

#: channelmixer.cpp:181
msgid "Green:"
msgstr "Xanh lá cây:"

#: channelmixer.cpp:185
msgid "<p>Select here the blue color gain in percent for the current channel."
msgstr ""
"<p>Ở đây hãy chọn khuếch đại màu xanh dương theo phần trăm cho kênh hiện có."

#: channelmixer.cpp:187
msgid "&Reset"
msgstr "Đặt &lại"

#: channelmixer.cpp:188
msgid ""
"Reset color channels' gains settings from the currently selected channel."
msgstr ""
"Đặt lại thiết lập khuếch đại của các kênh màu từ kênh được chọn hiện thời."

#: channelmixer.cpp:200
msgid "Monochrome"
msgstr "Đơn sắc"

#: channelmixer.cpp:201
msgid ""
"<p>Enable this option if you want rendering of the image in monochrome mode. In "
"this mode, histogram will display only luminosity values."
msgstr ""
"<p>Bật tùy chọn này nếu bạn muốn ảnh được vẽ trong chế độ đơn sắc. Trong chế độ "
"này, biểu đồ tần xuất sẽ hiển thị chỉ giá trị độ trưng thôi."

#: channelmixer.cpp:204
msgid "Preserve luminosity"
msgstr "Bảo tồn độ trưng"

#: channelmixer.cpp:205
msgid "<p>Enable this option is you want preserve the image luminosity."
msgstr "<p>Bật tùy chọn này nếu bạn muốn bảo tồn độ trưng của ảnh."

#: channelmixer.cpp:207
msgid "Over exposure indicator"
msgstr "Cái chỉ sự phơi quá lâu"

#: channelmixer.cpp:208
msgid ""
"<p>If you enable this option, over-exposed pixels from the target image preview "
"will be over-colored. This will not have an effect on the final rendering."
msgstr ""
"<p>Nếu bạn bật tùy chọn này, mỗi điểm ảnh quá phơi năng từ ảnh đích sẽ có quá "
"màu. Cách hiển thị này sẽ không có tác động khi vẽ cuối cùng."

#: channelmixer.cpp:479
msgid "Channel Mixer"
msgstr "Bộ hoà kênh"

#: channelmixer.cpp:568
msgid "Select Gimp Gains Mixer File to Load"
msgstr "Chọn tập tin hoà khuếch đại GIMP cần tải"

#: channelmixer.cpp:640
msgid "Cannot load settings from the Gains Mixer text file."
msgstr "Không thể tải thiết lập từ tập tin văn bản hoà khuếch đại."

#: channelmixer.cpp:653
msgid "Gimp Gains Mixer File to Save"
msgstr "Tập tin hoà khuếch đại GIMP cần lưu"

#: channelmixer.cpp:715
msgid "Cannot save settings to the Gains Mixer text file."
msgstr "Không thể lưu thiết lập vào tập tin văn bản hoà khuếch đại."

#: imageplugin_channelmixer.cpp:48
msgid "Channel Mixer..."
msgstr "Bộ hoà kênh..."

