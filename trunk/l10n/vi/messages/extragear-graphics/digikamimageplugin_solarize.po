#: imageeffect_colorfx.cpp:165
msgid ""
"<p>Select here the effect type to apply on the image."
"<p><b>Solarize</b>: simulates solarization of photograph."
"<p><b>Vivid</b>: simulates the Velvia negative film colors."
"<p><b>Neon</b>: coloring the edges in a photograph to reproduce a fluorescent "
"light effect."
"<p><b>Find Edges</b>: detects the edges in a photograph and their strength."
msgstr ""

#: imageeffect_colorfx.cpp:176
msgid "Level:"
msgstr ""

#: imageeffect_colorfx.cpp:179
msgid "<p>Set here the level of the effect."
msgstr ""

#: imageeffect_colorfx.cpp:184
msgid "Iteration:"
msgstr ""

#: imageeffect_colorfx.cpp:187
msgid ""
"<p>This value controls the number of iterations to use with Neon and Find Edges "
"effects."
msgstr ""

