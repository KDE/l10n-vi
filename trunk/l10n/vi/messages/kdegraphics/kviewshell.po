#: kprintDialogPage_pageoptions.cpp:41
msgid "If this option is enabled, the pages are centered on the paper."
msgstr ""

#: kprintDialogPage_pageoptions.cpp:42
msgid ""
"<qt>"
"<p>If this option is enabled, the pages will be printed centered on the paper; "
"this makes more visually-appealing printouts.</p>"
"<p>If the option is not enabled, all pages will be placed in the top-left "
"corner of the paper.</p></qt>"
msgstr ""

#: kprintDialogPage_pageoptions.cpp:50
msgid "Rotate pages to better fit the paper"
msgstr ""

#: kprintDialogPage_pageoptions.cpp:51
msgid ""
"If this option is enabled, some pages might be rotated to better fit the paper "
"size."
msgstr ""

#: kprintDialogPage_pageoptions.cpp:52
msgid ""
"<qt>"
"<p>If this option is enabled, pages whose width exceeds their height will be "
"rotated by 90 degrees counterclockwise before printing. This makes better use "
"of the paper and gives more visually-appealing printouts.</p>"
"<p><b>Note:</b> If this option is enabled, and if the pages in your document "
"have different sizes,then some pages might be rotated while others are not.</p>"
"</qt>"
msgstr ""

#: kprintDialogPage_pageoptions.cpp:70
msgid "Shrink oversized pages to fit paper size"
msgstr ""

#: kprintDialogPage_pageoptions.cpp:71
msgid ""
"If this option is enabled, large pages that would not fit the printer's paper "
"size will be shrunk."
msgstr ""

#: kprintDialogPage_pageoptions.cpp:72
msgid ""
"<qt>"
"<p>If this option is enabled, large pages that would not fit the printer's "
"paper size will be shrunk so that edges won't be cut off during printing.</p>"
"<p><b>Note:</b> If this option is enabled, and if the pages in your document "
"have different sizes, then different pages might be shrunk by different scaling "
"factors.</p></qt>"
msgstr ""

#: kprintDialogPage_pageoptions.cpp:81
msgid "Expand small pages to fit paper size"
msgstr ""

#: kprintDialogPage_pageoptions.cpp:82
msgid ""
"If this option is enabled, small pages will be enlarged so that they fit the "
"printer's paper size."
msgstr ""

#: kprintDialogPage_pageoptions.cpp:83
msgid ""
"<qt>"
"<p>If this option is enabled, small pages will be enlarged so that they fit the "
"printer's paper size.</p>"
"<p><b>Note:</b> If this option is enabled, and if the pages in your document "
"have different sizes, then different pages might be expanded by different "
"scaling factors.</p></qt>"
msgstr ""

