#: konq_run.cc:145
msgid ""
"There appears to be a configuration error. You have associated Konqueror with "
"%1, but it cannot handle this file type."
msgstr ""
"Hình như gặp lỗi cấu hình. Bạn đã gán trình Konqueror với %1, nhưng nó không "
"thể xử lý kiểu tập tin này."

#: konq_run.cc:266
msgid "Do you really want to execute '%1'?"
msgstr "Bạn thật sự muốn thực hiện « %1 » không?"

#: konq_run.cc:280
msgid "Open '%1' using '%2'?"
msgstr "Mở « %1 » bằng « %2 » không?"

#: konq_run.cc:282
msgid "Open '%1'?"
msgstr "Mở « %1 » không?"

#: konq_run.cc:285
msgid "Save to Disk"
msgstr "Lưu vào đĩa"
